<Window x:Class="DesktopIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Island"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MouseWheel="Window_MouseWheel"
        Loaded="Window_Loaded"
        Deactivated="Window_Deactivated"
        Closing="Window_Closing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#0EA5E9"/>
        <SolidColorBrush x:Key="AccentBrightBrush" Color="#38BDF8"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#1E3A5F"/>

        <!-- Atoll-Style Monolith Header Tab Button (Shows Icon + Label pill when checked, monochrome Icon when unchecked) -->
        <Style x:Key="AtollHeaderTabBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#71717A"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="IconPath"
                                      Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.55"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Width="14"
                                      Height="14"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"/>
                                <TextBlock x:Name="TabLabel"
                                           Text="{TemplateBinding Content}"
                                           Foreground="#F4F4F5"
                                           FontWeight="SemiBold"
                                           FontSize="11"
                                           Margin="6,0,2,0"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#23242A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#343640"/>
                                <Setter TargetName="Bd" Property="Padding" Value="10,5"/>
                                <Setter Property="Foreground" Value="#F4F4F5"/>
                                <Setter TargetName="TabLabel" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#1A1B20"/>
                                <Setter Property="Foreground" Value="#D4D4D8"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Pill Sub-Button -->
        <Style x:Key="SubPillButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="Background" Value="#15161A"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#26272F" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#262830"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3E404C"/>
                                <Setter Property="Foreground" Value="#FAFAFA"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#1C1D22"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="BorderBrush" Value="#2B2C34"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="BtnScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#262830"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3E404C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.84"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Atoll-Style Top Wide Capsule Quick Action Button -->
        <Style x:Key="AtollCapsuleBtn" TargetType="Button">
            <Setter Property="Background" Value="#15161A"/>
            <Setter Property="BorderBrush" Value="#24252C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="22"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="CapScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CapScale" Storyboard.TargetProperty="ScaleX" To="1.035" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CapScale" Storyboard.TargetProperty="ScaleY" To="1.035" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CapScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CapScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E1F25"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#363844"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.86"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CapScale" Storyboard.TargetProperty="ScaleX" To="0.95" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="CapScale" Storyboard.TargetProperty="ScaleY" To="0.95" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CapScale" Storyboard.TargetProperty="ScaleX" To="1.035" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="CapScale" Storyboard.TargetProperty="ScaleY" To="1.035" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Atoll-Style Unboxed Circular Tool Button (No box frame, circular badge + label below) -->
        <Style x:Key="AtollUnboxedBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#D4D4D8"/>
            <Setter Property="Padding" Value="2,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="TileScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="0.93" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="0.93" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconToggleButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="#232433"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#313347"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box" Width="15" Height="15" CornerRadius="4" Background="#1D1F2C" BorderBrush="#3B3F56" BorderThickness="1.2" Margin="0,0,7,0">
                                <Path x:Name="Tick" Data="M 3,7.5 L 6,10.5 L 12,4" Stroke="#FFFFFF" StrokeThickness="1.8" Visibility="Collapsed" StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrightBrush}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek macOS-style Thin Translucent ScrollBar (Zero gray track, orientation-aware) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBd" Background="#68FFFFFF" CornerRadius="2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBd" Property="Background" Value="#A8FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="4"/>
                    <Setter Property="MinWidth" Value="4"/>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="4"/>
                    <Setter Property="MinHeight" Value="4"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.Thumb>
                                            <Thumb Cursor="Hand">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border x:Name="ThumbBd" Background="#50FFFFFF" CornerRadius="2"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ThumbBd" Property="Background" Value="#90FFFFFF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.95"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Zero-width-theft Overlay ScrollViewer so ScrollBars float smoothly on hover without ruining paddings -->
        <Style x:Key="OverlayScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid x:Name="RootGrid">
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    CanHorizontallyScroll="False"
                                                    CanVerticallyScroll="False"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    Content="{TemplateBinding Content}"
                                                    Margin="{TemplateBinding Padding}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       AutomationProperties.AutomationId="VerticalScrollBar"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Stretch"
                                       Margin="0,3,-2,3"
                                       Opacity="0"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       Minimum="0"
                                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Orientation="Horizontal"
                                       AutomationProperties.AutomationId="HorizontalScrollBar"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Bottom"
                                       Margin="3,0,3,-1"
                                       Opacity="0"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       Minimum="0"
                                       Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PART_VerticalScrollBar" Storyboard.TargetProperty="Opacity" To="0.82" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="PART_HorizontalScrollBar" Storyboard.TargetProperty="Opacity" To="0.72" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PART_VerticalScrollBar" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.35"/>
                                            <DoubleAnimation Storyboard.TargetName="PART_HorizontalScrollBar" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.35"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- No Background & no DropShadow shader box so nothing forms a translucent rectangle around rounded pills -->
    <Grid x:Name="RootCanvasContainer" Margin="0">
        <StackPanel x:Name="OuterDockStack" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <StackPanel.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="IslandMagnetScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="IslandMagnetTranslate" X="0" Y="0"/>
                </TransformGroup>
            </StackPanel.RenderTransform>
            <!-- Rounded early-trigger hover halo strictly hugging the rounded island -->
            <Border x:Name="IslandHoverZone"
                    Padding="2"
                    CornerRadius="20"
                    Background="#01000000"
                    VerticalAlignment="Top"
                    MouseEnter="IslandHoverZone_MouseEnter"
                    MouseLeave="IslandHoverZone_MouseLeave">

                <!-- MAIN ISLAND CAPSULE -->
                <Border x:Name="IslandBorder"
                        Width="380"
                        Height="36"
                        CornerRadius="18"
                        Background="#FC090A0D"
                        BorderBrush="#24252C"
                        BorderThickness="1"
                        ClipToBounds="True"
                        AllowDrop="True"
                        DragEnter="Island_DragEnter"
                        DragLeave="Island_DragLeave"
                        Drop="Island_Drop"
                        MouseDown="Island_MouseDown"
                        PreviewMouseLeftButtonDown="Island_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="Island_PreviewMouseMove"
                        PreviewMouseLeftButtonUp="Island_PreviewMouseLeftButtonUp">

                    <Grid VerticalAlignment="Top">
                        <!-- COMPACT BAR -->
                        <Grid x:Name="CompactContentGrid" Height="36" VerticalAlignment="Top" Visibility="Visible">
                            <!-- Normal metrics strip (Desktop: Mic/Status dot · Time · Colored Weather | Game: GameCircle · FPS · CPU · GPU · Temp) -->
                            <StackPanel x:Name="CompactMetricsStrip"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="12,0">
                                <!-- Mic / Status Dot (NO eyes when active; eyes appear strictly in idle mode!) -->
                                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#22C55E" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Статус микрофона / камеры"/>

                                <!-- Active Game Circular Icon Badge (visible only in game mode) -->
                                <Border x:Name="CompactGameIconBadge" Width="21" Height="21" CornerRadius="10.5" Background="#16171C" BorderBrush="#333540" BorderThickness="1.2" Margin="0,0,7,0" Visibility="Collapsed" VerticalAlignment="Center">
                                    <Grid>
                                        <Image x:Name="CompactGameExeIcon" Width="13" Height="13" Stretch="UniformToFill" Visibility="Collapsed"/>
                                        <Path x:Name="CompactGameFallbackGlyph" Data="M 4,7 L 12,7 C 13.5,7 14.5,8.2 14.5,9.5 C 14.5,10.8 13.5,12 12,12 L 10.5,12 L 9.5,10.5 L 6.5,10.5 L 5.5,12 L 4,12 C 2.5,12 1.5,10.8 1.5,9.5 C 1.5,8.2 2.5,7 4,7 Z" Fill="#4ADE80" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border x:Name="ScreenRecordBadge" Background="#7F1D1D" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="7" Padding="5,0.5" Margin="0,0,5,0" Visibility="Collapsed" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="ScreenRecordBadge_Click" ToolTip="Идёт запись экрана (нажмите чтобы остановить)">
                                    <TextBlock x:Name="ScreenRecordTimerText" Text="● REC 00:00" FontSize="9" FontWeight="Bold" Foreground="#FEE2E2"/>
                                </Border>
                                <Border x:Name="StreamRecBadge" Background="#450A0A" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="4,0.5" Margin="0,0,5,0" Visibility="Collapsed" VerticalAlignment="Center" ToolTip="Стрим-щит активен (названия скрыты)">
                                    <TextBlock Text="🛡 REC" FontSize="8.5" FontWeight="Bold" Foreground="#FCA5A5"/>
                                </Border>
                                <TextBlock x:Name="GameMicWarnIcon" Text="🔇" FontSize="10.5" Foreground="#F87171" Margin="0,0,5,0" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="Микрофон выключен в игре!"/>

                                <TextBlock x:Name="CompactTimeText" Text="12:00" FontSize="12.5" FontWeight="SemiBold" Foreground="#F4F4F5" VerticalAlignment="Center" Margin="18,0,8,1"/>
                                <TextBlock x:Name="CompactSessionText" Text="" FontSize="10.5" Foreground="#71717A" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>

                                <!-- Colored Vector Weather Icon + Temp in Compact Bar -->
                                <StackPanel x:Name="CompactWeatherGroup" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,1" Visibility="Collapsed">
                                    <Grid x:Name="CompactWeatherIconCanvas" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,5,0">
                                        <Path x:Name="CompactSunRays"
                                              Data="M 8,1 V 3.1 M 8,12.9 V 15 M 1,8 H 3.1 M 12.9,8 H 15 M 3.05,3.05 L 4.55,4.55 M 11.45,11.45 L 12.95,12.95 M 12.95,3.05 L 11.45,4.55 M 4.55,11.45 L 3.05,12.95"
                                              Stroke="#FACC15" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="16" Height="16"/>
                                        <Ellipse x:Name="CompactSunShape" Width="6.6" Height="6.6" Fill="#FACC15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Path x:Name="CompactCloudShape" Data="M 4,13 H 12.5 A 2.5,2.5 0 0 0 12.5,8 A 3.5,3.5 0 0 0 5.8,7.2 A 2.8,2.8 0 0 0 4,13 Z" Fill="#E4E4E7" Stretch="Uniform" Width="12.5" Height="9.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,0.5" Visibility="Collapsed"/>
                                        <Path x:Name="CompactRainShape" Data="M 5,13.5 L 4.3,15 M 8.5,13.5 L 7.8,15 M 11.5,13.5 L 10.8,15" Stroke="#38BDF8" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                                    </Grid>
                                    <TextBlock x:Name="CompactWeatherText" Text="4°" FontSize="12" FontWeight="SemiBold" Foreground="#F4F4F5" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Border x:Name="CompactTimerPill" Background="#1D2234" CornerRadius="8" Padding="6,1.5" Margin="6,0,0,0" Visibility="Collapsed" VerticalAlignment="Center">
                                    <TextBlock x:Name="CompactTimerText" Text="🌙 30:00" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrightBrush}"/>
                                </Border>

                                <TextBlock x:Name="CompactSep1" Text="·" FontSize="12" Foreground="#52525B" Margin="6,0" VerticalAlignment="Center"/>

                                <!-- In-Game Metrics: FPS (green >60 / red <60) + CPU % + GPU % + GPU Temp (red >85) -->
                                <TextBlock x:Name="CompactFpsText" Text="0 FPS" FontSize="11.8" FontWeight="Bold" Foreground="#4ADE80" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="CompactSysText" FontSize="11.5" VerticalAlignment="Center">
                                    <Run x:Name="CpuLabelRun" Text="CPU " Foreground="#9CA3AF"/><Run x:Name="CpuValRun" Text="0%" Foreground="#F4F4F5" FontWeight="SemiBold"/><Run x:Name="GpuSepRun" Text="" Foreground="#52525B"/><Run x:Name="GpuLabelRun" Text="" Foreground="#9CA3AF"/><Run x:Name="GpuValRun" Text="" Foreground="#4ADE80" FontWeight="SemiBold"/><Run x:Name="GpuTempRun" Text="" Foreground="#FBBF24" FontWeight="Bold"/><Run x:Name="RamSepRun" Text="" Foreground="#52525B"/><Run x:Name="RamLabelRun" Text="" Foreground="#9CA3AF"/><Run x:Name="RamValRun" Text="" Foreground="#D4D4D8" FontWeight="SemiBold"/>
                                </TextBlock>
                                <TextBlock x:Name="CompactPingText" Text="" FontSize="10.5" Foreground="#9CA3AF" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <TextBlock x:Name="CompactNetJitterBadge" Text="📶" FontSize="10" Foreground="#FACC15" Margin="4,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="Нестабильная сеть (потери/скачки пинга)"/>
                                <TextBlock x:Name="CompactDownloadSurgeText" Text="" FontSize="10.5" FontWeight="SemiBold" Foreground="#38BDF8" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>

                                <!-- Live mini audio equalizer -->
                                <StackPanel x:Name="CompactEqPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed" Height="14">
                                    <Border x:Name="EqBar1" Width="2.5" Height="4" CornerRadius="1.2" Background="{DynamicResource AccentBrightBrush}" VerticalAlignment="Bottom" Margin="0,0,1.5,2"/>
                                    <Border x:Name="EqBar2" Width="2.5" Height="9" CornerRadius="1.2" Background="{DynamicResource AccentBrightBrush}" VerticalAlignment="Bottom" Margin="0,0,1.5,2"/>
                                    <Border x:Name="EqBar3" Width="2.5" Height="6" CornerRadius="1.2" Background="{DynamicResource AccentBrightBrush}" VerticalAlignment="Bottom" Margin="0,0,1.5,2"/>
                                    <Border x:Name="EqBar4" Width="2.5" Height="10" CornerRadius="1.2" Background="{DynamicResource AccentBrightBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                </StackPanel>

                                <TextBlock x:Name="CompactNetText" Text="" FontSize="10.5" Foreground="{DynamicResource AccentBrightBrush}" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </StackPanel>

                            <!-- Visual CPU/GPU Load Bar Effect along bottom edge of Compact Bar -->
                            <Border x:Name="CompactLoadBarHost" Height="2" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="18,0" Background="Transparent" Visibility="Collapsed">
                                <Border x:Name="CompactLoadBarFill" Height="2" CornerRadius="1" Width="0" HorizontalAlignment="Left" Background="#22C55E"/>
                            </Border>

                            <!-- Sleek full-island Animated Music Mode (compact Apple Dynamic Island style, fixed compact width + real cover art + lively animations) -->
                            <Grid x:Name="CompactMusicStrip" Visibility="Collapsed" Margin="10,0" VerticalAlignment="Center" Height="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Spinning glowing music disc / album thumbnail orb -->
                                <Grid Grid.Column="0" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Border x:Name="MusicOrbRing" Width="24" Height="24" CornerRadius="12" RenderTransformOrigin="0.5,0.5" BorderThickness="1.7">
                                        <Border.RenderTransform>
                                            <RotateTransform x:Name="MusicOrbRotate" Angle="0"/>
                                        </Border.RenderTransform>
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#38BDF8" Offset="0"/>
                                                <GradientStop Color="#818CF8" Offset="0.5"/>
                                                <GradientStop Color="#F472B6" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <Border.Background>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#33818CF8" Offset="0"/>
                                                <GradientStop Color="#141827" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Ellipse x:Name="MusicThumbCircle" Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                        <Ellipse.Fill>
                                            <ImageBrush x:Name="MusicThumbBrush" Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Ellipse x:Name="MusicStatusDot" Width="7" Height="7" Fill="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Clean clipped single-line scrolling title -->
                                <Grid Grid.Column="1" Width="118" ClipToBounds="True" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Canvas Height="18" VerticalAlignment="Center">
                                        <TextBlock x:Name="CompactMusicTitleText" Text="Музыка" FontSize="11.5" FontWeight="SemiBold" Foreground="#F8FAFC" Canvas.Top="1">
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform x:Name="CompactMusicMarqueeTransform" X="0"/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Canvas>
                                </Grid>

                                <!-- 7-bar lively colorful waveform -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="22">
                                    <Border x:Name="MusicBar1" Width="2.5" Height="5" CornerRadius="1.25" Background="#38BDF8" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                    <Border x:Name="MusicBar2" Width="2.5" Height="11" CornerRadius="1.25" Background="#60A5FA" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                    <Border x:Name="MusicBar3" Width="2.5" Height="17" CornerRadius="1.25" Background="#818CF8" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                    <Border x:Name="MusicBar4" Width="2.5" Height="13" CornerRadius="1.25" Background="#A78BFA" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                    <Border x:Name="MusicBar5" Width="2.5" Height="18" CornerRadius="1.25" Background="#C084FC" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                    <Border x:Name="MusicBar6" Width="2.5" Height="10" CornerRadius="1.25" Background="#E879F9" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                    <Border x:Name="MusicBar7" Width="2.5" Height="6" CornerRadius="1.25" Background="#F472B6" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Vertical Side-Docked metrics strip (used when DockEdge = Left / Right) -->
                            <StackPanel x:Name="CompactSideStrip"
                                        Orientation="Vertical"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="8,9"
                                        Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                    <Ellipse x:Name="SideStatusDot" Width="5.5" Height="5.5" Fill="{DynamicResource AccentBrightBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SideTimeText" Text="12:00" FontSize="11.5" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border x:Name="SideRecordBadge" Background="#7F1D1D" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="4,1" HorizontalAlignment="Center" Margin="0,1,0,3" Visibility="Collapsed" Cursor="Hand" MouseLeftButtonUp="ScreenRecordBadge_Click">
                                    <TextBlock x:Name="SideRecordTimerText" Text="● 00:00" FontSize="8.5" FontWeight="Bold" Foreground="#FEE2E2"/>
                                </Border>
                                <TextBlock x:Name="SideWeatherText" Text="" FontSize="9.5" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,2" Visibility="Collapsed"/>
                                <Border Height="1" Background="#25283B" Margin="4,3,4,4"/>
                                <TextBlock x:Name="SideFpsText" Text="" FontSize="10" FontWeight="SemiBold" Foreground="#4ADE80" HorizontalAlignment="Center" Margin="0,0,0,2" Visibility="Collapsed"/>
                                <TextBlock x:Name="SideSysText" Text="CPU 0%&#x0a;RAM 0%" FontSize="9.5" Foreground="#CBD5E1" TextAlignment="Center" HorizontalAlignment="Center" LineHeight="13"/>
                                <TextBlock x:Name="SidePingText" Text="" FontSize="9.2" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="SideToastText" Text="" FontSize="9.2" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrightBrush}" TextTrimming="CharacterEllipsis" MaxWidth="52" HorizontalAlignment="Center" Margin="0,3,0,0" Visibility="Collapsed"/>
                            </StackPanel>

                            <!-- Dynamic Island Live Notification / Toast overlay inside compact bar -->
                            <Grid x:Name="CompactToastStrip" Visibility="Collapsed" Margin="11,0"
                                  RenderTransformOrigin="0.5,0.5"
                                  MouseEnter="CompactToastStrip_MouseEnter"
                                  MouseLeave="CompactToastStrip_MouseLeave">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="CompactToastScale" ScaleX="1" ScaleY="1"/>
                                </Grid.RenderTransform>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="CompactToastIconBadge" Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="#163024" BorderBrush="#28583D" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Grid>
                                            <Ellipse x:Name="ToastColorSwatch" Width="12" Height="12" Visibility="Collapsed" Stroke="#80FFFFFF" StrokeThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="CompactToastIcon" Text="✨" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="CompactToastTitle" Text="" FontSize="9" FontWeight="SemiBold" Foreground="#4ADE80" LineHeight="10.5" Visibility="Collapsed"/>
                                        <TextBlock x:Name="CompactToastText" Text="" FontSize="11.4" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" MaxWidth="258" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button x:Name="CompactToastActionBtn" Grid.Column="2" Content="Открыть" Style="{StaticResource AccentButton}" Background="#16A34A" Padding="9,3" FontSize="10.2" Margin="9,0,0,0" Visibility="Collapsed" Click="CompactToastAction_Click"/>
                                </Grid>
                                <Border x:Name="ToastProgressHost" Grid.Row="1" Height="2" CornerRadius="1" Background="#253047" Margin="6,0,6,2.5" Visibility="Collapsed">
                                    <Border x:Name="ToastProgressFill" Height="2" CornerRadius="1" Width="0" HorizontalAlignment="Left" Background="{DynamicResource AccentBrightBrush}"/>
                                </Border>
                            </Grid>

                            <!-- Idle stylized round eyes (mutually exclusive sibling — zero text overlap) -->
                            <StackPanel x:Name="CompactIdleEyesStrip"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed"
                                        ToolTip="Режим ожидания — пошевелите мышкой или нажмите клавишу">
                                <!-- Left Eye -->
                                <Grid x:Name="IdleLeftEyeWrap" Width="16" Height="16" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="IdleLeftEyeBlink" ScaleX="1" ScaleY="1"/>
                                    </Grid.RenderTransform>
                                    <Grid.Clip>
                                        <EllipseGeometry Center="8,8" RadiusX="8" RadiusY="8"/>
                                    </Grid.Clip>
                                    <Ellipse Width="16" Height="16">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush GradientOrigin="0.38,0.3" Center="0.45,0.4" RadiusX="0.65" RadiusY="0.65">
                                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                                <GradientStop Color="#E2E8F0" Offset="0.72"/>
                                                <GradientStop Color="#BAC7D8" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Grid Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid.RenderTransform>
                                            <TranslateTransform x:Name="IdleLeftPupilTransform" X="0" Y="0"/>
                                        </Grid.RenderTransform>
                                        <Ellipse Width="10" Height="10" Fill="{DynamicResource AccentBrightBrush}"/>
                                        <Ellipse Width="5.6" Height="5.6" Fill="#090D16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Ellipse Width="2.5" Height="2.5" Fill="#FFFFFF" Opacity="0.95" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1.8,1.8,0,0"/>
                                    </Grid>
                                </Grid>

                                <!-- Right Eye -->
                                <Grid x:Name="IdleRightEyeWrap" Width="16" Height="16" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="IdleRightEyeBlink" ScaleX="1" ScaleY="1"/>
                                    </Grid.RenderTransform>
                                    <Grid.Clip>
                                        <EllipseGeometry Center="8,8" RadiusX="8" RadiusY="8"/>
                                    </Grid.Clip>
                                    <Ellipse Width="16" Height="16">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush GradientOrigin="0.38,0.3" Center="0.45,0.4" RadiusX="0.65" RadiusY="0.65">
                                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                                <GradientStop Color="#E2E8F0" Offset="0.72"/>
                                                <GradientStop Color="#BAC7D8" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Grid Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid.RenderTransform>
                                            <TranslateTransform x:Name="IdleRightPupilTransform" X="0" Y="0"/>
                                        </Grid.RenderTransform>
                                        <Ellipse Width="10" Height="10" Fill="{DynamicResource AccentBrightBrush}"/>
                                        <Ellipse Width="5.6" Height="5.6" Fill="#090D16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Ellipse Width="2.5" Height="2.5" Fill="#FFFFFF" Opacity="0.95" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1.8,1.8,0,0"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- EXPANDED PANEL -->
                        <Grid x:Name="ExpandedContentGrid" Visibility="Collapsed" Margin="18,14,18,18" VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Unified Atoll Header Bar: Left active tab pill + monochrome tab icons | Right mic dot + time + controls + collapse -->
                            <Grid Grid.Row="0" Margin="0,0,0,12" Background="#01000000">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton x:Name="TabApps" Content="Главная" Style="{StaticResource AtollHeaderTabBtn}" Tag="M 3,10 L 12,3 L 21,10 V 20 H 15 V 14 H 9 V 20 H 3 Z" IsChecked="True" Checked="Tab_Checked" ToolTip="Главная"/>
                                    <RadioButton x:Name="TabRemote" Content="Музыка" Style="{StaticResource AtollHeaderTabBtn}" Tag="M 9,18 V 5 L 21,3 V 16 M 6,18 A 3,3 0 1 1 6,17.9 M 18,16 A 3,3 0 1 1 18,15.9" Checked="Tab_Checked" ToolTip="Музыка, микшер громкости и яркость"/>
                                    <RadioButton x:Name="TabSystem" Content="Система" Style="{StaticResource AtollHeaderTabBtn}" Tag="M 13,2 L 4,14 H 12 L 11,22 L 20,10 H 12 Z" Checked="Tab_Checked" ToolTip="Пункт управления, CPU/GPU/RAM/Диски, Discord и DND"/>
                                    <RadioButton x:Name="TabScreenTime" Content="Время" Style="{StaticResource AtollHeaderTabBtn}" Tag="M 12,3 A 9,9 0 1 0 12,21 A 9,9 0 1 0 12,3 M 12,7 V 12 L 15.5,14" Checked="Tab_Checked" ToolTip="Экранное время и игровая статистика"/>
                                    <RadioButton x:Name="TabCleaner" Content="Очистка" Style="{StaticResource AtollHeaderTabBtn}" Tag="M 4,6 H 20 M 9,6 V 4 H 15 V 6 M 6,6 L 7,20 H 17 L 18,6" Margin="0" Checked="Tab_Checked" ToolTip="Безопасная очистка системы и ОЗУ"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Ellipse x:Name="ExpandedStatusDot" Width="7" Height="7" Fill="#22C55E" Margin="0,0,7,0" VerticalAlignment="Center" ToolTip="Индикатор микрофона / камеры"/>
                                    <TextBlock x:Name="ExpandedTimeText" Text="12:00" FontSize="12.5" FontWeight="SemiBold" Foreground="#F4F4F5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="ExpandedDateText" Visibility="Collapsed"/>
                                    <Border x:Name="ExpandedToastPill" Background="#1D2234" CornerRadius="10" Padding="8,2.5" Margin="0,0,6,0" Visibility="Collapsed" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="ExpandedToastText" Text="" FontSize="10" Foreground="{DynamicResource AccentBrightBrush}" MaxWidth="150" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <Button x:Name="ExpandedToastActionBtn" Content="Открыть" Style="{StaticResource AccentButton}" Background="#16A34A" Padding="6,1" FontSize="9.2" Margin="6,0,0,0" Visibility="Collapsed" Click="CompactToastAction_Click"/>
                                        </StackPanel>
                                    </Border>

                                    <Button x:Name="HeaderActionsBtn" Style="{StaticResource DarkButton}" Padding="0" Width="26" Height="26" Background="#1A1B20" BorderBrush="#2A2D38" BorderThickness="1" ToolTip="Действия (глазик, отцентровка, редактировать, настройки)" Click="HeaderActionsBtn_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="13"/></Style>
                                        </Button.Resources>
                                        <Path Data="M 5,12 A 1.3,1.3 0 1 1 5,11.9 M 12,12 A 1.3,1.3 0 1 1 12,11.9 M 19,12 A 1.3,1.3 0 1 1 19,11.9" Stroke="#E4E4E7" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Warning, Actions Dropdown & Update Banners -->
                            <StackPanel Grid.Row="1">
                                <!-- Expandable Top-Right Actions Menu (replaces cluttered header icons & collapse button) -->
                                <Border x:Name="HeaderActionsMenuBorder" Background="#161820" BorderBrush="#2E3240" BorderThickness="1" CornerRadius="14" Padding="8" Margin="0,0,0,9" Visibility="Collapsed">
