<Window x:Class="DesktopIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Island"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MouseWheel="Window_MouseWheel"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#0EA5E9"/>
        <SolidColorBrush x:Key="AccentBrightBrush" Color="#38BDF8"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#1E3A5F"/>

        <Style x:Key="TabPillButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#252736"/>
                                <Setter Property="Foreground" Value="#E2E8F0"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubPillButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Background" Value="#161722"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#282B3C" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrightBrush}"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#232433"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#313347"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconToggleButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="#232433"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#313347"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box" Width="15" Height="15" CornerRadius="4" Background="#1D1F2C" BorderBrush="#3B3F56" BorderThickness="1.2" Margin="0,0,7,0">
                                <Path x:Name="Tick" Data="M 3,7.5 L 6,10.5 L 12,4" Stroke="#FFFFFF" StrokeThickness="1.8" Visibility="Collapsed" StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrightBrush}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#2D3044" CornerRadius="2.5"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- No Background & no DropShadow shader box so nothing forms a translucent rectangle around rounded pills -->
    <Grid x:Name="RootCanvasContainer" Margin="0">
        <StackPanel x:Name="OuterDockStack" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <StackPanel.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="IslandMagnetScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="IslandMagnetTranslate" X="0" Y="0"/>
                </TransformGroup>
            </StackPanel.RenderTransform>
            <!-- Rounded early-trigger hover halo strictly hugging the rounded island -->
            <Border x:Name="IslandHoverZone"
                    Padding="2"
                    CornerRadius="20"
                    Background="#01000000"
                    VerticalAlignment="Top"
                    MouseEnter="IslandHoverZone_MouseEnter"
                    MouseLeave="IslandHoverZone_MouseLeave">

                <!-- MAIN ISLAND CAPSULE -->
                <Border x:Name="IslandBorder"
                        Width="380"
                        Height="36"
                        CornerRadius="18"
                        Background="#FC0D0E14"
                        BorderBrush="#2E3245"
                        BorderThickness="1"
                        ClipToBounds="True"
                        AllowDrop="True"
                        DragEnter="Island_DragEnter"
                        DragLeave="Island_DragLeave"
                        Drop="Island_Drop"
                        MouseDown="Island_MouseDown"
                        PreviewMouseLeftButtonDown="Island_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="Island_PreviewMouseMove"
                        PreviewMouseLeftButtonUp="Island_PreviewMouseLeftButtonUp">

                    <Grid VerticalAlignment="Top">
                        <!-- COMPACT BAR -->
                        <Grid x:Name="CompactContentGrid" Height="36" VerticalAlignment="Top" Visibility="Visible">
                            <!-- Normal metrics strip -->
                            <StackPanel x:Name="CompactMetricsStrip"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="12,0">
                                <Ellipse x:Name="StatusDot" Width="6.5" Height="6.5" Fill="{DynamicResource AccentBrightBrush}" Margin="0,0,7,0" VerticalAlignment="Center" ToolTip="Статус островка"/>
                                <Border x:Name="ScreenRecordBadge" Background="#7F1D1D" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="7" Padding="5,0.5" Margin="0,0,5,0" Visibility="Collapsed" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="ScreenRecordBadge_Click" ToolTip="Идёт запись экрана (нажмите чтобы остановить)">
                                    <TextBlock x:Name="ScreenRecordTimerText" Text="● REC 00:00" FontSize="9" FontWeight="Bold" Foreground="#FEE2E2"/>
                                </Border>
                                <Border x:Name="StreamRecBadge" Background="#450A0A" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="4,0.5" Margin="0,0,5,0" Visibility="Collapsed" VerticalAlignment="Center" ToolTip="Стрим-щит активен (названия скрыты)">
                                    <TextBlock Text="🛡 REC" FontSize="8.5" FontWeight="Bold" Foreground="#FCA5A5"/>
                                </Border>
                                <TextBlock x:Name="GameMicWarnIcon" Text="🔇" FontSize="10.5" Foreground="#F87171" Margin="0,0,5,0" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="Микрофон выключен в игре!"/>

                                <TextBlock x:Name="CompactTimeText" Text="12:00" FontSize="12.5" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CompactSessionText" Text="" FontSize="10.5" Foreground="#64748B" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <TextBlock x:Name="CompactWeatherText" Text="" FontSize="11" Foreground="#94A3B8" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>

                                <Border x:Name="CompactTimerPill" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="6,1.5" Margin="6,0,0,0" Visibility="Collapsed" VerticalAlignment="Center">
                                    <TextBlock x:Name="CompactTimerText" Text="🌙 30:00" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrightBrush}"/>
                                </Border>

                                <TextBlock x:Name="CompactSep1" Text="·" FontSize="12" Foreground="#475569" Margin="6,0" VerticalAlignment="Center"/>

                                <!-- FPS left of CPU, highlighted in accent blue -->
                                <TextBlock x:Name="CompactFpsText" Text="0 FPS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrightBrush}" VerticalAlignment="Center" Margin="0,0,5,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="CompactSysText" FontSize="11" VerticalAlignment="Center">
                                    <Run x:Name="CpuLabelRun" Text="CPU " Foreground="#64748B"/><Run x:Name="CpuValRun" Text="0%" Foreground="#E2E8F0" FontWeight="SemiBold"/><Run x:Name="GpuSepRun" Text="" Foreground="#475569"/><Run x:Name="GpuLabelRun" Text="" Foreground="#64748B"/><Run x:Name="GpuValRun" Text="" Foreground="#38BDF8" FontWeight="SemiBold"/><Run x:Name="GpuTempRun" Text="" Foreground="#FBBF24" FontWeight="SemiBold"/><Run x:Name="RamSepRun" Text=" · " Foreground="#475569"/><Run x:Name="RamLabelRun" Text="RAM " Foreground="#64748B"/><Run x:Name="RamValRun" Text="0%" Foreground="#CBD5E1" FontWeight="SemiBold"/>
                                </TextBlock>
                                <TextBlock x:Name="CompactPingText" Text="" FontSize="10.5" Foreground="#64748B" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <TextBlock x:Name="CompactNetJitterBadge" Text="📶" FontSize="10" Foreground="#FACC15" Margin="4,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="Нестабильная сеть (потери/скачки пинга)"/>
                                <TextBlock x:Name="CompactDownloadSurgeText" Text="" FontSize="10.5" FontWeight="SemiBold" Foreground="#38BDF8" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>

                                <!-- Live mini audio equalizer -->
                                <StackPanel x:Name="CompactEqPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed" Height="14">
                                    <Border x:Name="EqBar1" Width="2.5" Height="4" CornerRadius="1.2" Background="{DynamicResource AccentBrightBrush}" VerticalAlignment="Bottom" Margin="0,0,1.5,2"/>
                                    <Border x:Name="EqBar2" Width="2.5" Height="9" CornerRadius="1.2" Background="{DynamicResource AccentBrightBrush}" VerticalAlignment="Bottom" Margin="0,0,1.5,2"/>
                                    <Border x:Name="EqBar3" Width="2.5" Height="6" CornerRadius="1.2" Background="{DynamicResource AccentBrightBrush}" VerticalAlignment="Bottom" Margin="0,0,1.5,2"/>
                                    <Border x:Name="EqBar4" Width="2.5" Height="10" CornerRadius="1.2" Background="{DynamicResource AccentBrightBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                </StackPanel>

                                <TextBlock x:Name="CompactNetText" Text="" FontSize="10.5" Foreground="{DynamicResource AccentBrightBrush}" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </StackPanel>

                            <!-- Sleek full-island Animated Music Mode (compact Apple Dynamic Island style, fixed compact width + real cover art + lively animations) -->
                            <Grid x:Name="CompactMusicStrip" Visibility="Collapsed" Margin="10,0" VerticalAlignment="Center" Height="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Spinning glowing music disc / album thumbnail orb -->
                                <Grid Grid.Column="0" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Border x:Name="MusicOrbRing" Width="24" Height="24" CornerRadius="12" RenderTransformOrigin="0.5,0.5" BorderThickness="1.7">
                                        <Border.RenderTransform>
                                            <RotateTransform x:Name="MusicOrbRotate" Angle="0"/>
                                        </Border.RenderTransform>
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#38BDF8" Offset="0"/>
                                                <GradientStop Color="#818CF8" Offset="0.5"/>
                                                <GradientStop Color="#F472B6" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <Border.Background>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#33818CF8" Offset="0"/>
                                                <GradientStop Color="#141827" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Ellipse x:Name="MusicThumbCircle" Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                        <Ellipse.Fill>
                                            <ImageBrush x:Name="MusicThumbBrush" Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Ellipse x:Name="MusicStatusDot" Width="7" Height="7" Fill="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Clean clipped single-line scrolling title -->
                                <Grid Grid.Column="1" Width="118" ClipToBounds="True" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Canvas Height="18" VerticalAlignment="Center">
                                        <TextBlock x:Name="CompactMusicTitleText" Text="Музыка" FontSize="11.5" FontWeight="SemiBold" Foreground="#F8FAFC" Canvas.Top="1">
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform x:Name="CompactMusicMarqueeTransform" X="0"/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Canvas>
                                </Grid>

                                <!-- 7-bar lively colorful waveform -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="22">
                                    <Border x:Name="MusicBar1" Width="2.5" Height="5" CornerRadius="1.25" Background="#38BDF8" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                    <Border x:Name="MusicBar2" Width="2.5" Height="11" CornerRadius="1.25" Background="#60A5FA" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                    <Border x:Name="MusicBar3" Width="2.5" Height="17" CornerRadius="1.25" Background="#818CF8" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                    <Border x:Name="MusicBar4" Width="2.5" Height="13" CornerRadius="1.25" Background="#A78BFA" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                    <Border x:Name="MusicBar5" Width="2.5" Height="18" CornerRadius="1.25" Background="#C084FC" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                    <Border x:Name="MusicBar6" Width="2.5" Height="10" CornerRadius="1.25" Background="#E879F9" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                    <Border x:Name="MusicBar7" Width="2.5" Height="6" CornerRadius="1.25" Background="#F472B6" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Vertical Side-Docked metrics strip (used when DockEdge = Left / Right) -->
                            <StackPanel x:Name="CompactSideStrip"
                                        Orientation="Vertical"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="8,9"
                                        Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                    <Ellipse x:Name="SideStatusDot" Width="5.5" Height="5.5" Fill="{DynamicResource AccentBrightBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SideTimeText" Text="12:00" FontSize="11.5" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border x:Name="SideRecordBadge" Background="#7F1D1D" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="4,1" HorizontalAlignment="Center" Margin="0,1,0,3" Visibility="Collapsed" Cursor="Hand" MouseLeftButtonUp="ScreenRecordBadge_Click">
                                    <TextBlock x:Name="SideRecordTimerText" Text="● 00:00" FontSize="8.5" FontWeight="Bold" Foreground="#FEE2E2"/>
                                </Border>
                                <TextBlock x:Name="SideWeatherText" Text="" FontSize="9.5" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,2" Visibility="Collapsed"/>
                                <Border Height="1" Background="#25283B" Margin="4,3,4,4"/>
                                <TextBlock x:Name="SideFpsText" Text="" FontSize="10" FontWeight="SemiBold" Foreground="#4ADE80" HorizontalAlignment="Center" Margin="0,0,0,2" Visibility="Collapsed"/>
                                <TextBlock x:Name="SideSysText" Text="CPU 0%&#x0a;RAM 0%" FontSize="9.5" Foreground="#CBD5E1" TextAlignment="Center" HorizontalAlignment="Center" LineHeight="13"/>
                                <TextBlock x:Name="SidePingText" Text="" FontSize="9.2" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="SideToastText" Text="" FontSize="9.2" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrightBrush}" TextTrimming="CharacterEllipsis" MaxWidth="52" HorizontalAlignment="Center" Margin="0,3,0,0" Visibility="Collapsed"/>
                            </StackPanel>

                            <!-- Dynamic Toast overlay inside compact bar -->
                            <Grid x:Name="CompactToastStrip" Visibility="Collapsed" Margin="14,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse x:Name="ToastColorSwatch" Width="12" Height="12" Visibility="Collapsed" Margin="0,0,6,0" Stroke="#80FFFFFF" StrokeThickness="1" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CompactToastIcon" Text="✨" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="CompactToastText" Text="" FontSize="11.5" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" MaxWidth="270" TextTrimming="CharacterEllipsis"/>
                                    <Button x:Name="CompactToastActionBtn" Content="Открыть" Style="{StaticResource AccentButton}" Padding="8,2" FontSize="10.5" Margin="8,0,0,0" Visibility="Collapsed" Click="CompactToastAction_Click"/>
                                </StackPanel>
                                <Border x:Name="ToastProgressHost" Grid.Row="1" Height="2.5" CornerRadius="1.2" Background="#253047" Margin="6,0,6,3" Visibility="Collapsed">
                                    <Border x:Name="ToastProgressFill" Height="2.5" CornerRadius="1.2" Width="0" HorizontalAlignment="Left" Background="{DynamicResource AccentBrightBrush}"/>
                                </Border>
                            </Grid>

                            <!-- Idle stylized round eyes (mutually exclusive sibling — zero text overlap) -->
                            <StackPanel x:Name="CompactIdleEyesStrip"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed"
                                        ToolTip="Режим ожидания — пошевелите мышкой или нажмите клавишу">
                                <!-- Left Eye -->
                                <Grid x:Name="IdleLeftEyeWrap" Width="16" Height="16" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="IdleLeftEyeBlink" ScaleX="1" ScaleY="1"/>
                                    </Grid.RenderTransform>
                                    <Grid.Clip>
                                        <EllipseGeometry Center="8,8" RadiusX="8" RadiusY="8"/>
                                    </Grid.Clip>
                                    <Ellipse Width="16" Height="16">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush GradientOrigin="0.38,0.3" Center="0.45,0.4" RadiusX="0.65" RadiusY="0.65">
                                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                                <GradientStop Color="#E2E8F0" Offset="0.72"/>
                                                <GradientStop Color="#BAC7D8" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Grid Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid.RenderTransform>
                                            <TranslateTransform x:Name="IdleLeftPupilTransform" X="0" Y="0"/>
                                        </Grid.RenderTransform>
                                        <Ellipse Width="10" Height="10" Fill="{DynamicResource AccentBrightBrush}"/>
                                        <Ellipse Width="5.6" Height="5.6" Fill="#090D16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Ellipse Width="2.5" Height="2.5" Fill="#FFFFFF" Opacity="0.95" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1.8,1.8,0,0"/>
                                    </Grid>
                                </Grid>

                                <!-- Right Eye -->
                                <Grid x:Name="IdleRightEyeWrap" Width="16" Height="16" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="IdleRightEyeBlink" ScaleX="1" ScaleY="1"/>
                                    </Grid.RenderTransform>
                                    <Grid.Clip>
                                        <EllipseGeometry Center="8,8" RadiusX="8" RadiusY="8"/>
                                    </Grid.Clip>
                                    <Ellipse Width="16" Height="16">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush GradientOrigin="0.38,0.3" Center="0.45,0.4" RadiusX="0.65" RadiusY="0.65">
                                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                                <GradientStop Color="#E2E8F0" Offset="0.72"/>
                                                <GradientStop Color="#BAC7D8" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Grid Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid.RenderTransform>
                                            <TranslateTransform x:Name="IdleRightPupilTransform" X="0" Y="0"/>
                                        </Grid.RenderTransform>
                                        <Ellipse Width="10" Height="10" Fill="{DynamicResource AccentBrightBrush}"/>
                                        <Ellipse Width="5.6" Height="5.6" Fill="#090D16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Ellipse Width="2.5" Height="2.5" Fill="#FFFFFF" Opacity="0.95" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1.8,1.8,0,0"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- EXPANDED PANEL -->
                        <Grid x:Name="ExpandedContentGrid" Visibility="Collapsed" Margin="14,10,14,12" VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header Bar (Transparent #01000000 lets empty gap drag smoothly) -->
                            <Grid Grid.Row="0" Margin="0,0,0,8" Background="#01000000">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="ExpandedStatusDot" Width="7" Height="7" Fill="{DynamicResource AccentBrightBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ExpandedTimeText" Text="12:00:00" FontSize="14.5" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ExpandedDateText" Text="сегодня" FontSize="11.5" Foreground="#64748B" Margin="8,1,0,0" VerticalAlignment="Center"/>

                                    <Border x:Name="ExpandedToastPill" Background="{DynamicResource AccentSoftBrush}" CornerRadius="9" Padding="7,2" Margin="8,0,0,0" Visibility="Collapsed" VerticalAlignment="Center">
                                        <TextBlock x:Name="ExpandedToastText" Text="" FontSize="10.5" Foreground="{DynamicResource AccentBrightBrush}"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="CenterPosBtn" Style="{StaticResource DarkButton}" Padding="0" Width="26" Height="26" Margin="0,0,5,0" Visibility="Collapsed" ToolTip="Отцентровать островок по центру экрана" Click="CenterPosBtn_Click">
                                        <Border CornerRadius="13" Width="26" Height="26">
                                            <TextBlock Text="⌖" FontSize="13.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Button>
                                    <ToggleButton x:Name="EditAppsBtn" Style="{StaticResource IconToggleButton}" ToolTip="Редактировать приложения (порядок / добавление / удаление)" Margin="0,0,5,0" Checked="EditAppsBtn_Changed" Unchecked="EditAppsBtn_Changed">
                                        <TextBlock Text="✎" FontSize="12"/>
                                    </ToggleButton>
                                    <Button x:Name="EyeTopmostBtn" Width="26" Height="26" Margin="0,0,5,0" Cursor="Hand" ToolTip="Поверх всех окон" Click="EyeTopmostBtn_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" CornerRadius="13" Background="#232433">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#313347"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Border x:Name="EyeBtnBorder" Width="26" Height="26" CornerRadius="13" BorderThickness="1" BorderBrush="#38BDF8">
                                            <Viewbox Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path x:Name="EyeOuterPath"
                                                          Data="M 2,12 C 5,6.5 9,4.5 12,4.5 C 15,4.5 19,6.5 22,12 C 19,17.5 15,19.5 12,19.5 C 9,19.5 5,17.5 2,12 Z"
                                                          Stroke="#38BDF8" StrokeThickness="2" StrokeLineJoin="Round" Fill="#2038BDF8"/>
                                                    <Ellipse x:Name="EyePupil" Canvas.Left="9.2" Canvas.Top="9.2" Width="5.6" Height="5.6" Fill="#F8FAFC"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                    </Button>
                                    <ToggleButton x:Name="PinBtn" Style="{StaticResource IconToggleButton}" ToolTip="Закрепить панель открытой" Margin="0,0,5,0" Click="PinBtn_Click">
                                        <TextBlock Text="📌" FontSize="11"/>
                                    </ToggleButton>
                                    <Button Style="{StaticResource DarkButton}" Padding="0" Width="26" Height="26" ToolTip="Настройки Desktop Island" Click="SettingsBtn_Click">
                                        <Border CornerRadius="13" Width="26" Height="26">
                                            <TextBlock Text="⚙" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Non-Admin Warning Banner -->
                            <Border x:Name="AdminWarningBanner"
                                    Grid.Row="1"
                                    Background="#24F59E0B"
                                    BorderBrush="#88F59E0B"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="9,6"
                                    Margin="0,0,0,8"
                                    Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="🛡" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Запущено без прав админа — для FPS и авто-буста лучше запустить от администратора"
                                                   FontSize="10.5"
                                                   Foreground="#FDE68A"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button x:Name="RestartAsAdminBtn"
                                            Grid.Column="1"
                                            Content="От админа"
                                            Style="{StaticResource AccentButton}"
                                            Background="#D97706"
                                            Padding="10,4"
                                            FontSize="10.5"
                                            VerticalAlignment="Center"
                                            ToolTip="Перезапустить Desktop Island с правами администратора"
                                            Click="RestartAsAdmin_Click"/>
                                </Grid>
                            </Border>

                            <!-- Navigation Tab Pills -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,9">
                                <RadioButton x:Name="TabApps" Content="Запуск" Style="{StaticResource TabPillButton}" Padding="7.5,5" FontSize="10.8" IsChecked="True" Checked="Tab_Checked"/>
                                <RadioButton x:Name="TabRemote" Content="Пульт" Style="{StaticResource TabPillButton}" Padding="7.5,5" FontSize="10.8" Checked="Tab_Checked"/>
                                <RadioButton x:Name="TabUtils" Content="Буфер" Style="{StaticResource TabPillButton}" Padding="7.5,5" FontSize="10.8" Checked="Tab_Checked" ToolTip="Умный буфер, полка файлов, QR и калькулятор"/>
                                <RadioButton x:Name="TabSystem" Content="Система" Style="{StaticResource TabPillButton}" Padding="7.5,5" FontSize="10.8" Checked="Tab_Checked"/>
                                <RadioButton x:Name="TabScreenTime" Content="Время" Style="{StaticResource TabPillButton}" Padding="7.5,5" FontSize="10.8" Checked="Tab_Checked" ToolTip="Статистика экранного времени и игр за сессию"/>
                                <RadioButton x:Name="TabCleaner" Content="Очистка" Style="{StaticResource TabPillButton}" Padding="7.5,5" FontSize="10.8" Margin="0" Checked="Tab_Checked"/>
                            </StackPanel>

                            <!-- TAB BODY -->
                            <Grid Grid.Row="3" VerticalAlignment="Top">
                                <!-- 1. LAUNCH APPS TAB (Max 4 per row, auto-fit height) -->
                                <StackPanel x:Name="AppsPanel" Visibility="Visible">
                                    <WrapPanel x:Name="AppsWrapPanel" Orientation="Horizontal" MaxWidth="436" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="AppsEditHintText"
                                               Text="Режим правки: перетаскивайте иконки мышкой для смены порядка"
                                               FontSize="10.5"
                                               Foreground="#64748B"
                                               Margin="4,4,0,0"
                                               Visibility="Collapsed"/>
                                </StackPanel>

                                <!-- 2. REMOTE CONTROL TAB ("Пульт": Медиа + Звук/Микшер + Яркость + Стрим-щит + Ночной стоп + BT) -->
                                <StackPanel x:Name="RemotePanel" Visibility="Collapsed">
                                    <!-- Now Playing Card -->
                                    <Border Background="#161722" BorderBrush="#242738" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,0,0,7">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="MediaCardThumbBorder" Grid.Column="0" Width="32" Height="32" CornerRadius="7" Background="#1D2030" Margin="0,0,9,0" ClipToBounds="True" Visibility="Collapsed" VerticalAlignment="Center">
                                                    <Image x:Name="MediaCardThumbImg" Stretch="UniformToFill"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                        <TextBlock Text="🎵" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="MediaTitleText" Text="Ничего не воспроизводится" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" MaxWidth="175"/>
                                                        <TextBlock x:Name="MediaSourceBadge" Text="" FontSize="9.5" Foreground="{DynamicResource AccentBrightBrush}" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="MediaArtistText" Text="Включите музыку в Spotify, SoundCloud или браузере" FontSize="10.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" MaxWidth="210"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="⏮" Style="{StaticResource DarkButton}" Width="28" Height="28" Padding="0" Margin="0,0,4,0" Click="MediaPrev_Click" ToolTip="Предыдущий трек"/>
                                                    <Button x:Name="MediaPlayPauseBtn" Content="⏯" Style="{StaticResource AccentButton}" Width="32" Height="28" Padding="0" Margin="0,0,4,0" Click="MediaPlayPause_Click" ToolTip="Воспроизведение / Пауза"/>
                                                    <Button Content="⏭" Style="{StaticResource DarkButton}" Width="28" Height="28" Padding="0" Click="MediaNext_Click" ToolTip="Следующий трек"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Timeline Progress -->
                                            <Border x:Name="MediaProgressHost" Height="2.5" CornerRadius="1.2" Background="#232638" Margin="0,6,0,0" Visibility="Collapsed">
                                                <Border x:Name="MediaProgressFill" Height="2.5" CornerRadius="1.2" Width="0" HorizontalAlignment="Left" Background="{DynamicResource AccentBrightBrush}"/>
                                            </Border>

                                            <!-- Player Binding Pills -->
                                            <Grid Margin="0,6,0,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Плеер:" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <Button x:Name="PlayerAutoBtn" Content="Авто" Style="{StaticResource DarkButton}" Padding="7,2" FontSize="10" Margin="0,0,4,0" Tag="Auto" Click="BindMediaPlayer_Click"/>
                                                    <Button x:Name="PlayerSpotifyBtn" Content="Spotify" Style="{StaticResource DarkButton}" Padding="7,2" FontSize="10" Margin="0,0,4,0" Tag="Spotify" Click="BindMediaPlayer_Click" ToolTip="Привязать Spotify (повторный клик запустит)"/>
                                                    <Button x:Name="PlayerSoundCloudBtn" Content="SoundCloud" Style="{StaticResource DarkButton}" Padding="7,2" FontSize="10" Tag="SoundCloud" Click="BindMediaPlayer_Click" ToolTip="Привязать SoundCloud / музыку из браузера"/>
                                                </StackPanel>
                                                <Button x:Name="LaunchBoundPlayerBtn" Content="↗ Открыть" HorizontalAlignment="Right" Style="{StaticResource DarkButton}" Padding="7,2" FontSize="9.8" Click="LaunchBoundPlayer_Click" ToolTip="Открыть выбранный музыкальный сервис"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Audio Output, Volume, Per-App Mixer & Privacy Row -->
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="7"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#161722" BorderBrush="#242738" BorderThickness="1" CornerRadius="12" Padding="10,7">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,5">
                                                    <TextBlock x:Name="VolumePercentText" Text="🔊 Громкость: —%" FontSize="11" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button x:Name="ToggleAppMixerBtn" Content="🎚" Style="{StaticResource DarkButton}" Padding="6,2" FontSize="10.5" Margin="0,0,4,0" Click="ToggleAppMixer_Click" ToolTip="Мини-микшер громкости по программам"/>
                                                        <Button x:Name="GameAudioBindBtn" Content="🎮" Style="{StaticResource DarkButton}" Padding="6,2" FontSize="10.5" Margin="0,0,4,0" Click="BindGameAudioDevice_Click" Visibility="Collapsed" ToolTip="Закрепить это аудио-устройство за текущей игрой (автопереключение)"/>
                                                        <Button x:Name="AudioSwitchBtn" Content="🎧 Вывод" Style="{StaticResource DarkButton}" Padding="7,2" FontSize="10.5" Click="SwitchAudioOutput_Click" ToolTip="Переключить устройство вывода"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Slider x:Name="MasterVolumeSlider" Minimum="0" Maximum="100" ValueChanged="MasterVolumeSlider_ValueChanged" IsMoveToPointEnabled="True"/>
                                                <ItemsControl x:Name="AppMixerList" Visibility="Collapsed" Margin="0,6,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,2.5">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="82"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding ProcessName}" FontSize="10" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding VolumePercent, Mode=TwoWay}" Tag="{Binding Pid}" ValueChanged="AppSessionSlider_ValueChanged" IsMoveToPointEnabled="True" VerticalAlignment="Center" Margin="4,0"/>
                                                                <Button Grid.Column="2" Content="{Binding MuteGlyph}" Style="{StaticResource DarkButton}" Padding="4,1" FontSize="10" Tag="{Binding Pid}" Click="AppSessionMute_Click"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="#161722" BorderBrush="#242738" BorderThickness="1" CornerRadius="12" Padding="9,7" Width="140">
                                            <StackPanel VerticalAlignment="Center">
                                                <Button x:Name="MicMuteBtn" Content="🎙 Микрофон: Вкл" Style="{StaticResource DarkButton}" Padding="6,4" FontSize="10.5" Margin="0,0,0,4" Click="ToggleMicMute_Click"/>
                                                <Button x:Name="StreamShieldBtn" Content="🛡 Стрим-щит: Выкл" Style="{StaticResource DarkButton}" Padding="6,3" FontSize="10" Click="ToggleStreamShield_Click" ToolTip="Скрыть названия треков и личные превью во время записи/стрима"/>
                                                <TextBlock x:Name="PrivacyStatusText" Text="🔒 Камера и мик свободны" FontSize="9.5" Foreground="#64748B" Margin="2,4,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Monitor Brightness & Night Light -->
                                    <Border Background="#161722" BorderBrush="#242738" BorderThickness="1" CornerRadius="12" Padding="10,6" Margin="0,0,0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="BrightnessLabelText" Grid.Column="0" Text="☀ Яркость" FontSize="10.5" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="80" VerticalAlignment="Center" IsMoveToPointEnabled="True" ValueChanged="BrightnessSlider_ValueChanged"/>
                                            <Button Grid.Column="2" Content="🌙 Ночь" Style="{StaticResource DarkButton}" Padding="7,2" FontSize="10" Margin="8,0,0,0" Click="NightLightBtn_Click" ToolTip="Открыть параметры Ночного света Windows"/>
                                        </Grid>
                                    </Border>

                                    <!-- Bluetooth Control & Devices -->
                                    <Border Background="#161722" BorderBrush="#242738" BorderThickness="1" CornerRadius="12" Padding="10,7" Margin="0,0,0,7">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,5">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Bluetooth" FontSize="11.5" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="BtStateText" Text="· проверка..." FontSize="10.5" Foreground="#94A3B8" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button x:Name="BtExpandBtn" Content="Все ▾" Style="{StaticResource DarkButton}" Padding="7,3" FontSize="10" Margin="0,0,4,0" ToolTip="Показать / скрыть все устройства" Click="BtExpandBtn_Click"/>
                                                    <Button x:Name="BtToggleBtn" Content="Вкл / Выкл" Style="{StaticResource DarkButton}" Padding="8,3" FontSize="10.5" Margin="0,0,4,0" Click="ToggleBluetooth_Click"/>
                                                    <Button Content="⚙" Style="{StaticResource DarkButton}" Padding="7,3" FontSize="10.5" ToolTip="Параметры Bluetooth" Click="OpenBtSettings_Click"/>
                                                </StackPanel>
                                            </Grid>

                                            <ItemsControl x:Name="BtDevicesList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#1D1F2C" CornerRadius="8" Padding="8,4.5" Margin="0,0,0,4">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Medium" Foreground="#F1F5F9" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding StatusLabel}" FontSize="9.8" Foreground="#94A3B8"/>
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Content="{Binding ActionLabel}" Style="{StaticResource DarkButton}" Padding="8,3" FontSize="10" Tag="{Binding}" Click="BtDeviceAction_Click"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock x:Name="BtEmptyText" Text="Сопряжённые Bluetooth-устройства не найдены" FontSize="10" Foreground="#64748B" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,2"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Night Auto-Sleep / Shutdown Timer inside Пульт -->
                                    <Border Background="#161722" BorderBrush="#242738" BorderThickness="1" CornerRadius="12" Padding="10,7" Margin="0,0,0,7">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🌙 Авто-стоп ПК:" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TimerStatusText" Text="Выкл." FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrightBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button x:Name="TimerActionModeBtn" Content="💤 Сон" Style="{StaticResource DarkButton}" Padding="7,3" FontSize="10" Margin="0,0,4,0" Click="TimerActionMode_Click" ToolTip="Действие после отсчёта: Сон ПК или Выключение"/>
                                                <Button Content="30м" Style="{StaticResource DarkButton}" Padding="7,3" FontSize="10" Margin="0,0,4,0" Tag="30" Click="StartTimerPreset_Click"/>
                                                <Button Content="60м" Style="{StaticResource AccentButton}" Padding="7,3" FontSize="10" Margin="0,0,4,0" Tag="60" Click="StartTimerPreset_Click"/>
                                                <Button Content="120м" Style="{StaticResource DarkButton}" Padding="7,3" FontSize="10" Margin="0,0,4,0" Tag="120" Click="StartTimerPreset_Click"/>
                                                <Button Content="Стоп" Style="{StaticResource DarkButton}" Padding="7,3" FontSize="10" Click="StopTimer_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Screen Recording + Monitor Picker + Clear Save Paths -->
                                    <Border Background="#161722" BorderBrush="#242738" BorderThickness="1" CornerRadius="12" Padding="10,7" Margin="0,0,0,7">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button x:Name="ScreenRecordBtn" Content="🔴 Запись экрана" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="10.8" FontWeight="SemiBold" Margin="0,0,5,0" Click="ToggleScreenRecord_Click" ToolTip="Записать выбранный экран в MP4 (Видео\DesktopIsland)"/>
                                                    <Button x:Name="RecordMonitorBtn" Content="🖥 Экран 1" Style="{StaticResource DarkButton}" Padding="8,4" FontSize="10.2" Visibility="Collapsed" Click="CycleRecordMonitor_Click" ToolTip="Выбрать монитор для записи экрана"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Content="📁 Видео" Style="{StaticResource DarkButton}" Padding="7,4" FontSize="10" Margin="0,0,4,0" Click="OpenRecordingsFolder_Click" ToolTip="Открыть папку записей экрана (Видео\DesktopIsland)"/>
                                                    <Button Content="📁 Клипы" Style="{StaticResource DarkButton}" Padding="7,4" FontSize="10" Click="OpenReplayClipsFolder_Click" ToolTip="Открыть папку 30с игровых клипов (ShadowPlay / Xbox Game Bar)"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock x:Name="RecordSaveHintText" Text="Запись → Видео\DesktopIsland · 30с клип → Видео\Captures" FontSize="9.3" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Quick Actions Grid inside Пульт -->
                                    <StackPanel>
                                        <UniformGrid Columns="3" Margin="0,0,0,5">
                                            <Button x:Name="DndToggleBtn" Style="{StaticResource DarkButton}" Margin="0,0,5,0" Padding="6,7" Click="ToggleDnd_Click" ToolTip="Режим «Не беспокоить»: отключает всплывающие уведомления Windows">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock x:Name="DndIconText" Text="🔕" FontSize="13" HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="DndLabelText" Text="Не беспокоить" FontSize="10" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="PowerModeBtn" Style="{StaticResource DarkButton}" Margin="0,0,5,0" Padding="6,7" Click="TogglePowerMode_Click" ToolTip="Переключить схему питания Windows: Баланс ↔ Макс. производительность">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="⚡" FontSize="13" HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="PowerModeLabelText" Text="Питание" FontSize="10" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource DarkButton}" Margin="0" Padding="6,7" Click="ToggleDesktopIcons_Click" ToolTip="Скрыть / показать иконки рабочего стола">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="🙈" FontSize="13" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Иконки стола" FontSize="10" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </UniformGrid>
                                        <UniformGrid Columns="3">
                                            <Button Style="{StaticResource DarkButton}" Margin="0,0,5,0" Padding="6,7" Click="ReplayClipBtn_Click" ToolTip="Сохранить последние 30с игры (ShadowPlay Alt+F10 → Видео\NVIDIA, или Game Bar Win+Alt+G → Видео\Captures)">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="🎬" FontSize="13" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Клип 30с" FontSize="10" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource DarkButton}" Margin="0,0,5,0" Padding="6,7" Click="LockPc_Click" ToolTip="Заблокировать ПК">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="🔒" FontSize="13" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Блокировка" FontSize="10" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource DarkButton}" Margin="0" Padding="6,7" Click="SleepPc_Click" ToolTip="Спящий режим">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="🌙" FontSize="13" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Сон ПК" FontSize="10" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </UniformGrid>
                                    </StackPanel>
                                </StackPanel>

                                <!-- 2B. UTILITIES TAB ("Буфер": Калькулятор/Валюта + QR-код + Полка файлов + Буфер обмена) -->
                                <StackPanel x:Name="UtilsPanel" Visibility="Collapsed">
                                    <!-- Quick Calculator / Currency Converter -->
                                    <Border Background="#161722" BorderBrush="#242738" BorderThickness="1" CornerRadius="12" Padding="9,7" Margin="0,0,0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="QuickCalcBox"
                                                     Grid.Column="0"
                                                     Background="#0E0F16"
                                                     Foreground="#F8FAFC"
                                                     BorderBrush="#292D42"
                                                     BorderThickness="1"
                                                     Padding="8,4"
                                                     FontSize="11"
                                                     CaretBrush="#38BDF8"
                                                     TextChanged="QuickCalcBox_TextChanged"
                                                     ToolTip="Введите пример (1250*0.85) или сумму с валютой (49$ / 120 EUR in UAH)"/>
                                            <TextBlock x:Name="QuickCalcPlaceholder"
                                                       Grid.Column="0"
                                                       Text="1250*0.85 или 49$ → конвертер..."
                                                       FontSize="10.5"
                                                       Foreground="#64748B"
                                                       Margin="9,0,0,0"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False"/>
                                            <TextBlock x:Name="QuickCalcResultText" Grid.Column="1" Text="" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrightBrush}" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            <Button x:Name="CopyCalcResultBtn" Grid.Column="2" Content="📋" Style="{StaticResource DarkButton}" Padding="6,3" FontSize="10.5" Margin="6,0,0,0" Visibility="Collapsed" Click="CopyCalcResult_Click" ToolTip="Скопировать результат"/>
                                        </Grid>
                                    </Border>

                                    <!-- Instant QR Code Preview Card -->
                                    <Border x:Name="QrCodeCard" Background="#161722" BorderBrush="{DynamicResource AccentBrightBrush}" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,0,0,7" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#FFFFFF" CornerRadius="8" Padding="4" Margin="0,0,10,0">
                                                <Image x:Name="QrPreviewImage" Width="96" Height="96" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="QR-код для телефона" FontSize="11.5" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                                <TextBlock x:Name="QrSourceText" Text="" FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap" MaxHeight="52" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="✕" VerticalAlignment="Top" Style="{StaticResource DarkButton}" Padding="6,2" FontSize="10" Click="CloseQrCard_Click"/>
                                        </Grid>
                                    </Border>

                                    <!-- Drag & Drop File Shelf -->
                                    <Border Background="#161722" BorderBrush="#242738" BorderThickness="1" CornerRadius="12" Padding="9,7" Margin="0,0,0,7">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="📎 Полка файлов (Drag &amp; Drop сюда или наружу)" FontSize="10.5" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                                <Button x:Name="ClearShelfBtn" Content="Очистить" HorizontalAlignment="Right" Style="{StaticResource DarkButton}" Padding="6,2" FontSize="9.5" Click="ClearDropShelf_Click" Visibility="Collapsed"/>
                                            </Grid>
                                            <TextBlock x:Name="DropShelfEmptyText" Text="Перетащите любой файл или картинку прямо на островок, чтобы потом вытащить в Telegram / Discord" FontSize="10" Foreground="#64748B" TextWrapping="Wrap"/>
                                            <ItemsControl x:Name="DropShelfList">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#1F2233" CornerRadius="8" Padding="7,4" Margin="0,2,5,2" Cursor="Hand" Tag="{Binding}" PreviewMouseLeftButtonDown="ShelfItem_MouseDown" PreviewMouseMove="ShelfItem_MouseMove" ToolTip="Потяните в приложение или нажмите Открыть">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding IconGlyph}" FontSize="11" Margin="0,0,4,0"/>
                                                                <TextBlock Text="{Binding Name}" FontSize="10.5" Foreground="#E2E8F0" MaxWidth="115" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                <Button Content="✕" Style="{StaticResource DarkButton}" Background="Transparent" Padding="4,0" FontSize="9.5" Margin="4,0,0,0" Tag="{Binding}" Click="RemoveShelfItem_Click"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Smart Clipboard History & Pinned Notes -->
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Умный буфер и заметки" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="📱 QR буфера" Style="{StaticResource DarkButton}" Padding="7,2" FontSize="9.8" Margin="0,0,4,0" Click="QrFromClipboard_Click" ToolTip="Показать QR-код из текущего буфера обмена"/>
                                            <Button Content="🧹 Без стилей" Style="{StaticResource DarkButton}" Padding="7,2" FontSize="9.8" Margin="0,0,4,0" Click="CleanClipboardFormatting_Click" ToolTip="Очистить форматирование текста в буфере"/>
                                            <Button Content="Очистить" Style="{StaticResource DarkButton}" Padding="7,2" FontSize="9.8" Click="ClearClipboardHistory_Click"/>
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl x:Name="ClipboardHistoryList" MaxHeight="205">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#161722" CornerRadius="8" Padding="8,5" Margin="0,0,0,3">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0" Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="ClipboardItemCopy_Click" ToolTip="Нажмите чтобы скопировать">
                                                            <TextBlock Text="{Binding Preview}" FontSize="10.8" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding TimeLabel}" FontSize="9" Foreground="#64748B"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="📱" Style="{StaticResource DarkButton}" Padding="5,2" FontSize="10" Margin="0,0,3,0" Tag="{Binding}" Click="ClipboardItemQr_Click" ToolTip="QR-код"/>
                                                            <Button Content="📌" Style="{StaticResource DarkButton}" Padding="5,2" FontSize="10" Tag="{Binding}" Click="ClipboardItemPin_Click" ToolTip="Закрепить / Открепить"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- 3. SYSTEM TAB (Полное раскрытие по заполненности без зажатого внутреннего скролла) -->
                                <StackPanel x:Name="SystemPanel" Visibility="Collapsed">
                                    <!-- Top Metrics Row -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#161722" BorderBrush="#242738" BorderThickness="1" CornerRadius="10" Padding="9,7">
                                            <Grid>
                                                <Polyline x:Name="CpuSparkline" Stroke="#38BDF8" StrokeThickness="1.4" Opacity="0.35" VerticalAlignment="Bottom" HorizontalAlignment="Right" Height="20" Width="62"/>
                                                <StackPanel>
                                                    <TextBlock Text="CPU / GPU / FPS" FontSize="10" Foreground="#64748B"/>
                                                    <TextBlock x:Name="CpuValText" Text="0%" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                    <TextBlock x:Name="FpsDetailText" Text="0 FPS" FontSize="10" Foreground="{DynamicResource AccentBrightBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="GpuDetailText" Text="" FontSize="9.5" Foreground="#94A3B8" Margin="0,1,0,0" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="2" Background="#161722" BorderBrush="#242738" BorderThickness="1" CornerRadius="10" Padding="9,7">
                                            <Grid>
                                                <Polyline x:Name="RamSparkline" Stroke="#A78BFA" StrokeThickness="1.4" Opacity="0.35" VerticalAlignment="Bottom" HorizontalAlignment="Right" Height="20" Width="62"/>
                                                <StackPanel>
                                                    <TextBlock Text="ОЗУ (RAM)" FontSize="10" Foreground="#64748B"/>
                                                    <TextBlock x:Name="RamValText" Text="0%" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                    <TextBlock x:Name="RamSubText" Text="0 / 0 ГБ" FontSize="10" Foreground="#94A3B8"/>
                                                </StackPanel>
                                                <Button Content="⚡" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource DarkButton}" Padding="5,2" FontSize="10.5" Click="OptimizeRam_Click" ToolTip="Оптимизировать ОЗУ"/>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="4" Background="#161722" BorderBrush="#242738" BorderThickness="1" CornerRadius="10" Padding="9,7">
                                            <Grid>
                                                <Polyline x:Name="NetSparkline" Stroke="#34D399" StrokeThickness="1.4" Opacity="0.35" VerticalAlignment="Bottom" HorizontalAlignment="Right" Height="20" Width="62"/>
                                                <StackPanel>
                                                    <TextBlock x:Name="PingHeaderLabel" Text="Сеть · Ping" FontSize="10" Foreground="#64748B"/>
                                                    <TextBlock x:Name="NetDownText" Text="↓ 0 КБ/с" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrightBrush}" Margin="0,2,0,0"/>
                                                    <TextBlock x:Name="NetUpText" Text="↑ 0 КБ/с" FontSize="10.5" Foreground="#94A3B8"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- Top 3 Heavy Processes -->
                                    <TextBlock Text="Топ-3 процесса по ОЗУ (быстрое завершение)" FontSize="10.5" Foreground="#64748B" Margin="2,0,0,4"/>
                                    <ItemsControl x:Name="TopProcessesList" Margin="0,0,0,6">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#161722" CornerRadius="8" Padding="8,4" Margin="0,0,0,3">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Medium" Foreground="#E2E8F0" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding MemoryFormatted}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <Button Content="✕" Style="{StaticResource DarkButton}" Background="#3A1D24" Foreground="#FCA5A5" Padding="6,1" FontSize="10" Tag="{Binding}" Click="KillProcess_Click" ToolTip="Завершить процесс"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Local Drives -->
                                    <TextBlock Text="Локальные диски" FontSize="10.5" Foreground="#64748B" Margin="2,2,0,4"/>
                                    <ItemsControl x:Name="DrivesItemsControl" Margin="0,0,0,6">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#161722" CornerRadius="8" Padding="9,6" Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="5"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11.5" Foreground="#F8FAFC"/>
                                                                <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#64748B" Margin="6,0,0,0"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <TextBlock FontSize="10.5" Foreground="#94A3B8" Margin="0,0,7,0" VerticalAlignment="Center">
                                                                    <Run Text="Свободно "/>
                                                                    <Run Text="{Binding FreeGb, StringFormat={}{0:F1}}" Foreground="#F8FAFC" FontWeight="SemiBold"/>
                                                                    <Run Text=" ГБ"/>
                                                                </TextBlock>
                                                                <Button Content="Открыть" Padding="7,2" FontSize="10" Style="{StaticResource DarkButton}" Tag="{Binding RootPath}" Click="OpenDrive_Click"/>
                                                            </StackPanel>
                                                        </Grid>
                                                        <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding UsedPercent}" Height="4" Foreground="{DynamicResource AccentBrush}" Background="#242738" BorderThickness="0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Recent Downloads -->
                                    <TextBlock Text="Недавние загрузки" FontSize="10.5" Foreground="#64748B" Margin="2,2,0,4"/>
                                    <ItemsControl x:Name="RecentDownloadsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource DarkButton}" Background="#161722" HorizontalContentAlignment="Stretch" Padding="9,5" Margin="0,0,0,3" Tag="{Binding FullPath}" Click="OpenRecentFile_Click" ToolTip="Открыть файл">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center">
                                                            <Run Text="{Binding SizeFormatted}"/>
                                                            <Run Text=" · "/>
                                                            <Run Text="{Binding TimeLabel}"/>
                                                        </TextBlock>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- 3B. SCREEN TIME & GAME SESSION TAB -->
                                <StackPanel x:Name="ScreenTimePanel" Visibility="Collapsed">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#161722" BorderBrush="#242738" BorderThickness="1" CornerRadius="10" Padding="10,7">
                                            <StackPanel>
                                                <TextBlock Text="За сессию островка" FontSize="10" Foreground="#64748B"/>
                                                <TextBlock x:Name="ScreenTimeTotalText" Text="0с" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                <TextBlock x:Name="ScreenTimeAppsCountText" Text="Программ: 0" FontSize="10" Foreground="#94A3B8"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="#161722" BorderBrush="#242738" BorderThickness="1" CornerRadius="10" Padding="10,7">
                                            <StackPanel>
                                                <TextBlock Text="Игры за сессию" FontSize="10" Foreground="#64748B"/>
                                                <TextBlock x:Name="ScreenTimeGamesTotalText" Text="0с" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrightBrush}"/>
                                                <TextBlock x:Name="ScreenTimeLastGameText" Text="Игр не было" FontSize="10" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Background="#161722" BorderBrush="#262A3E" BorderThickness="1" CornerRadius="10" Padding="9,7" Margin="0,0,0,8">
                                        <Grid>
                                            <TextBlock x:Name="GameStatsDetailText" Text="Полноэкранная игра в этой сессии пока не запускалась" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                                            <WrapPanel x:Name="GameStatsBadgesPanel" Orientation="Horizontal" Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="Активные программы и игры (за сессию)" FontSize="10.5" Foreground="#64748B" Margin="2,0,0,5"/>
                                    <ItemsControl x:Name="ScreenTimeListControl" Margin="0,0,0,8">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#161722" CornerRadius="8" Padding="9,6" Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="4"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding IconLabel}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding ProcessName}" FontSize="11" FontWeight="Medium" Foreground="#E2E8F0" MaxWidth="215" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding SubLabel}" FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding SharePercent}" Height="4" Foreground="{DynamicResource AccentBrush}" Background="#242738" BorderThickness="0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock x:Name="ScreenTimeEmptyText" Text="Пока нет данных об активных окнах" FontSize="11" Foreground="#64748B" Margin="2,2,0,6" Visibility="Visible"/>

                                    <Grid>
                                        <TextBlock Text="Считается активное окно на экране" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <Button Content="Сбросить" Style="{StaticResource DarkButton}" Padding="10,4" FontSize="10.5" HorizontalAlignment="Right" Click="ResetScreenTime_Click"/>
                                    </Grid>
                                </StackPanel>

                                <!-- 5. CLEANER & RAM TAB -->
                                <StackPanel x:Name="CleanerPanel" Visibility="Collapsed">
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Безопасная очистка (браузеры и пароли не трогаются)" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <Button Content="Обновить" Style="{StaticResource DarkButton}" Padding="8,2.5" FontSize="10.5" HorizontalAlignment="Right" Click="RefreshCleanup_Click"/>
                                    </Grid>
                                    <ItemsControl x:Name="CleanupItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#161722" CornerRadius="8" Padding="9,5" Margin="0,0,0,4">
                                                    <Grid>
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="Medium" Foreground="#E2E8F0"/>
                                                                <TextBlock Text="{Binding Description}" FontSize="9.8" Foreground="#64748B" TextTrimming="CharacterEllipsis" MaxWidth="270"/>
                                                            </StackPanel>
                                                        </CheckBox>
                                                        <TextBlock Text="{Binding SizeFormatted}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrightBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid Margin="0,7,0,0">
                                        <TextBlock x:Name="CleanupStatusText" Text="Нажмите «Очистить»" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" MaxWidth="165" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="CleanNowBtn" Content="Удалить файлы" Style="{StaticResource AccentButton}" Padding="11,6" Margin="0,0,5,0" Click="CleanNow_Click"/>
                                            <Button x:Name="OptimizeRamBtn" Content="⚡ ОЗУ" Style="{StaticResource DarkButton}" Padding="10,6" Click="OptimizeRam_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Border>

            <!-- QUICK ACTION PILLS ROW (Side-by-side next to top capsule, or sleek aligned shelf below side capsule) -->
            <StackPanel x:Name="SideActionStrip"
                        Orientation="Horizontal"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        MouseEnter="SideActionStrip_MouseEnter"
                        MouseLeave="IslandHoverZone_MouseLeave">
            <!-- INDEPENDENT RIGHT-SIDE RAM CIRCLE / PILL (Visible normally, hidden in idle eyes mode) -->
            <Border x:Name="RamQuickPill"
                    Height="36"
                    Width="36"
                    CornerRadius="18"
                    Margin="6,2,0,0"
                    VerticalAlignment="Top"
                    Background="#FC0D0E14"
                    BorderBrush="#2E3245"
                    BorderThickness="1"
                    ClipToBounds="True"
                    Cursor="Hand"
                    MouseLeftButtonUp="RamQuickPill_Click"
                    MouseEnter="RamQuickPill_MouseEnter"
                    MouseLeave="RamQuickPill_MouseLeave">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0">
                    <Path x:Name="RamLightningPath"
                          Width="13"
                          Height="15"
                          Stretch="Uniform"
                          Stroke="Transparent"
                          StrokeThickness="1.2"
                          StrokeLineJoin="Round"
                          Data="M 8,0 L 1,9 L 6.5,9 L 5,16 L 13,6.5 L 7.5,6.5 Z"
                          VerticalAlignment="Center">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                                <GradientStop x:Name="LightningFillStop1" Color="#FACC15" Offset="0.0"/>
                                <GradientStop x:Name="LightningFillStop2" Color="#64748B" Offset="0.0"/>
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                    <TextBlock x:Name="RamQuickText"
                               Text="ОЗУ"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="#E2E8F0"
                               Margin="5,0,0,0"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- QUICK MIC MUTE PILL (Visible when expanded or in fullscreen games, flush notch style) -->
            <Border x:Name="GameMicPill"
                    Height="30"
                    Width="30"
                    CornerRadius="0,0,15,15"
                    Margin="5,0,0,0"
                    VerticalAlignment="Top"
                    Background="#FC0D0E14"
                    BorderBrush="#2E3245"
                    BorderThickness="1,0,1,1"
                    Visibility="Collapsed"
                    Cursor="Hand"
                    ToolTip="Быстрый Mute микрофона (удерживайте Alt + клик в игре)"
                    MouseLeftButtonUp="GameMicPill_Click"
                    MouseEnter="GameMicPill_MouseEnter"
                    MouseLeave="GameMicPill_MouseLeave">
                <Viewbox x:Name="GameMicViewbox" Width="9.5" Height="9.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Data="M12,2 A3,3 0 0 1 15,5 V11 A3,3 0 0 1 9,11 V5 A3,3 0 0 1 12,2 Z"
                              x:Name="MicCapsulePath" Fill="#E2E8F0"/>
                        <Path Data="M6,10 A6,6 0 0 0 18,10 M12,16 V20 M8.5,20 H15.5"
                              x:Name="MicStandPath" Stroke="#E2E8F0" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Line x:Name="MicSlashLine" X1="4" Y1="4" X2="20" Y2="20" Stroke="#F87171" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                    </Canvas>
                </Viewbox>
            </Border>

            <!-- QUICK 30s REPLAY CLIP PILL (Visible in fullscreen games, matches flush notch style) -->
            <Border x:Name="ReplayClipPill"
                    Height="15"
                    Width="30"
                    CornerRadius="0,0,7.5,7.5"
                    Margin="5,0,0,0"
                    VerticalAlignment="Top"
                    Background="#FC0D0E14"
                    BorderBrush="#2E3245"
                    BorderThickness="1,0,1,1"
                    Visibility="Collapsed"
                    Cursor="Hand"
                    ToolTip="Сохранить 30с игровой клип (Alt+F10 / Win+Alt+G)"
                    MouseLeftButtonUp="ReplayClipBtn_Click"
                    MouseEnter="ReplayClipPill_MouseEnter"
                    MouseLeave="ReplayClipPill_MouseLeave">
                <Viewbox x:Name="ReplayClipViewbox" Width="9.5" Height="9.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Data="M3,7 A2,2 0 0 1 5,5 H14 A2,2 0 0 1 16,7 V17 A2,2 0 0 1 14,19 H5 A2,2 0 0 1 3,17 Z M16,10 L21,7 V17 L16,14 Z"
                              Fill="#E2E8F0"/>
                        <Ellipse Canvas.Left="7.5" Canvas.Top="10" Width="4" Height="4" Fill="#F87171"/>
                    </Canvas>
                </Viewbox>
            </Border>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
