                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource AtollUnboxedBtn}" Click="ToggleQuickCommand_Click" ToolTip="Быстрый запуск команды, пути, URL или калькулятора">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Border Width="42" Height="42" CornerRadius="21" Background="#1F2028" Margin="0,0,0,6" HorizontalAlignment="Center">
                                                    <TextBlock Text="&gt;_" FontSize="12.5" FontWeight="Bold" Foreground="#A1A1AA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Команда" FontSize="10.2" Foreground="#D4D4D8" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="HomeTranslateCircleBtn" Style="{StaticResource AtollUnboxedBtn}" Click="ScreenTranslate_Click" ToolTip="Перевод выделенной области экрана (RU ⇄ EN)">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Border Width="42" Height="42" CornerRadius="21" Background="#2C200E" Margin="0,0,0,6" HorizontalAlignment="Center">
                                                    <TextBlock Text="Аа" FontSize="13.5" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Перевод" FontSize="10.2" Foreground="#D4D4D8" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>

                                    <!-- Expandable Screen Translator Result Card -->
                                    <Border x:Name="HomeTranslateCard" Background="#15161A" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="14" Padding="10,8" Margin="0,0,0,9" Visibility="Collapsed">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,5">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Перевод экрана" FontSize="11" FontWeight="SemiBold" Foreground="#FBBF24" VerticalAlignment="Center"/>
                                                    <Button x:Name="HomeTranslateSwapBtn" Content="Авто (RU - EN)" Style="{StaticResource DarkButton}" Padding="7,2" FontSize="9.5" Margin="8,0,0,0" Click="SwapTranslateDirection_Click" ToolTip="Переключить направление: Авто / EN→RU / RU→EN"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="Копировать" Style="{StaticResource DarkButton}" Padding="7,2" FontSize="9.5" Margin="0,0,4,0" Click="CopyTranslateResult_Click"/>
                                                    <Button Content="Оригинал" Style="{StaticResource DarkButton}" Padding="7,2" FontSize="9.5" Margin="0,0,4,0" Click="CopyTranslateOriginal_Click"/>
                                                    <Button Content="✕" Style="{StaticResource DarkButton}" Padding="6,2" FontSize="9.5" Click="CloseTranslateCard_Click"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock x:Name="HomeTranslateOriginalText" Text="" FontSize="10" Foreground="#9CA3AF" TextWrapping="Wrap" MaxHeight="52" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                                            <Border Background="#0D0E12" CornerRadius="9" Padding="8,6">
                                                <TextBox x:Name="HomeTranslateOutputBox" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="#F4F4F5" FontSize="11.5" FontWeight="Medium" TextWrapping="Wrap" MaxHeight="110" VerticalScrollBarVisibility="Auto"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Expandable Quick Command Bar -->
                                    <Border x:Name="HomeCommandCard" Background="#15161A" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="13" Padding="8,7" Margin="0,0,0,9" Visibility="Collapsed">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="HomeCommandBox" Grid.Column="0" Background="#0D0E12" Foreground="#F4F4F5" BorderBrush="#2A2B33" BorderThickness="1" Padding="8,5" FontSize="11" CaretBrush="#38BDF8" KeyDown="HomeCommandBox_KeyDown" TextChanged="HomeCommandBox_TextChanged"/>
                                                <TextBlock x:Name="HomeCommandPlaceholder" Grid.Column="0" Text="cmd / URL / путь / расчёт (49$ или 250*1.2)..." FontSize="10.2" Foreground="#71717A" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                                <Button Grid.Column="1" Content="▶" Style="{StaticResource AccentButton}" Padding="9,4" FontSize="10.5" Margin="6,0,0,0" Click="RunQuickCommand_Click"/>
                                                <Button Grid.Column="2" Content="✕" Style="{StaticResource DarkButton}" Padding="7,4" FontSize="10" Margin="4,0,0,0" Click="CloseQuickCommand_Click"/>
                                            </Grid>
                                            <TextBlock x:Name="HomeCommandCalcPreview" Text="" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrightBrush}" Margin="2,4,0,0" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Row 3: Music Card (with player source switcher) + Colored Vector Weather Card -->
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="9"/>
                                            <ColumnDefinition Width="166"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Music Card with Autoselector (Авто / Spotify / SoundCloud / YT Music) -->
                                        <Border Grid.Column="0" Background="#18191F" BorderBrush="#252730" BorderThickness="1" CornerRadius="18" Padding="13,11">
                                            <StackPanel VerticalAlignment="Center">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="HomeMediaThumbBorder" Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="#23252E" Margin="0,0,10,0" ClipToBounds="True" VerticalAlignment="Center">
                                                        <Grid>
                                                            <Path x:Name="HomeMediaFallbackNote" Data="M 9,16 V 6 L 18,4 V 14 M 7,16 A 2.2,2.2 0 1 1 7,15.9 M 16,14 A 2.2,2.2 0 1 1 16,13.9" Stroke="#A1A1AA" StrokeThickness="1.6" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Image x:Name="HomeMediaThumbImg" Stretch="UniformToFill" Visibility="Collapsed"/>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonUp="HomeMediaCard_Click" ToolTip="Нажмите, чтобы открыть полный микшер музыки и звука">
                                                        <TextBlock x:Name="HomeMediaTitleText" Text="Ничего не играет" FontSize="12" FontWeight="SemiBold" Foreground="#F4F4F5" TextTrimming="CharacterEllipsis" MaxWidth="165"/>
                                                        <TextBlock x:Name="HomeMediaArtistText" Text="Выберите или включите плеер" FontSize="10" Foreground="#8E9099" TextTrimming="CharacterEllipsis" MaxWidth="165"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="⏮" Style="{StaticResource DarkButton}" Background="Transparent" BorderThickness="0" Width="24" Height="24" Padding="0" FontSize="11" Foreground="#D4D4D8" Click="MediaPrev_Click"/>
                                                        <Button x:Name="HomeMediaPlayBtn" Content="▶" Style="{StaticResource DarkButton}" Background="#252730" BorderBrush="#353744" Width="28" Height="28" Padding="0" FontSize="11" Foreground="#FFFFFF" Margin="2,0" Click="MediaPlayPause_Click"/>
                                                        <Button Content="⏭" Style="{StaticResource DarkButton}" Background="Transparent" BorderThickness="0" Width="24" Height="24" Padding="0" FontSize="11" Foreground="#D4D4D8" Click="MediaNext_Click"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Sleek Segmented Player Selector Track -->
                                                <Border Background="#111216" CornerRadius="10" Padding="2" Margin="0,9,0,0" HorizontalAlignment="Left">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button x:Name="HomePlayerAutoBtn" Content="Авто" Style="{StaticResource DarkButton}" BorderThickness="0" Padding="8,2.5" FontSize="9.5" Margin="0,0,2,0" Tag="Auto" Click="BindMediaPlayer_Click"/>
                                                        <Button x:Name="HomePlayerSpotifyBtn" Content="Spotify" Style="{StaticResource DarkButton}" BorderThickness="0" Padding="8,2.5" FontSize="9.5" Margin="0,0,2,0" Tag="Spotify" Click="BindMediaPlayer_Click" ToolTip="Выбрать Spotify (повторный клик — открыть)"/>
                                                        <Button x:Name="HomePlayerSoundCloudBtn" Content="SoundCloud" Style="{StaticResource DarkButton}" BorderThickness="0" Padding="8,2.5" FontSize="9.5" Margin="0,0,2,0" Tag="SoundCloud" Click="BindMediaPlayer_Click" ToolTip="Выбрать SoundCloud (повторный клик — открыть)"/>
                                                        <Button x:Name="HomePlayerYtMusicBtn" Content="YT Music" Style="{StaticResource DarkButton}" BorderThickness="0" Padding="8,2.5" FontSize="9.5" Tag="YouTubeMusic" Click="BindMediaPlayer_Click" ToolTip="Выбрать YouTube Music (повторный клик — открыть)"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- Weather Card (Bright colored SVG weather graphics, zero black glyphs) -->
                                        <Border Grid.Column="2" Background="#18191F" BorderBrush="#252730" BorderThickness="1" CornerRadius="18" Padding="14,11" Cursor="Hand" MouseLeftButtonUp="HomeWeatherCard_Click" ToolTip="Нажмите чтобы обновить погоду (город задаётся в настройках ⚙)">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Grid x:Name="HomeWeatherIconCanvas" Width="36" Height="36" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <Ellipse x:Name="HomeSunRayRing" Width="28" Height="28" Stroke="#FBBF24" StrokeThickness="1.6" StrokeDashArray="2 2.2" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                                    <Ellipse x:Name="HomeSunCore" Width="17" Height="17" Fill="#FBBF24" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5.5,5.5,0,0"/>
                                                    <Path x:Name="HomeCloudShape" Data="M 4,15 H 18 A 3.5,3.5 0 0 0 18,8 A 4.8,4.8 0 0 0 8.5,7 A 3.8,3.8 0 0 0 4,15 Z" Fill="#E4E4E7" Width="23" Height="15" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,3"/>
                                                    <Path x:Name="HomeRainShape" Data="M 6,16 L 4.5,19 M 11,16 L 9.5,19 M 16,16 L 14.5,19" Stroke="#38BDF8" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,0" Visibility="Collapsed"/>
                                                </Grid>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="HomeWeatherTempText" Text="—°" FontSize="20" FontWeight="SemiBold" Foreground="#F4F4F5" LineHeight="22"/>
                                                    <TextBlock x:Name="HomeWeatherSubText" Text="Погода" FontSize="10.2" Foreground="#9CA3AF" MaxWidth="98" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Row 4: macOS-Style Unboxed Pure Icon Dock + Expandable Live Windows App Search ("+" like Screenshot 7) -->
                                    <Border x:Name="HomeDockContainer" Background="#18191F" BorderBrush="#252730" BorderThickness="1" CornerRadius="20" Padding="14,10">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ScrollViewer x:Name="HomeDockScrollViewer" Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                                    <StackPanel x:Name="HomeDockAppsPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                                                </ScrollViewer>
                                                <StackPanel x:Name="HomeGridContainer" Grid.Column="0" Visibility="Collapsed">
                                                    <WrapPanel x:Name="AppsWrapPanel" Orientation="Horizontal" MaxWidth="462" HorizontalAlignment="Left"/>
                                                </StackPanel>
                                                <Button x:Name="HomeAppsModeToggleBtn" Grid.Column="1" Style="{StaticResource DarkButton}" Background="Transparent" BorderThickness="0" Width="26" Height="26" Padding="0" Opacity="0.55" VerticalAlignment="Center" Margin="6,0,0,4" Click="HomeAppsModeToggleBtn_Click" ToolTip="Переключить вид: Док / Сетка">
                                                    <Path x:Name="HomeAppsModeIcon" Data="M 4,4 H 10 V 10 H 4 Z M 14,4 H 20 V 10 H 14 Z M 4,14 H 10 V 20 H 4 Z M 14,14 H 20 V 20 H 14 Z" Stroke="#A1A1AA" StrokeThickness="1.6" StrokeLineJoin="Round" Width="13" Height="13" Stretch="Uniform"/>
                                                </Button>
                                            </Grid>

                                            <!-- Inline App Search Drawer (toggled cleanly by clicking "+") -->
                                            <StackPanel x:Name="HomeAppSearchDrawer" Visibility="Collapsed" Margin="0,10,0,0">
                                                <Grid>
                                                    <TextBox x:Name="HomeAppSearchBox" Background="#1E2028" Foreground="#F4F4F5" BorderBrush="#2563EB" BorderThickness="1.8" Padding="32,7,84,7" FontSize="12" CaretBrush="#60A5FA" TextChanged="HomeAppSearchBox_TextChanged" KeyDown="HomeAppSearchBox_KeyDown">
                                                        <TextBox.Template>
                                                            <ControlTemplate TargetType="TextBox">
                                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </TextBox.Template>
                                                    </TextBox>
                                                    <Path Data="M 10,4 A 6,6 0 1 0 10,16 A 6,6 0 1 0 10,4 Z M 14.5,14.5 L 19,19" Stroke="#71717A" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False"/>
                                                    <TextBlock x:Name="HomeAppSearchPlaceholder" Text="Поиск программ (Камера, Калькулятор, cmd...)" FontSize="11.2" Foreground="#71717A" Margin="33,0,90,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                                    <Button Content="Обзор .exe" Style="{StaticResource DarkButton}" Background="#272A35" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Padding="8,3.5" FontSize="9.8" Click="BrowseCustomExeApp_Click" ToolTip="Выбрать любую программу с диска"/>
                                                </Grid>
                                                <ItemsControl x:Name="HomeAppSearchResultsList" Margin="0,9,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="3"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock x:Name="AppsEditHintText"
                                               Text="Режим правки: перетаскивайте приложения или жмите красный кружок −"
                                               FontSize="10"
                                               Foreground="#71717A"
                                               Margin="4,5,0,0"
                                               Visibility="Collapsed"/>
                                </StackPanel>

                                <!-- 2. MUSIC & AUDIO STUDIO TAB ("Музыка": Apple/Atoll Hero Player + Waveform + Seekbar + Audio Mixer) -->
                                <StackPanel x:Name="RemotePanel" Visibility="Collapsed">
                                    <!-- HERO NOW PLAYING CARD -->
                                    <Border x:Name="MediaHeroCard" BorderBrush="#262830" BorderThickness="1" CornerRadius="18" Padding="16,14" Margin="0,0,0,10">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop x:Name="MediaHeroGlowStop" Color="#2038BDF8" Offset="0"/>
                                                <GradientStop Color="#15161B" Offset="0.55"/>
                                                <GradientStop Color="#121317" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel>
                                            <!-- Top Album Art + Metadata + Live Spectrum Waveform -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Large 76x76 Rounded Album Cover -->
                                                <Border x:Name="MediaCardThumbBorder" Grid.Column="0" Width="76" Height="76" CornerRadius="14" Background="#1D1F27" BorderBrush="#2C2F3A" BorderThickness="1" Margin="0,0,13,0" ClipToBounds="True" VerticalAlignment="Center">
                                                    <Grid>
                                                        <Path x:Name="MediaCardFallbackIcon" Data="M 10,17 V 6 L 20,4 V 15 M 7.5,17 A 2.5,2.5 0 1 1 7.5,16.9 M 17.5,15 A 2.5,2.5 0 1 1 17.5,14.9" Stroke="#71717A" StrokeThickness="1.7" StrokeLineJoin="Round" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Image x:Name="MediaCardThumbImg" Stretch="UniformToFill" Visibility="Collapsed"/>
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <!-- Source Pill + Animated 6-Bar Visualizer -->
                                                    <Grid Margin="0,0,0,5">
                                                        <Border x:Name="MediaSourcePill" Background="#20222B" CornerRadius="8" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse x:Name="MediaSourceDot" Width="5.5" Height="5.5" Fill="{DynamicResource AccentBrightBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                <TextBlock x:Name="MediaSourceBadge" Text="Медиаплеер" FontSize="9.5" FontWeight="SemiBold" Foreground="#D4D4D8"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <StackPanel x:Name="RemoteEqPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Height="16" Opacity="0.85">
                                                            <Border x:Name="RemoteEqBar1" Width="2.5" Height="5" CornerRadius="1.2" Background="#38BDF8" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                            <Border x:Name="RemoteEqBar2" Width="2.5" Height="10" CornerRadius="1.2" Background="#60A5FA" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                            <Border x:Name="RemoteEqBar3" Width="2.5" Height="14" CornerRadius="1.2" Background="#818CF8" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                            <Border x:Name="RemoteEqBar4" Width="2.5" Height="9" CornerRadius="1.2" Background="#A78BFA" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                            <Border x:Name="RemoteEqBar5" Width="2.5" Height="12" CornerRadius="1.2" Background="#C084FC" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                            <Border x:Name="RemoteEqBar6" Width="2.5" Height="6" CornerRadius="1.2" Background="#E879F9" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Track Title & Artist -->
                                                    <TextBlock x:Name="MediaTitleText" Text="Ничего не играет" FontSize="15" FontWeight="SemiBold" Foreground="#F4F4F5" TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                                                    <TextBlock x:Name="MediaArtistText" Text="Выберите плеер или запустите трек" FontSize="11.5" Foreground="#A1A1AA" TextTrimming="CharacterEllipsis" MaxWidth="400" Margin="0,2,0,0"/>

                                                    <!-- Clickable Seek Bar + Timestamps -->
                                                    <Grid Margin="0,9,0,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Border x:Name="MediaProgressHost" Grid.Row="0" Height="6" CornerRadius="3" Background="#252732" Cursor="Hand" ToolTip="Нажмите для перемотки трека" MouseLeftButtonDown="MediaProgressHost_MouseDown">
                                                            <Border x:Name="MediaProgressFill" Height="6" CornerRadius="3" Width="0" HorizontalAlignment="Left" Background="#F4F4F5"/>
                                                        </Border>
                                                        <Grid Grid.Row="1" Margin="0,4,0,0">
                                                            <TextBlock x:Name="MediaElapsedText" Text="0:00" FontSize="9.5" Foreground="#71717A" HorizontalAlignment="Left"/>
                                                            <TextBlock x:Name="MediaDurationText" Text="0:00" FontSize="9.5" Foreground="#71717A" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Bottom Transport & Source Selector Bar -->
                                            <Grid Margin="0,10,0,0">
                                                <!-- Player Selector Pills -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                    <Button x:Name="PlayerAutoBtn" Content="Авто" Style="{StaticResource DarkButton}" Padding="8,3" FontSize="10" Margin="0,0,4,0" Tag="Auto" Click="BindMediaPlayer_Click"/>
                                                    <Button x:Name="PlayerSpotifyBtn" Content="Spotify" Style="{StaticResource DarkButton}" Padding="8,3" FontSize="10" Margin="0,0,4,0" Tag="Spotify" Click="BindMediaPlayer_Click" ToolTip="Spotify (повторный клик — открыть)"/>
                                                    <Button x:Name="PlayerSoundCloudBtn" Content="SoundCloud" Style="{StaticResource DarkButton}" Padding="8,3" FontSize="10" Margin="0,0,4,0" Tag="SoundCloud" Click="BindMediaPlayer_Click" ToolTip="SoundCloud (повторный клик — открыть)"/>
                                                    <Button x:Name="PlayerYtMusicBtn" Content="YT Music" Style="{StaticResource DarkButton}" Padding="8,3" FontSize="10" Margin="0,0,4,0" Tag="YouTubeMusic" Click="BindMediaPlayer_Click" ToolTip="YouTube Music (повторный клик — открыть)"/>
                                                    <Button x:Name="LaunchBoundPlayerBtn" Content="↗" Style="{StaticResource DarkButton}" Padding="7,3" FontSize="10.5" Click="LaunchBoundPlayer_Click" ToolTip="Открыть выбранный музыкальный сервис"/>
                                                </StackPanel>

                                                <!-- Apple/Atoll Transport Buttons -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <Button Style="{StaticResource DarkButton}" Background="Transparent" BorderThickness="0" Width="32" Height="32" Padding="0" Margin="0,0,6,0" Click="MediaPrev_Click" ToolTip="Предыдущий трек">
                                                        <Path Data="M 5,5 V 15 M 16,5 L 8,10 L 16,15 Z" Stroke="#E4E4E7" Fill="#E4E4E7" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="15" Height="15" Stretch="Uniform"/>
                                                    </Button>
                                                    <Button x:Name="MediaPlayPauseBtn" Width="38" Height="38" Padding="0" Margin="0,0,6,0" Cursor="Hand" Click="MediaPlayPause_Click" ToolTip="Воспроизведение / Пауза">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bd" CornerRadius="19" Background="#F4F4F5">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="#FFFFFF"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <Grid>
                                                            <Path x:Name="MediaPlayGlyph" Data="M 7,4 L 18,10 L 7,16 Z" Fill="#090A0D" Width="13" Height="13" Stretch="Uniform" Margin="2,0,0,0"/>
                                                            <Path x:Name="MediaPauseGlyph" Data="M 6,4 H 9 V 16 H 6 Z M 12,4 H 15 V 16 H 12 Z" Fill="#090A0D" Width="12" Height="12" Stretch="Uniform" Visibility="Collapsed"/>
                                                        </Grid>
                                                    </Button>
                                                    <Button Style="{StaticResource DarkButton}" Background="Transparent" BorderThickness="0" Width="32" Height="32" Padding="0" Click="MediaNext_Click" ToolTip="Следующий трек">
                                                        <Path Data="M 15,5 V 15 M 4,5 L 12,10 L 4,15 Z" Stroke="#E4E4E7" Fill="#E4E4E7" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="15" Height="15" Stretch="Uniform"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- AUDIO OUTPUT, VOLUME & PER-APP MIXER -->
                                    <Border Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,7">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="M 3,9 H 7 L 12,5 V 19 L 7,15 H 3 Z M 15.5,8.5 A 5,5 0 0 1 15.5,15.5" Stroke="#A1A1AA" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="15" Height="15" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="VolumePercentText" Text="Громкость · —%" FontSize="11.5" FontWeight="SemiBold" Foreground="#F4F4F5" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button x:Name="GameAudioBindBtn" Content="🎮 Автозвук" Style="{StaticResource DarkButton}" Background="#1F2028" BorderThickness="0" Padding="8,3" FontSize="10" Margin="0,0,4,0" Click="BindGameAudioDevice_Click" Visibility="Collapsed" ToolTip="Закрепить аудио-устройство за игрой"/>
                                                    <Button x:Name="AudioSwitchBtn" Content="🎧 Вывод" Style="{StaticResource DarkButton}" Background="#1F2028" BorderThickness="0" Padding="9,3.5" FontSize="10" Margin="0,0,4,0" Click="SwitchAudioOutput_Click" ToolTip="Переключить устройство вывода"/>
                                                    <Button x:Name="ToggleAppMixerBtn" Content="Микшер ▾" Style="{StaticResource DarkButton}" Background="#1F2028" BorderThickness="0" Padding="9,3.5" FontSize="10" Click="ToggleAppMixer_Click" ToolTip="Громкость по программам"/>
                                                </StackPanel>
                                            </Grid>
                                            <Slider x:Name="MasterVolumeSlider" Minimum="0" Maximum="100" ValueChanged="MasterVolumeSlider_ValueChanged" IsMoveToPointEnabled="True"/>
                                            <ItemsControl x:Name="AppMixerList" Visibility="Collapsed" Margin="0,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="105"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding ProcessName}" FontSize="10.5" Foreground="#D4D4D8" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding VolumePercent, Mode=TwoWay}" Tag="{Binding Pid}" ValueChanged="AppSessionSlider_ValueChanged" IsMoveToPointEnabled="True" VerticalAlignment="Center" Margin="6,0"/>
                                                            <Button Grid.Column="2" Content="{Binding MuteGlyph}" Style="{StaticResource DarkButton}" Background="#1F2028" BorderThickness="0" Padding="6,2" FontSize="10" Tag="{Binding Pid}" Click="AppSessionMute_Click"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- QUICK AUDIO & DISPLAY ROW -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="14" Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="MicMuteBtn" Grid.Column="0" Content="🎙 Мик: Вкл" Style="{StaticResource DarkButton}" Background="#1F2028" BorderThickness="0" Padding="6,5" FontSize="10.2" Click="ToggleMicMute_Click"/>
                                                <Button x:Name="StreamShieldBtn" Grid.Column="2" Content="🛡 Щит: Выкл" Style="{StaticResource DarkButton}" Background="#1F2028" BorderThickness="0" Padding="6,5" FontSize="10" Click="ToggleStreamShield_Click" ToolTip="Скрывать треки и превью при записи"/>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="2" Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="14" Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="BrightnessLabelText" Grid.Column="0" Text="☀ 80%" FontSize="10.5" Foreground="#D4D4D8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="80" VerticalAlignment="Center" IsMoveToPointEnabled="True" ValueChanged="BrightnessSlider_ValueChanged"/>
                                                <Button Grid.Column="2" Content="Ночь" Style="{StaticResource DarkButton}" Background="#1F2028" BorderThickness="0" Padding="7,3" FontSize="9.8" Margin="8,0,0,0" Click="NightLightBtn_Click" ToolTip="Ночной свет Windows"/>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- COLLAPSIBLE SLEEP TIMER, POWER & RECORDINGS -->
                                    <Button x:Name="RemoteExtrasToggleBtn" Content="Таймер сна, питание и записи ▾" Style="{StaticResource DarkButton}" Background="#15161A" BorderBrush="#24252C" HorizontalAlignment="Stretch" Padding="10,7" FontSize="10.5" Foreground="#A1A1AA" Click="RemoteExtrasToggle_Click"/>

                                    <StackPanel x:Name="RemoteExtrasSection" Visibility="Collapsed" Margin="0,8,0,0">
                                        <!-- Night Auto-Sleep / Shutdown Timer -->
                                        <Border Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="12" Padding="11,8" Margin="0,0,0,7">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🌙 Авто-стоп ПК:" FontSize="11" FontWeight="SemiBold" Foreground="#E4E4E7" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TimerStatusText" Text="Выкл." FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrightBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button x:Name="TimerActionModeBtn" Content="💤 Сон" Style="{StaticResource DarkButton}" Padding="7,3" FontSize="10" Margin="0,0,4,0" Click="TimerActionMode_Click"/>
                                                    <Button Content="30м" Style="{StaticResource DarkButton}" Padding="7,3" FontSize="10" Margin="0,0,4,0" Tag="30" Click="StartTimerPreset_Click"/>
                                                    <Button Content="60м" Style="{StaticResource AccentButton}" Padding="7,3" FontSize="10" Margin="0,0,4,0" Tag="60" Click="StartTimerPreset_Click"/>
                                                    <Button Content="120м" Style="{StaticResource DarkButton}" Padding="7,3" FontSize="10" Margin="0,0,4,0" Tag="120" Click="StartTimerPreset_Click"/>
                                                    <Button Content="Стоп" Style="{StaticResource DarkButton}" Padding="7,3" FontSize="10" Click="StopTimer_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Screen Recording + Power Mode & Folders -->
                                        <Border Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="12" Padding="11,8">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,5">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button x:Name="ScreenRecordBtn" Content="🔴 Запись экрана" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="10.8" FontWeight="SemiBold" Margin="0,0,5,0" Click="ToggleScreenRecord_Click"/>
                                                        <Button x:Name="RecordMonitorBtn" Content="🖥 Экран 1" Style="{StaticResource DarkButton}" Padding="8,4" FontSize="10.2" Visibility="Collapsed" Click="CycleRecordMonitor_Click"/>
                                                        <Button x:Name="PowerModeBtn" Style="{StaticResource DarkButton}" Padding="8,4" FontSize="10.2" Margin="5,0,0,0" Click="TogglePowerMode_Click">
                                                            <TextBlock x:Name="PowerModeLabelText" Text="⚡ Питание"/>
                                                        </Button>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button Content="📁 Видео" Style="{StaticResource DarkButton}" Padding="7,4" FontSize="10" Margin="0,0,4,0" Click="OpenRecordingsFolder_Click"/>
                                                        <Button Content="📁 Клипы" Style="{StaticResource DarkButton}" Padding="7,4" FontSize="10" Click="OpenReplayClipsFolder_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock x:Name="RecordSaveHintText" Text="Запись → Видео\DesktopIsland · 30с клип → Видео\Captures" FontSize="9.3" Foreground="#71717A" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- 2B. UTILITIES TAB ("Буфер": Калькулятор/Валюта + QR-код + Полка файлов + Буфер обмена) -->
                                <StackPanel x:Name="UtilsPanel" Visibility="Collapsed">
                                    <!-- Quick Calculator / Currency Converter -->
                                    <Border Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="14" Padding="12,10" Margin="0,0,0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="QuickCalcBox"
                                                     Grid.Column="0"
                                                     Background="#0E0F16"
                                                     Foreground="#F8FAFC"
                                                     BorderBrush="#292D42"
                                                     BorderThickness="1"
                                                     Padding="8,4"
                                                     FontSize="11"
                                                     CaretBrush="#38BDF8"
                                                     TextChanged="QuickCalcBox_TextChanged"
                                                     ToolTip="Введите пример (1250*0.85) или сумму с валютой (49$ / 120 EUR in UAH)"/>
                                            <TextBlock x:Name="QuickCalcPlaceholder"
                                                       Grid.Column="0"
                                                       Text="1250*0.85 или 49$ → конвертер..."
                                                       FontSize="10.5"
                                                       Foreground="#64748B"
                                                       Margin="9,0,0,0"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False"/>
                                            <TextBlock x:Name="QuickCalcResultText" Grid.Column="1" Text="" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrightBrush}" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            <Button x:Name="CopyCalcResultBtn" Grid.Column="2" Content="📋" Style="{StaticResource DarkButton}" Padding="6,3" FontSize="10.5" Margin="6,0,0,0" Visibility="Collapsed" Click="CopyCalcResult_Click" ToolTip="Скопировать результат"/>
                                        </Grid>
                                    </Border>

                                    <!-- Instant QR Code Preview Card -->
                                    <Border x:Name="QrCodeCard" Background="#15161A" BorderBrush="{DynamicResource AccentBrightBrush}" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,0,0,7" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#FFFFFF" CornerRadius="8" Padding="4" Margin="0,0,10,0">
                                                <Image x:Name="QrPreviewImage" Width="96" Height="96" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="QR-код для телефона" FontSize="11.5" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                                <TextBlock x:Name="QrSourceText" Text="" FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap" MaxHeight="52" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="✕" VerticalAlignment="Top" Style="{StaticResource DarkButton}" Padding="6,2" FontSize="10" Click="CloseQrCard_Click"/>
                                        </Grid>
                                    </Border>

                                    <!-- Drag & Drop File Shelf -->
                                    <Border Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="14" Padding="12,10" Margin="0,0,0,9">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="📎 Полка файлов (Drag &amp; Drop сюда или наружу)" FontSize="10.5" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                                <Button x:Name="ClearShelfBtn" Content="Очистить" HorizontalAlignment="Right" Style="{StaticResource DarkButton}" Padding="6,2" FontSize="9.5" Click="ClearDropShelf_Click" Visibility="Collapsed"/>
                                            </Grid>
                                            <TextBlock x:Name="DropShelfEmptyText" Text="Перетащите любой файл или картинку прямо на островок, чтобы потом вытащить в Telegram / Discord" FontSize="10" Foreground="#64748B" TextWrapping="Wrap"/>
                                            <ItemsControl x:Name="DropShelfList">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#1F2233" CornerRadius="8" Padding="7,4" Margin="0,2,5,2" Cursor="Hand" Tag="{Binding}" PreviewMouseLeftButtonDown="ShelfItem_MouseDown" PreviewMouseMove="ShelfItem_MouseMove" ToolTip="Потяните в приложение или нажмите Открыть">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding IconGlyph}" FontSize="11" Margin="0,0,4,0"/>
                                                                <TextBlock Text="{Binding Name}" FontSize="10.5" Foreground="#E2E8F0" MaxWidth="115" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                <Button Content="✕" Style="{StaticResource DarkButton}" Background="Transparent" Padding="4,0" FontSize="9.5" Margin="4,0,0,0" Tag="{Binding}" Click="RemoveShelfItem_Click"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Smart Clipboard History & Pinned Notes -->
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Умный буфер и заметки" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="📱 QR буфера" Style="{StaticResource DarkButton}" Padding="7,2" FontSize="9.8" Margin="0,0,4,0" Click="QrFromClipboard_Click" ToolTip="Показать QR-код из текущего буфера обмена"/>
                                            <Button Content="🧹 Без стилей" Style="{StaticResource DarkButton}" Padding="7,2" FontSize="9.8" Margin="0,0,4,0" Click="CleanClipboardFormatting_Click" ToolTip="Очистить форматирование текста в буфере"/>
                                            <Button Content="Очистить" Style="{StaticResource DarkButton}" Padding="7,2" FontSize="9.8" Click="ClearClipboardHistory_Click"/>
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl x:Name="ClipboardHistoryList" MaxHeight="205">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#15161A" CornerRadius="8" Padding="8,5" Margin="0,0,0,3">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0" Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="ClipboardItemCopy_Click" ToolTip="Нажмите чтобы скопировать">
                                                            <TextBlock Text="{Binding Preview}" FontSize="10.8" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding TimeLabel}" FontSize="9" Foreground="#64748B"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="📱" Style="{StaticResource DarkButton}" Padding="5,2" FontSize="10" Margin="0,0,3,0" Tag="{Binding}" Click="ClipboardItemQr_Click" ToolTip="QR-код"/>
                                                            <Button Content="📌" Style="{StaticResource DarkButton}" Padding="5,2" FontSize="10" Tag="{Binding}" Click="ClipboardItemPin_Click" ToolTip="Закрепить / Открепить"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- 3. SYSTEM TAB (Atoll Control Center + 3 Live Graphs + Discord/DND + Mic/Battery + Details Drawer) -->
                                <StackPanel x:Name="SystemPanel" Visibility="Collapsed">
                                    <!-- ПУНКТ УПРАВЛЕНИЯ -->
                                    <Border Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="14" Padding="12,10" Margin="0,0,0,9">
                                        <StackPanel>
                                            <TextBlock Text="ПУНКТ УПРАВЛЕНИЯ" FontSize="9.5" FontWeight="SemiBold" Foreground="#71717A" Margin="2,0,0,9"/>

                                            <!-- 5 Circular Control Toggles -->
                                            <UniformGrid Columns="5" Margin="0,0,0,10">
                                                <Button x:Name="CtrlWifiBtn" Style="{StaticResource AtollUnboxedBtn}" Click="CtrlWifi_Click" ToolTip="Включить / выключить Wi-Fi (или открыть сеть)">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <Border x:Name="CtrlWifiCircle" Width="38" Height="38" CornerRadius="19" Background="#252730" Margin="0,0,0,5">
                                                            <Viewbox Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Canvas Width="24" Height="24">
                                                                    <Path Data="M 2,9 A 15,15 0 0 1 22,9 M 5.5,13 A 10,10 0 0 1 18.5,13 M 9,16.5 A 5,5 0 0 1 15,16.5" Stroke="#F4F4F5" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                                    <Ellipse Canvas.Left="10.7" Canvas.Top="19" Width="2.6" Height="2.6" Fill="#F4F4F5"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Border>
                                                        <TextBlock x:Name="CtrlWifiLabel" Text="Wi-Fi" FontSize="10" Foreground="#D4D4D8" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button x:Name="CtrlBtBtn" Style="{StaticResource AtollUnboxedBtn}" Click="ToggleBluetooth_Click" ToolTip="Включить / выключить Bluetooth">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <Border x:Name="CtrlBtCircle" Width="38" Height="38" CornerRadius="19" Background="#252730" Margin="0,0,0,5">
                                                            <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Canvas Width="24" Height="24">
                                                                    <Path Data="M 7,7 L 17,16.5 L 12,21 V 3 L 17,7.5 L 7,17" Stroke="#F4F4F5" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Border>
                                                        <TextBlock x:Name="CtrlBtLabel" Text="Bluetooth" FontSize="10" Foreground="#D4D4D8" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button x:Name="CtrlAirplaneBtn" Style="{StaticResource AtollUnboxedBtn}" Click="CtrlAirplane_Click" ToolTip="Режим полёта Windows">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <Border x:Name="CtrlAirplaneCircle" Width="38" Height="38" CornerRadius="19" Background="#252730" Margin="0,0,0,5">
                                                            <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Canvas Width="24" Height="24">
                                                                    <Path Data="M 21,16 V 14 L 13,9 V 3.5 A 1.5,1.5 0 0 0 10,3.5 V 9 L 2,14 V 16 L 10,13.5 V 19 L 8,20.5 V 22 L 11.5,21 L 15,22 V 20.5 L 13,19 V 13.5 Z" Fill="#D4D4D8"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Border>
                                                        <TextBlock x:Name="CtrlAirplaneLabel" Text="Полёт" FontSize="10" Foreground="#D4D4D8" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button x:Name="CtrlVpnBtn" Style="{StaticResource AtollUnboxedBtn}" Click="CtrlVpn_Click" ToolTip="Быстрый статус и запуск VPN">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <Border x:Name="CtrlVpnCircle" Width="38" Height="38" CornerRadius="19" Background="#252730" Margin="0,0,0,5">
                                                            <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Canvas Width="24" Height="24">
                                                                    <Path Data="M 12,3 L 19,6 V 12 C 19,16.5 15.8,19.8 12,21 C 8.2,19.8 5,16.5 5,12 V 6 Z" Stroke="#F4F4F5" StrokeThickness="2" StrokeLineJoin="Round"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Border>
                                                        <TextBlock x:Name="CtrlVpnLabel" Text="VPN" FontSize="10" Foreground="#D4D4D8" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button x:Name="CtrlDesktopBtn" Style="{StaticResource AtollUnboxedBtn}" Click="CtrlDesktop_Click" ToolTip="Скрыть / показать иконки рабочего стола">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <Border x:Name="CtrlDesktopCircle" Width="38" Height="38" CornerRadius="19" Background="#252730" Margin="0,0,0,5">
                                                            <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Canvas Width="24" Height="24">
                                                                    <Path Data="M 2,12 C 5,6.5 9,4.5 12,4.5 C 15,4.5 19,6.5 22,12 C 19,17.5 15,19.5 12,19.5 C 9,19.5 5,17.5 2,12 Z M 3,3 L 21,21" Stroke="#D4D4D8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Border>
                                                        <TextBlock Text="Чистый стол" FontSize="9.8" Foreground="#D4D4D8" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </UniformGrid>

                                            <!-- Action Pills Row (Lock / Sleep / Reboot / Shutdown / Clip / Record / RAM Boost) -->
                                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="🔒 Блок" Style="{StaticResource DarkButton}" Background="#1F2028" BorderThickness="0" Padding="9,4.5" FontSize="10" Margin="0,0,5,5" Click="LockPc_Click" ToolTip="Заблокировать ПК"/>
                                                <Button Content="🌙 Сон" Style="{StaticResource DarkButton}" Background="#1F2028" BorderThickness="0" Padding="9,4.5" FontSize="10" Margin="0,0,5,5" Click="SleepPc_Click" ToolTip="Спящий режим"/>
                                                <Button Content="↻ Перезагрузка" Style="{StaticResource DarkButton}" Background="#1F2028" BorderThickness="0" Padding="9,4.5" FontSize="10" Margin="0,0,5,5" Click="RebootPc_Click" ToolTip="Перезагрузить ПК"/>
                                                <Button Content="⏻ Выкл" Style="{StaticResource DarkButton}" Background="#29171B" BorderBrush="#4C1D24" Foreground="#FCA5A5" Padding="9,4.5" FontSize="10" Margin="0,0,5,5" Click="ShutdownPc_Click" ToolTip="Выключить ПК"/>
                                                <Button Content="🎬 Клип 30с" Style="{StaticResource DarkButton}" Background="#1F2028" BorderThickness="0" Padding="9,4.5" FontSize="10" Margin="0,0,5,5" Click="ReplayClipBtn_Click" ToolTip="Сохранить последние 30с"/>
                                                <Button Content="🔴 Запись" Style="{StaticResource DarkButton}" Background="#1F2028" BorderThickness="0" Padding="9,4.5" FontSize="10" Margin="0,0,5,5" Click="ToggleScreenRecord_Click" ToolTip="Начать / остановить запись экрана"/>
                                                <Button Content="⚡ Буст ОЗУ" Style="{StaticResource DarkButton}" Background="#1D261F" BorderBrush="#2D4A33" Foreground="#86EFAC" Padding="9,4.5" FontSize="10" Margin="0,0,0,5" Click="OptimizeRam_Click" ToolTip="Быстрая оптимизация ОЗУ"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- 3 Live Telemetry Sparkline Cards: CPU / GPU / RAM -->
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="7"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="7"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- CPU CARD -->
                                        <Border Grid.Column="0" Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="14" Padding="11,9">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,3">
                                                    <TextBlock Text="ПРОЦЕССОР" FontSize="9.2" FontWeight="SemiBold" Foreground="#71717A" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="CpuValText" Text="0%" FontSize="14.5" FontWeight="Bold" Foreground="#F4F4F5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBlock x:Name="FpsDetailText" Text="0 FPS" FontSize="9.8" Foreground="#8E9099" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                                <Canvas Height="38" ClipToBounds="True" Margin="0,0,0,6">
                                                    <Polygon x:Name="CpuSparkPolygon" Fill="#2838BDF8"/>
                                                    <Polyline x:Name="CpuSparkline" Stroke="#38BDF8" StrokeThickness="1.8"/>
                                                </Canvas>
                                                <Border x:Name="CpuLoadBarHost" Height="3.5" CornerRadius="1.8" Background="#23242B">
                                                    <Border x:Name="CpuLoadBarFill" Height="3.5" CornerRadius="1.8" Width="0" HorizontalAlignment="Left" Background="#38BDF8"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- GPU CARD -->
                                        <Border Grid.Column="2" Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="14" Padding="11,9">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,3">
                                                    <TextBlock x:Name="SysGpuNameText" Text="ВИДЕОКАРТА" FontSize="9.2" FontWeight="SemiBold" Foreground="#71717A" MaxWidth="92" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="GpuCardValText" Text="—%" FontSize="14.5" FontWeight="Bold" Foreground="#F4F4F5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBlock x:Name="GpuDetailText" Text="—" FontSize="9.8" Foreground="#8E9099" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                                <Canvas Height="38" ClipToBounds="True" Margin="0,0,0,6">
                                                    <Polygon x:Name="GpuSparkPolygon" Fill="#28C084FC"/>
                                                    <Polyline x:Name="GpuSparkline" Stroke="#C084FC" StrokeThickness="1.8"/>
                                                </Canvas>
                                                <Border x:Name="GpuLoadBarHost" Height="3.5" CornerRadius="1.8" Background="#23242B">
                                                    <Border x:Name="GpuLoadBarFill" Height="3.5" CornerRadius="1.8" Width="0" HorizontalAlignment="Left" Background="#C084FC"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- RAM CARD -->
                                        <Border Grid.Column="4" Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="14" Padding="11,9">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,3">
                                                    <TextBlock Text="ПАМЯТЬ" FontSize="9.2" FontWeight="SemiBold" Foreground="#71717A" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="RamValText" Text="0%" FontSize="14.5" FontWeight="Bold" Foreground="#F4F4F5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBlock x:Name="RamSubText" Text="0 / 0 ГБ" FontSize="9.8" Foreground="#8E9099" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                                <Canvas Height="38" ClipToBounds="True" Margin="0,0,0,6">
                                                    <Polygon x:Name="RamSparkPolygon" Fill="#2834D399"/>
                                                    <Polyline x:Name="RamSparkline" Stroke="#34D399" StrokeThickness="1.8"/>
                                                </Canvas>
                                                <Border x:Name="RamLoadBarHost" Height="3.5" CornerRadius="1.8" Background="#23242B">
                                                    <Border x:Name="RamLoadBarFill" Height="3.5" CornerRadius="1.8" Width="0" HorizontalAlignment="Left" Background="#34D399"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Row 3: Discord & Sound + Do Not Disturb Timer -->
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="14" Padding="12,10">
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Discord и звук" FontSize="12" FontWeight="SemiBold" Foreground="#F4F4F5"/>
                                                    <TextBlock x:Name="DiscordStatusText" Text="Проверка..." FontSize="10.2" Foreground="#8E9099" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Button Content="Микшер →" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource DarkButton}" Background="#1F2028" BorderThickness="0" Padding="8,4" FontSize="10" Click="JumpToAudioMixer_Click"/>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="2" Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="14" Padding="12,9">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="НЕ БЕСПОКОИТЬ" FontSize="9.2" FontWeight="SemiBold" Foreground="#71717A" VerticalAlignment="Center"/>
                                                    <Button x:Name="DndToggleBtn" HorizontalAlignment="Right" Style="{StaticResource DarkButton}" Padding="7,2" FontSize="9.8" Click="ToggleDnd_Click" ToolTip="Переключить режим Не беспокоить Windows">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="DndIconText" Text="🔔" FontSize="9.5" Margin="0,0,4,0"/>
                                                            <TextBlock x:Name="DndLabelText" Text="Выкл" FontSize="9.8"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                                <WrapPanel Orientation="Horizontal">
                                                    <Button Content="30 мин" Style="{StaticResource DarkButton}" Background="#1F2028" BorderThickness="0" Padding="7,3.5" FontSize="9.8" Margin="0,0,4,0" Tag="30" Click="SetDndMinutes_Click"/>
                                                    <Button Content="1 ч" Style="{StaticResource DarkButton}" Background="#1F2028" BorderThickness="0" Padding="7,3.5" FontSize="9.8" Margin="0,0,4,0" Tag="60" Click="SetDndMinutes_Click"/>
                                                    <Button Content="2 ч" Style="{StaticResource DarkButton}" Background="#1F2028" BorderThickness="0" Padding="7,3.5" FontSize="9.8" Margin="0,0,4,0" Tag="120" Click="SetDndMinutes_Click"/>
                                                    <Button Content="Выкл" Style="{StaticResource DarkButton}" Background="#1F2028" BorderThickness="0" Padding="7,3.5" FontSize="9.8" Tag="0" Click="SetDndMinutes_Click"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Row 4: Mic & Camera Privacy + Device Batteries -->
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="14" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="МИКРОФОН И КАМЕРА СЕЙЧАС" FontSize="9" FontWeight="SemiBold" Foreground="#71717A" Margin="0,0,0,4"/>
                                                <TextBlock x:Name="PrivacyStatusText" Text="Камера и мик свободны" FontSize="11.5" FontWeight="SemiBold" Foreground="#D4D4D8" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="SysPrivacySubText" Text="Активных обращений нет" FontSize="10" Foreground="#71717A" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="14" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="ЗАРЯД УСТРОЙСТВ" FontSize="9" FontWeight="SemiBold" Foreground="#71717A" Margin="0,0,0,4"/>
                                                <TextBlock x:Name="SysBatterySummaryText" Text="Bluetooth-устройства не подключены" FontSize="11" Foreground="#A1A1AA" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Collapsible Full Details Drawer (Bluetooth Devices, Network, Top-3 RAM, Drives, Recent Downloads) -->
                                    <Button x:Name="SystemDetailsToggleBtn" Content="Диски, Bluetooth, сеть и процессы ▾" Style="{StaticResource DarkButton}" Background="#15161A" BorderBrush="#24252C" HorizontalAlignment="Stretch" Padding="10,7" FontSize="10.8" Foreground="#A1A1AA" Click="SystemDetailsToggle_Click"/>

                                    <StackPanel x:Name="SystemDetailsSection" Visibility="Collapsed" Margin="0,8,0,0">
                                        <!-- Bluetooth Control & Devices -->
                                        <Border Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,0,0,7">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,5">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Bluetooth" FontSize="11.5" FontWeight="SemiBold" Foreground="#F4F4F5" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="BtStateText" Text="· проверка..." FontSize="10.5" Foreground="#8E9099" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button x:Name="BtExpandBtn" Content="Все ▾" Style="{StaticResource DarkButton}" Padding="7,3" FontSize="10" Margin="0,0,4,0" Click="BtExpandBtn_Click"/>
                                                        <Button x:Name="BtToggleBtn" Content="Вкл / Выкл" Style="{StaticResource DarkButton}" Padding="8,3" FontSize="10.5" Margin="0,0,4,0" Click="ToggleBluetooth_Click"/>
                                                        <Button Content="⚙" Style="{StaticResource DarkButton}" Padding="7,3" FontSize="10.5" ToolTip="Параметры Bluetooth" Click="OpenBtSettings_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                                <ItemsControl x:Name="BtDevicesList">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#1D1E24" CornerRadius="8" Padding="8,4.5" Margin="0,0,0,4">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Medium" Foreground="#F4F4F5" TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="{Binding StatusLabel}" FontSize="9.8" Foreground="#8E9099"/>
                                                                    </StackPanel>
                                                                    <Button Grid.Column="1" Content="{Binding ActionLabel}" Style="{StaticResource DarkButton}" Padding="8,3" FontSize="10" Tag="{Binding}" Click="BtDeviceAction_Click"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock x:Name="BtEmptyText" Text="Сопряжённые Bluetooth-устройства не найдены" FontSize="10" Foreground="#71717A" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,2"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Network Speed & Ping -->
                                        <Border Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="12" Padding="10,7" Margin="0,0,0,7">
                                            <Grid>
                                                <Polyline x:Name="NetSparkline" Stroke="#34D399" StrokeThickness="1.5" Opacity="0.4" VerticalAlignment="Bottom" HorizontalAlignment="Right" Height="22" Width="110"/>
                                                <StackPanel>
                                                    <TextBlock x:Name="PingHeaderLabel" Text="Сеть · Ping" FontSize="10" Foreground="#71717A"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock x:Name="NetDownText" Text="↓ 0 КБ/с" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrightBrush}" Margin="0,0,12,0"/>
                                                        <TextBlock x:Name="NetUpText" Text="↑ 0 КБ/с" FontSize="11" Foreground="#A1A1AA"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Top 3 Heavy Processes -->
                                        <TextBlock Text="Топ-3 процесса по ОЗУ (быстрое завершение)" FontSize="10.2" Foreground="#71717A" Margin="2,0,0,4"/>
                                        <ItemsControl x:Name="TopProcessesList" Margin="0,0,0,6">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="0,0,0,3">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Medium" Foreground="#E4E4E7" MaxWidth="250" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding MemoryFormatted}" FontSize="11" Foreground="#8E9099" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                <Button Content="✕" Style="{StaticResource DarkButton}" Background="#3A1D24" Foreground="#FCA5A5" Padding="6,1" FontSize="10" Tag="{Binding}" Click="KillProcess_Click" ToolTip="Завершить процесс"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Local Drives -->
                                        <TextBlock Text="Локальные диски" FontSize="10.2" Foreground="#71717A" Margin="2,2,0,4"/>
                                        <ItemsControl x:Name="DrivesItemsControl" Margin="0,0,0,6">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="8" Padding="9,6" Margin="0,0,0,4">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="4"/>
                                                            </Grid.RowDefinitions>
                                                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11.5" Foreground="#F4F4F5"/>
                                                                    <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#71717A" Margin="6,0,0,0"/>
                                                                </StackPanel>
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                    <TextBlock FontSize="10.5" Foreground="#8E9099" Margin="0,0,7,0" VerticalAlignment="Center">
                                                                        <Run Text="Свободно "/>
                                                                        <Run Text="{Binding FreeGb, StringFormat={}{0:F1}}" Foreground="#F4F4F5" FontWeight="SemiBold"/>
                                                                        <Run Text=" ГБ"/>
                                                                    </TextBlock>
                                                                    <Button Content="Открыть" Padding="7,2" FontSize="10" Style="{StaticResource DarkButton}" Tag="{Binding RootPath}" Click="OpenDrive_Click"/>
                                                                </StackPanel>
                                                            </Grid>
                                                            <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding UsedPercent}" Height="4" Foreground="{DynamicResource AccentBrush}" Background="#24252C" BorderThickness="0"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Recent Downloads -->
                                        <TextBlock Text="Недавние загрузки" FontSize="10.2" Foreground="#71717A" Margin="2,2,0,4"/>
                                        <ItemsControl x:Name="RecentDownloadsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource DarkButton}" Background="#15161A" BorderBrush="#24252C" HorizontalContentAlignment="Stretch" Padding="9,5" Margin="0,0,0,3" Tag="{Binding FullPath}" Click="OpenRecentFile_Click" ToolTip="Открыть файл">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11" Foreground="#E4E4E7" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" FontSize="10" Foreground="#8E9099" VerticalAlignment="Center">
                                                                <Run Text="{Binding SizeFormatted}"/>
                                                                <Run Text=" · "/>
                                                                <Run Text="{Binding TimeLabel}"/>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>

                                <!-- 3B. SCREEN TIME & GAME SESSION TAB -->
                                <StackPanel x:Name="ScreenTimePanel" Visibility="Collapsed">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="10" Padding="10,7">
                                            <StackPanel>
                                                <TextBlock Text="За сессию островка" FontSize="10" Foreground="#64748B"/>
                                                <TextBlock x:Name="ScreenTimeTotalText" Text="0с" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                <TextBlock x:Name="ScreenTimeAppsCountText" Text="Программ: 0" FontSize="10" Foreground="#94A3B8"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="10" Padding="10,7">
                                            <StackPanel>
                                                <TextBlock Text="Игры за сессию" FontSize="10" Foreground="#64748B"/>
                                                <TextBlock x:Name="ScreenTimeGamesTotalText" Text="0с" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrightBrush}"/>
                                                <TextBlock x:Name="ScreenTimeLastGameText" Text="Игр не было" FontSize="10" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="10" Padding="9,7" Margin="0,0,0,8">
                                        <Grid>
                                            <TextBlock x:Name="GameStatsDetailText" Text="Полноэкранная игра в этой сессии пока не запускалась" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                                            <WrapPanel x:Name="GameStatsBadgesPanel" Orientation="Horizontal" Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="Активные программы и игры (за сессию)" FontSize="10.5" Foreground="#64748B" Margin="2,0,0,5"/>
                                    <ItemsControl x:Name="ScreenTimeListControl" Margin="0,0,0,8">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#15161A" CornerRadius="8" Padding="9,6" Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="4"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding IconLabel}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding ProcessName}" FontSize="11" FontWeight="Medium" Foreground="#E2E8F0" MaxWidth="215" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding SubLabel}" FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding SharePercent}" Height="4" Foreground="{DynamicResource AccentBrush}" Background="#24252C" BorderThickness="0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock x:Name="ScreenTimeEmptyText" Text="Пока нет данных об активных окнах" FontSize="11" Foreground="#64748B" Margin="2,2,0,6" Visibility="Visible"/>

                                    <Grid>
                                        <TextBlock Text="Считается активное окно на экране" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <Button Content="Сбросить" Style="{StaticResource DarkButton}" Padding="10,4" FontSize="10.5" HorizontalAlignment="Right" Click="ResetScreenTime_Click"/>
                                    </Grid>
                                </StackPanel>

                                <!-- 5. CLEANER & RAM TAB -->
                                <StackPanel x:Name="CleanerPanel" Visibility="Collapsed">
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Безопасная очистка (браузеры и пароли не трогаются)" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <Button Content="Обновить" Style="{StaticResource DarkButton}" Padding="8,2.5" FontSize="10.5" HorizontalAlignment="Right" Click="RefreshCleanup_Click"/>
                                    </Grid>
                                    <ItemsControl x:Name="CleanupItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#15161A" CornerRadius="8" Padding="9,5" Margin="0,0,0,4">
                                                    <Grid>
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="Medium" Foreground="#E2E8F0"/>
                                                                <TextBlock Text="{Binding Description}" FontSize="9.8" Foreground="#64748B" TextTrimming="CharacterEllipsis" MaxWidth="310"/>
                                                            </StackPanel>
                                                        </CheckBox>
                                                        <TextBlock Text="{Binding SizeFormatted}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrightBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid Margin="0,9,0,0">
                                        <TextBlock x:Name="CleanupStatusText" Text="Нажмите «Очистить»" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" MaxWidth="210" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="CleanNowBtn" Content="Удалить файлы" Style="{StaticResource AccentButton}" Padding="11,6" Margin="0,0,5,0" Click="CleanNow_Click"/>
                                            <Button x:Name="OptimizeRamBtn" Content="⚡ ОЗУ" Style="{StaticResource DarkButton}" Padding="10,6" Click="OptimizeRam_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Border>

            <!-- QUICK ACTION PILLS ROW (Hidden: single clean main island only) -->
            <StackPanel x:Name="SideActionStrip"
                        Orientation="Horizontal"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed"
                        MouseEnter="SideActionStrip_MouseEnter"
                        MouseLeave="IslandHoverZone_MouseLeave">
            <!-- INDEPENDENT RIGHT-SIDE RAM CIRCLE / PILL (Visible normally, hidden in idle eyes mode) -->
            <Border x:Name="RamQuickPill"
                    Height="36"
                    Width="36"
                    CornerRadius="18"
                    Margin="6,2,0,0"
                    VerticalAlignment="Top"
                    Background="#FC090A0D"
                    BorderBrush="#24252C"
                    BorderThickness="1"
                    ClipToBounds="True"
                    Cursor="Hand"
                    MouseLeftButtonUp="RamQuickPill_Click"
                    MouseEnter="RamQuickPill_MouseEnter"
                    MouseLeave="RamQuickPill_MouseLeave">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0">
                    <Path x:Name="RamLightningPath"
                          Width="13"
                          Height="15"
                          Stretch="Uniform"
                          Stroke="Transparent"
                          StrokeThickness="1.2"
                          StrokeLineJoin="Round"
                          Data="M 8,0 L 1,9 L 6.5,9 L 5,16 L 13,6.5 L 7.5,6.5 Z"
                          VerticalAlignment="Center">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                                <GradientStop x:Name="LightningFillStop1" Color="#FACC15" Offset="0.0"/>
                                <GradientStop x:Name="LightningFillStop2" Color="#64748B" Offset="0.0"/>
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                    <TextBlock x:Name="RamQuickText"
                               Text="ОЗУ"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="#E2E8F0"
                               Margin="5,0,0,0"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- QUICK MIC MUTE PILL (Visible when expanded or in fullscreen games, flush notch style) -->
            <Border x:Name="GameMicPill"
                    Height="30"
                    Width="30"
                    CornerRadius="0,0,15,15"
                    Margin="5,0,0,0"
                    VerticalAlignment="Top"
                    Background="#FC090A0D"
                    BorderBrush="#24252C"
                    BorderThickness="1,0,1,1"
                    Visibility="Collapsed"
                    Cursor="Hand"
                    ToolTip="Быстрый Mute микрофона (удерживайте Alt + клик в игре)"
                    MouseLeftButtonUp="GameMicPill_Click"
                    MouseEnter="GameMicPill_MouseEnter"
                    MouseLeave="GameMicPill_MouseLeave">
                <Viewbox x:Name="GameMicViewbox" Width="9.5" Height="9.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Data="M12,2 A3,3 0 0 1 15,5 V11 A3,3 0 0 1 9,11 V5 A3,3 0 0 1 12,2 Z"
                              x:Name="MicCapsulePath" Fill="#E2E8F0"/>
                        <Path Data="M6,10 A6,6 0 0 0 18,10 M12,16 V20 M8.5,20 H15.5"
                              x:Name="MicStandPath" Stroke="#E2E8F0" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Line x:Name="MicSlashLine" X1="4" Y1="4" X2="20" Y2="20" Stroke="#F87171" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                    </Canvas>
                </Viewbox>
            </Border>

            <!-- QUICK 30s REPLAY CLIP PILL (Visible in fullscreen games, matches flush notch style) -->
            <Border x:Name="ReplayClipPill"
                    Height="15"
                    Width="30"
                    CornerRadius="0,0,7.5,7.5"
                    Margin="5,0,0,0"
                    VerticalAlignment="Top"
                    Background="#FC090A0D"
                    BorderBrush="#24252C"
                    BorderThickness="1,0,1,1"
                    Visibility="Collapsed"
                    Cursor="Hand"
                    ToolTip="Сохранить 30с игровой клип (Alt+F10 / Win+Alt+G)"
                    MouseLeftButtonUp="ReplayClipBtn_Click"
                    MouseEnter="ReplayClipPill_MouseEnter"
                    MouseLeave="ReplayClipPill_MouseLeave">
                <Viewbox x:Name="ReplayClipViewbox" Width="9.5" Height="9.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Data="M3,7 A2,2 0 0 1 5,5 H14 A2,2 0 0 1 16,7 V17 A2,2 0 0 1 14,19 H5 A2,2 0 0 1 3,17 Z M16,10 L21,7 V17 L16,14 Z"
                              Fill="#E2E8F0"/>
                        <Ellipse Canvas.Left="7.5" Canvas.Top="10" Width="4" Height="4" Fill="#F87171"/>
                    </Canvas>
                </Viewbox>
            </Border>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
