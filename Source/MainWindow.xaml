                                        </Button>

                                        <Button x:Name="HomeRecordTile" Style="{StaticResource AtollUnboxedBtn}" Click="ToggleScreenRecord_Click" ToolTip="Записать экран в MP4 (Видео\DesktopIsland)">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Border x:Name="HomeRecordCircle" Width="42" Height="42" CornerRadius="21" Background="#2F1716" Margin="0,0,0,6" HorizontalAlignment="Center">
                                                    <Path x:Name="HomeRecordCameraPath" Data="M 3,7 A 2,2 0 0 1 5,5 H 13 A 2,2 0 0 1 15,7 V 15 A 2,2 0 0 1 13,17 H 5 A 2,2 0 0 1 3,15 Z M 15,9 L 20,6.5 V 15.5 L 15,13 Z" Stroke="#EF4444" StrokeThickness="1.6" StrokeLineJoin="Round" Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
