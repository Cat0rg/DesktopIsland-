                                            <StackPanel HorizontalAlignment="Center">
                                                <Border Width="42" Height="42" CornerRadius="21" Background="#122436" Margin="0,0,0,6" HorizontalAlignment="Center">
                                                    <Path Data="M 15,5 L 19,9 L 10,18 H 5 L 4,17 L 15,5 Z M 8,18 H 20" Stroke="#38BDF8" StrokeThickness="1.6" StrokeLineJoin="Round" Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
