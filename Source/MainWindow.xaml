                                                    <Border x:Name="HomeMediaThumbBorder" Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="#23252E" Margin="0,0,10,0" ClipToBounds="True" VerticalAlignment="Center">
                                                        <Grid>
                                                            <Path x:Name="HomeMediaFallbackNote" Data="M 9,16 V 6 L 18,4 V 14 M 7,16 A 2.2,2.2 0 1 1 7,15.9 M 16,14 A 2.2,2.2 0 1 1 16,13.9" Stroke="#A1A1AA" StrokeThickness="1.6" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Image x:Name="HomeMediaThumbImg" Stretch="UniformToFill" Visibility="Collapsed"/>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonUp="HomeMediaCard_Click" ToolTip="Нажмите, чтобы открыть полный микшер музыки и звука">
                                                        <TextBlock x:Name="HomeMediaTitleText" Text="Ничего не играет" FontSize="12" FontWeight="SemiBold" Foreground="#F4F4F5" TextTrimming="CharacterEllipsis" MaxWidth="165"/>
                                                        <TextBlock x:Name="HomeMediaArtistText" Text="Выберите или включите плеер" FontSize="10" Foreground="#8E9099" TextTrimming="CharacterEllipsis" MaxWidth="165"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource DarkButton}" Background="#20222A" BorderBrush="#2D303B" Width="28" Height="28" Padding="0" Click="MediaPrev_Click" ToolTip="Предыдущий трек">
                                                            <Button.Resources>
                                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style>
                                                            </Button.Resources>
                                                            <Path Data="M 4,4.5 V 13.5 M 11,9 L 17,4.8 V 13.2 Z M 5.5,9 L 11.5,4.8 V 13.2 Z" Fill="#E4E4E7" Width="11.5" Height="10" Stretch="Uniform"/>
                                                        </Button>
                                                        <Button x:Name="HomeMediaPlayBtn" Width="32" Height="32" Padding="0" Margin="4,0" Cursor="Hand" Click="MediaPlayPause_Click" ToolTip="Воспроизведение / Пауза">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bd" CornerRadius="16" Background="#F4F4F5" RenderTransformOrigin="0.5,0.5">
                                                                        <Border.RenderTransform><ScaleTransform x:Name="PlayScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#FFFFFF"/></Trigger>
                                                                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.82"/></Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                            <Grid>
                                                                <Path x:Name="HomeMediaPlayGlyph" Data="M 6,4 L 15,9.5 L 6,15 Z" Fill="#090A0D" Width="10.5" Height="10.5" Stretch="Uniform" Margin="1.5,0,0,0"/>
                                                                <Path x:Name="HomeMediaPauseGlyph" Data="M 5,4 H 7.8 V 15 H 5 Z M 10.2,4 H 13 V 15 H 10.2 Z" Fill="#090A0D" Width="10" Height="10.5" Stretch="Uniform" Visibility="Collapsed"/>
                                                            </Grid>
                                                        </Button>
                                                        <Button Style="{StaticResource DarkButton}" Background="#20222A" BorderBrush="#2D303B" Width="28" Height="28" Padding="0" Click="MediaNext_Click" ToolTip="Следующий трек">
                                                            <Button.Resources>
                                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style>
                                                            </Button.Resources>
                                                            <Path Data="M 14,4.5 V 13.5 M 1,4.8 L 7,9 L 1,13.2 Z M 6.5,4.8 L 12.5,9 L 6.5,13.2 Z" Fill="#E4E4E7" Width="11.5" Height="10" Stretch="Uniform"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Sleek Music Service Launchers (Auto detection is default under the hood) -->
                                                <Border Background="#111216" CornerRadius="10" Padding="2" Margin="0,9,0,0" HorizontalAlignment="Left">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button x:Name="HomePlayerAutoBtn" Content="Авто" Style="{StaticResource DarkButton}" Visibility="Collapsed" Tag="Auto" Click="BindMediaPlayer_Click"/>
                                                        <Button x:Name="HomePlayerSpotifyBtn" Content="↗ Spotify" Style="{StaticResource DarkButton}" BorderThickness="0" Padding="8,2.5" FontSize="9.5" Margin="0,0,2,0" Tag="Spotify" Click="BindMediaPlayer_Click" ToolTip="Открыть Spotify (приложение или в браузере)"/>
                                                        <Button x:Name="HomePlayerSoundCloudBtn" Content="↗ SoundCloud" Style="{StaticResource DarkButton}" BorderThickness="0" Padding="8,2.5" FontSize="9.5" Margin="0,0,2,0" Tag="SoundCloud" Click="BindMediaPlayer_Click" ToolTip="Открыть SoundCloud (приложение или в браузере)"/>
                                                        <Button x:Name="HomePlayerYtMusicBtn" Content="↗ YT Music" Style="{StaticResource DarkButton}" BorderThickness="0" Padding="8,2.5" FontSize="9.5" Tag="YouTubeMusic" Click="BindMediaPlayer_Click" ToolTip="Открыть YouTube Music (приложение или в браузере)"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- Weather Card (Bright colored SVG weather graphics + expandable Hourly & 5-Day Forecast) -->
                                        <Border x:Name="HomeWeatherCard" Grid.Column="2" Background="#18191F" BorderBrush="#252730" BorderThickness="1" CornerRadius="18" Padding="14,11" Cursor="Hand" MouseLeftButtonUp="HomeWeatherCard_Click" ToolTip="Нажмите, чтобы открыть прогноз по часам и на 5 дней">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Grid x:Name="HomeWeatherIconCanvas" Width="36" Height="36" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <Ellipse x:Name="HomeSunRayRing" Width="28" Height="28" Stroke="#FBBF24" StrokeThickness="1.6" StrokeDashArray="2 2.2" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                                    <Ellipse x:Name="HomeSunCore" Width="17" Height="17" Fill="#FBBF24" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5.5,5.5,0,0"/>
                                                    <Path x:Name="HomeCloudShape" Data="M 4,15 H 18 A 3.5,3.5 0 0 0 18,8 A 4.8,4.8 0 0 0 8.5,7 A 3.8,3.8 0 0 0 4,15 Z" Fill="#E4E4E7" Width="23" Height="15" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,3"/>
                                                    <Path x:Name="HomeRainShape" Data="M 6,16 L 4.5,19 M 11,16 L 9.5,19 M 16,16 L 14.5,19" Stroke="#38BDF8" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,0" Visibility="Collapsed"/>
                                                </Grid>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="HomeWeatherTempText" Text="—°" FontSize="20" FontWeight="SemiBold" Foreground="#F4F4F5" LineHeight="22"/>
                                                    <TextBlock x:Name="HomeWeatherSubText" Text="Погода" FontSize="10.2" Foreground="#9CA3AF" MaxWidth="98" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        </Grid>

                                        <!-- Expandable Inline Weather Forecast Drawer (Open-Meteo Hourly + 5-Day Gradient Bars) -->
                                        <Border x:Name="HomeWeatherForecastDrawer" CornerRadius="16" BorderBrush="#262D3E" BorderThickness="1" Padding="12,10" Margin="0,8,0,0" Visibility="Collapsed">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#162032" Offset="0"/>
                                                    <GradientStop Color="#14161D" Offset="0.65"/>
                                                    <GradientStop Color="#13141A" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <TextBlock x:Name="WeatherForecastCityTitle" Text="Прогноз погоды" FontSize="11.5" FontWeight="SemiBold" Foreground="#F4F4F5"/>
                                                        <TextBlock x:Name="WeatherForecastDetailsText" Text="Ощущ. —° · Ветер — км/ч · Влажность —%" FontSize="9.8" Foreground="#94A3B8" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button Content="↻" Style="{StaticResource DarkButton}" Padding="7,2.5" FontSize="10.5" Margin="0,0,4,0" Click="RefreshWeatherManual_Click" ToolTip="Обновить погоду сейчас"/>
                                                        <Button Content="✕" Style="{StaticResource DarkButton}" Padding="6,2.5" FontSize="9.5" Click="CloseWeatherDrawer_Click"/>
                                                    </StackPanel>
                                                </Grid>

                                                <ItemsControl x:Name="WeatherHourlyControl" Margin="0,0,0,9">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="6"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#1B202C" BorderBrush="#272D3C" BorderThickness="1" CornerRadius="10" Padding="4,6" Margin="0,0,4,0">
                                                                <StackPanel HorizontalAlignment="Center">
                                                                    <TextBlock Text="{Binding TimeLabel}" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding IconGlyph}" FontSize="13.5" Margin="0,3,0,2" HorizontalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding TempLabel}" FontSize="10.8" FontWeight="SemiBold" Foreground="#F4F4F5" HorizontalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding PrecipLabel}" FontSize="8.5" Foreground="#38BDF8" HorizontalAlignment="Center" MinHeight="11"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Border Height="1" Background="#232836" Margin="0,0,0,7"/>

                                                <ItemsControl x:Name="WeatherDailyControl">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,2.5">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="68"/>
                                                                    <ColumnDefinition Width="26"/>
                                                                    <ColumnDefinition Width="34"/>
                                                                    <ColumnDefinition Width="132"/>
                                                                    <ColumnDefinition Width="34"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding DayLabel}" FontSize="10.2" FontWeight="Medium" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding IconGlyph}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding MinLabel}" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <Grid Grid.Column="3" Height="6" VerticalAlignment="Center">
                                                                    <Border Background="#232735" CornerRadius="3" Height="6"/>
                                                                    <Canvas Width="132" Height="6" ClipToBounds="True">
                                                                        <Border Canvas.Left="{Binding BarLeftPx}" Width="{Binding BarWidthPx}" Height="6" CornerRadius="3">
                                                                            <Border.Background>
                                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                                    <GradientStop Color="#38BDF8" Offset="0"/>
                                                                                    <GradientStop Color="#FBBF24" Offset="0.6"/>
                                                                                    <GradientStop Color="#F97316" Offset="1"/>
                                                                                </LinearGradientBrush>
                                                                            </Border.Background>
                                                                        </Border>
                                                                    </Canvas>
                                                                </Grid>
                                                                <TextBlock Grid.Column="4" Text="{Binding MaxLabel}" FontSize="10.2" FontWeight="SemiBold" Foreground="#F4F4F5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                        </StackPanel>

                                        <!-- WIDGET 3: Home Quick Launch Dock (Restyled Squircle Glass Launcher) -->
                                        <StackPanel x:Name="WidgetHomeDock" Tag="HomeDock" Margin="0,0,0,11">
                                            <Grid x:Name="WidgetEditBar_HomeDock" Visibility="Collapsed" Margin="2,0,2,5">
                                                <TextBlock Text="БЫСТРЫЙ ЗАПУСК" FontSize="9" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="↑" Style="{StaticResource DarkButton}" Padding="6,1" FontSize="9.5" Margin="0,0,3,0" Tag="HomeDock" Click="MoveWidgetUp_Click"/>
                                                    <Button Content="↓" Style="{StaticResource DarkButton}" Padding="6,1" FontSize="9.5" Margin="0,0,3,0" Tag="HomeDock" Click="MoveWidgetDown_Click"/>
                                                    <Button Content="✕ Убрать" Style="{StaticResource DarkButton}" Background="#2D191E" Foreground="#FCA5A5" Padding="6,1" FontSize="9" Tag="HomeDock" Click="HideWidget_Click"/>
                                                </StackPanel>
                                            </Grid>
                                            <Border x:Name="HomeDockContainer" BorderBrush="#282B36" BorderThickness="1" CornerRadius="20" Padding="13,10,13,11">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#191B23" Offset="0"/>
                                                        <GradientStop Color="#14151B" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource AccentBrightBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="БЫСТРЫЙ ЗАПУСК" FontSize="9.4" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                    <Border x:Name="HomeAppsCountBadge" Background="#20232E" BorderBrush="#2D3140" BorderThickness="1" CornerRadius="7" Padding="5,0.5" Margin="7,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock x:Name="HomeAppsCountText" Text="0" FontSize="8.8" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <ToggleButton x:Name="EditAppsBtn" Width="Auto" Height="22" Padding="8,0" Margin="0,0,5,0" Cursor="Hand" ToolTip="Редактировать закреплённые приложения (перетаскивание и удаление)" Checked="EditAppsBtn_Changed" Unchecked="EditAppsBtn_Changed">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border x:Name="Bd" Background="#20232E" BorderBrush="#2E3240" BorderThickness="1" CornerRadius="11" Padding="8,2">
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <TextBlock Text="✎" FontSize="10" Foreground="#CBD5E1" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                        <TextBlock x:Name="EditLbl" Text="Править" FontSize="9.5" FontWeight="Medium" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="#2A2E3D"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrightBrush}"/>
                                                                        <Setter TargetName="EditLbl" Property="Text" Value="Готово"/>
                                                                        <Setter TargetName="EditLbl" Property="Foreground" Value="#FFFFFF"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                    </ToggleButton>
                                                    <Button x:Name="HomeAppsModeToggleBtn" Style="{StaticResource DarkButton}" Background="#20232E" BorderBrush="#2E3240" BorderThickness="1" Width="22" Height="22" Padding="0" Opacity="0.9" VerticalAlignment="Center" Click="HomeAppsModeToggleBtn_Click" ToolTip="Переключить вид: Док / Сетка">
                                                        <Path x:Name="HomeAppsModeIcon" Data="M 4,4 H 10 V 10 H 4 Z M 14,4 H 20 V 10 H 14 Z M 4,14 H 10 V 20 H 4 Z M 14,14 H 20 V 20 H 14 Z" Stroke="#CBD5E1" StrokeThickness="1.6" StrokeLineJoin="Round" Width="11" Height="11" Stretch="Uniform"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <ScrollViewer x:Name="HomeDockScrollViewer" Style="{StaticResource OverlayScrollViewer}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                                <Border Background="#111218" BorderBrush="#232632" BorderThickness="1" CornerRadius="16" Padding="8,7,8,5" HorizontalAlignment="Left">
                                                    <StackPanel x:Name="HomeDockAppsPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                                                </Border>
                                            </ScrollViewer>
                                            <StackPanel x:Name="HomeGridContainer" Visibility="Collapsed">
                                                <WrapPanel x:Name="AppsWrapPanel" Orientation="Horizontal" MaxWidth="496" HorizontalAlignment="Left"/>
                                            </StackPanel>

                                            <!-- Inline App Search Drawer (toggled cleanly by clicking "+") -->
                                            <StackPanel x:Name="HomeAppSearchDrawer" Visibility="Collapsed" Margin="0,10,0,0" RenderTransformOrigin="0.5,0">
                                                <StackPanel.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform x:Name="HomeSearchScale" ScaleX="1" ScaleY="1"/>
                                                        <TranslateTransform x:Name="HomeSearchTranslate" Y="0"/>
                                                    </TransformGroup>
                                                </StackPanel.RenderTransform>
                                                <Grid>
                                                    <TextBox x:Name="HomeAppSearchBox" Background="#1E2028" Foreground="#F4F4F5" BorderBrush="#2563EB" BorderThickness="1.8" Padding="32,7,84,7" FontSize="12" CaretBrush="#60A5FA" TextChanged="HomeAppSearchBox_TextChanged" KeyDown="HomeAppSearchBox_KeyDown">
                                                        <TextBox.Template>
                                                            <ControlTemplate TargetType="TextBox">
                                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </TextBox.Template>
                                                    </TextBox>
                                                    <Path Data="M 10,4 A 6,6 0 1 0 10,16 A 6,6 0 1 0 10,4 Z M 14.5,14.5 L 19,19" Stroke="#71717A" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False"/>
                                                    <TextBlock x:Name="HomeAppSearchPlaceholder" Text="Поиск программ (Камера, Калькулятор, cmd...)" FontSize="11.2" Foreground="#71717A" Margin="33,0,90,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                                    <Button Content="Обзор .exe" Style="{StaticResource DarkButton}" Background="#272A35" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Padding="8,3.5" FontSize="9.8" Click="BrowseCustomExeApp_Click" ToolTip="Выбрать любую программу с диска"/>
                                                </Grid>
                                                <ItemsControl x:Name="HomeAppSearchResultsList" Margin="0,9,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="3"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </StackPanel>

                                            <TextBlock x:Name="AppsEditHintText"
                                                       Text="Режим правки: перетаскивайте иконки или нажмите красный − для удаления"
                                                       FontSize="9.8"
                                                       Foreground="#94A3B8"
                                                       Margin="2,6,0,0"
                                                       Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Border>
                                        </StackPanel>

                                        <!-- WIDGET 3.5: Smart Drag-Out File Shelf ("Полка файлов") -->
                                        <StackPanel x:Name="WidgetFileShelf" Tag="FileShelf" Margin="0,0,0,11">
                                            <Grid x:Name="WidgetEditBar_FileShelf" Visibility="Collapsed" Margin="2,0,2,5">
                                                <TextBlock Text="ПОЛКА ФАЙЛОВ (ПЕРЕТАЩИ СЮДА ИЛИ В ЧАТ)" FontSize="9" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="↑" Style="{StaticResource DarkButton}" Padding="6,1" FontSize="9.5" Margin="0,0,3,0" Tag="FileShelf" Click="MoveWidgetUp_Click"/>
                                                    <Button Content="↓" Style="{StaticResource DarkButton}" Padding="6,1" FontSize="9.5" Margin="0,0,3,0" Tag="FileShelf" Click="MoveWidgetDown_Click"/>
                                                    <Button Content="✕ Убрать" Style="{StaticResource DarkButton}" Background="#2D191E" Foreground="#FCA5A5" Padding="6,1" FontSize="9" Tag="FileShelf" Click="HideWidget_Click"/>
                                                </StackPanel>
                                            </Grid>
                                            <Border Background="#15161C" BorderBrush="#262934" BorderThickness="1" CornerRadius="16" Padding="12,9" AllowDrop="True">
                                                <StackPanel>
                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="22" Height="22" CornerRadius="7" Background="#16283D" Margin="0,0,8,0">
                                                                <Path Data="M 14,3 H 8 A 3,3 0 0 0 5,6 V 16 A 5,5 0 0 0 15,16 V 7 A 3,3 0 0 0 9,7 V 15 A 1,1 0 0 0 11,15 V 8" Stroke="#38BDF8" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <StackPanel>
                                                                <TextBlock Text="ПОЛКА ФАЙЛОВ" FontSize="9.2" FontWeight="Bold" Foreground="#94A3B8"/>
                                                                <TextBlock x:Name="FileShelfHintText" Text="Перетащите файл на островок или выберите — затем тащите в Telegram/папку" FontSize="9.2" Foreground="#64748B" MaxWidth="310" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <Button Content="+ Файл" Style="{StaticResource DarkButton}" Background="#1E222E" BorderThickness="0" Padding="8,2.5" FontSize="9.5" Margin="0,0,4,0" Click="AddFileToShelf_Click" ToolTip="Добавить файл на полку"/>
                                                            <Button x:Name="ClearFileShelfBtn" Content="Очистить" Style="{StaticResource DarkButton}" Background="#251B20" BorderThickness="0" Foreground="#FCA5A5" Padding="7,2.5" FontSize="9.5" Visibility="Collapsed" Click="ClearFileShelf_Click"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <WrapPanel x:Name="FileShelfItemsPanel" Orientation="Horizontal" Margin="0,7,0,0" Visibility="Collapsed"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- WIDGET 4: Notification Center -->
                                        <StackPanel x:Name="WidgetNotifications" Tag="Notifications" Margin="0,0,0,11">
                                            <Grid x:Name="WidgetEditBar_Notifications" Visibility="Collapsed" Margin="2,0,2,5">
                                                <TextBlock Text="ЦЕНТР УВЕДОМЛЕНИЙ" FontSize="9" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="↑" Style="{StaticResource DarkButton}" Padding="6,1" FontSize="9.5" Margin="0,0,3,0" Tag="Notifications" Click="MoveWidgetUp_Click"/>
                                                    <Button Content="↓" Style="{StaticResource DarkButton}" Padding="6,1" FontSize="9.5" Margin="0,0,3,0" Tag="Notifications" Click="MoveWidgetDown_Click"/>
                                                    <Button Content="✕ Убрать" Style="{StaticResource DarkButton}" Background="#2D191E" Foreground="#FCA5A5" Padding="6,1" FontSize="9" Tag="Notifications" Click="HideWidget_Click"/>
                                                </StackPanel>
                                            </Grid>
                                            <Border x:Name="NotificationCenterCard" Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="18" Padding="13,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,7">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="ЦЕНТР УВЕДОМЛЕНИЙ" FontSize="9.2" FontWeight="SemiBold" Foreground="#71717A" VerticalAlignment="Center"/>
                                                    <Border x:Name="NotifCountBadge" Background="#2563EB" CornerRadius="8" Padding="5.5,0.8" Margin="7,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                                        <TextBlock x:Name="NotifCountText" Text="0" FontSize="9.2" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Content="📁 Загрузки" Style="{StaticResource DarkButton}" Background="#1D1F27" BorderThickness="0" Padding="8,2.5" FontSize="9.5" Margin="0,0,5,0" Click="OpenDownloadsFolder_Click" ToolTip="Открыть папку Загрузки"/>
                                                    <Button x:Name="ClearNotificationsBtn" Content="Очистить" Style="{StaticResource DarkButton}" Background="#1D1F27" BorderThickness="0" Padding="8,2.5" FontSize="9.5" Click="ClearNotifications_Click" Visibility="Collapsed" ToolTip="Очистить центр уведомлений"/>
                                                </StackPanel>
                                            </Grid>

                                            <ScrollViewer x:Name="NotifScrollViewer" Style="{StaticResource OverlayScrollViewer}" MaxHeight="196" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl x:Name="NotificationsListControl">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#1B1D24" BorderBrush="#262934" BorderThickness="1" CornerRadius="13" Padding="9.5,7" Margin="0,0,0,5">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="10" Background="#222532" Margin="0,0,9,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Icon}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding AppTag}" FontSize="9.2" FontWeight="SemiBold" Foreground="#71717A"/>
                                                                            <TextBlock Text=" · " FontSize="9.2" Foreground="#52525B"/>
                                                                            <TextBlock Text="{Binding TimeLabel}" FontSize="9.2" Foreground="#71717A"/>
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding Title}" FontSize="11.2" FontWeight="SemiBold" Foreground="#F4F4F5" TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#9CA3AF" TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Button Content="{Binding ActionLabel}" Style="{StaticResource AccentButton}" Padding="8,3" FontSize="9.8" Margin="0,0,4,0" Tag="{Binding}" Click="NotifAction_Click"
                                                                                Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}"/>
                                                                        <Button Content="📂" Style="{StaticResource DarkButton}" Padding="6,3" FontSize="9.8" Margin="0,0,4,0" Tag="{Binding}" Click="NotifOpenFolder_Click" ToolTip="Показать файл в папке"
                                                                                Visibility="{Binding HasFolderButton, Converter={StaticResource BoolToVis}}"/>
                                                                        <Button Content="✕" Style="{StaticResource DarkButton}" Background="Transparent" BorderThickness="0" Padding="5,2" FontSize="9.5" Foreground="#71717A" Tag="{Binding}" Click="NotifDismiss_Click" ToolTip="Убрать уведомление"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            <TextBlock x:Name="NotifEmptyText" Text="Нет новых уведомлений — здесь появятся загрузки, диски и события" FontSize="10.2" Foreground="#71717A" HorizontalAlignment="Center" Margin="0,3,0,1" Visibility="Visible"/>
                                        </StackPanel>
                                    </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Widget Manager Bar (Shown in Edit Mode: restore removed widgets or finish editing) -->
                                    <Border x:Name="HomeAddWidgetsPanel" Background="#131722" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="14" Padding="11,9" Margin="0,2,0,4" Visibility="Collapsed">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="РЕДАКТИРОВАНИЕ ГЛАВНОЙ" FontSize="9.2" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center"/>
                                                <Button Content="✓ Готово" Style="{StaticResource AccentButton}" Padding="9,2.5" FontSize="9.5" HorizontalAlignment="Right" Click="DoneEditMode_Click"/>
                                            </Grid>
                                            <TextBlock x:Name="HomeAddWidgetsHint" Text="Меняйте порядок стрелками ↑↓, убирайте лишние виджеты или добавьте скрытые ниже:" FontSize="9.8" Foreground="#94A3B8" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                            <WrapPanel x:Name="HomeHiddenWidgetsWrap" Orientation="Horizontal"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- 2. MUSIC & AUDIO STUDIO TAB ("Музыка": Apple/Atoll Hero Player + Waveform + Seekbar + Audio Mixer) -->
                                <StackPanel x:Name="RemotePanel" Visibility="Collapsed">
                                    <!-- HERO NOW PLAYING CARD -->
                                    <Border x:Name="MediaHeroCard" BorderBrush="#262830" BorderThickness="1" CornerRadius="18" Padding="16,14" Margin="0,0,0,10">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop x:Name="MediaHeroGlowStop" Color="#2038BDF8" Offset="0"/>
                                                <GradientStop Color="#15161B" Offset="0.55"/>
                                                <GradientStop Color="#121317" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel>
                                            <!-- Top Album Art + Metadata + Live Spectrum Waveform -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Large 76x76 Rounded Album Cover -->
                                                <Border x:Name="MediaCardThumbBorder" Grid.Column="0" Width="76" Height="76" CornerRadius="14" Background="#1D1F27" BorderBrush="#2C2F3A" BorderThickness="1" Margin="0,0,13,0" ClipToBounds="True" VerticalAlignment="Center">
                                                    <Grid>
                                                        <Path x:Name="MediaCardFallbackIcon" Data="M 10,17 V 6 L 20,4 V 15 M 7.5,17 A 2.5,2.5 0 1 1 7.5,16.9 M 17.5,15 A 2.5,2.5 0 1 1 17.5,14.9" Stroke="#71717A" StrokeThickness="1.7" StrokeLineJoin="Round" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Image x:Name="MediaCardThumbImg" Stretch="UniformToFill" Visibility="Collapsed"/>
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <!-- Source Pill + Animated 6-Bar Visualizer -->
                                                    <Grid Margin="0,0,0,5">
                                                        <Border x:Name="MediaSourcePill" Background="#20222B" CornerRadius="8" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse x:Name="MediaSourceDot" Width="5.5" Height="5.5" Fill="{DynamicResource AccentBrightBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                <TextBlock x:Name="MediaSourceBadge" Text="Медиаплеер" FontSize="9.5" FontWeight="SemiBold" Foreground="#D4D4D8"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <StackPanel x:Name="RemoteEqPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Height="16" Opacity="0.85">
                                                            <Border x:Name="RemoteEqBar1" Width="2.5" Height="5" CornerRadius="1.2" Background="#38BDF8" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                            <Border x:Name="RemoteEqBar2" Width="2.5" Height="10" CornerRadius="1.2" Background="#60A5FA" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                            <Border x:Name="RemoteEqBar3" Width="2.5" Height="14" CornerRadius="1.2" Background="#818CF8" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                            <Border x:Name="RemoteEqBar4" Width="2.5" Height="9" CornerRadius="1.2" Background="#A78BFA" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                            <Border x:Name="RemoteEqBar5" Width="2.5" Height="12" CornerRadius="1.2" Background="#C084FC" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                            <Border x:Name="RemoteEqBar6" Width="2.5" Height="6" CornerRadius="1.2" Background="#E879F9" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Track Title & Artist -->
                                                    <TextBlock x:Name="MediaTitleText" Text="Ничего не играет" FontSize="15" FontWeight="SemiBold" Foreground="#F4F4F5" TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                                                    <TextBlock x:Name="MediaArtistText" Text="Выберите плеер или запустите трек" FontSize="11.5" Foreground="#A1A1AA" TextTrimming="CharacterEllipsis" MaxWidth="400" Margin="0,2,0,0"/>

                                                    <!-- Clickable Seek Bar + Timestamps -->
                                                    <Grid Margin="0,9,0,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Border x:Name="MediaProgressHost" Grid.Row="0" Height="6" CornerRadius="3" Background="#252732" Cursor="Hand" ToolTip="Нажмите для перемотки трека" MouseLeftButtonDown="MediaProgressHost_MouseDown">
                                                            <Border x:Name="MediaProgressFill" Height="6" CornerRadius="3" Width="0" HorizontalAlignment="Left" Background="#F4F4F5"/>
                                                        </Border>
                                                        <Grid Grid.Row="1" Margin="0,4,0,0">
                                                            <TextBlock x:Name="MediaElapsedText" Text="0:00" FontSize="9.5" Foreground="#71717A" HorizontalAlignment="Left"/>
                                                            <TextBlock x:Name="MediaDurationText" Text="0:00" FontSize="9.5" Foreground="#71717A" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Bottom Transport & Music Service Launchers -->
                                            <Grid Margin="0,10,0,0">
                                                <!-- Player Launcher Pills (Auto detection stays active by default) -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                    <Button x:Name="PlayerAutoBtn" Content="Авто" Style="{StaticResource DarkButton}" Visibility="Collapsed" Tag="Auto" Click="BindMediaPlayer_Click"/>
                                                    <Button x:Name="PlayerSpotifyBtn" Content="↗ Spotify" Style="{StaticResource DarkButton}" Background="#1F2028" BorderBrush="#2D303B" Padding="9,3.5" FontSize="10" Margin="0,0,5,0" Tag="Spotify" Click="BindMediaPlayer_Click" ToolTip="Открыть Spotify (приложение или в браузере)"/>
                                                    <Button x:Name="PlayerSoundCloudBtn" Content="↗ SoundCloud" Style="{StaticResource DarkButton}" Background="#1F2028" BorderBrush="#2D303B" Padding="9,3.5" FontSize="10" Margin="0,0,5,0" Tag="SoundCloud" Click="BindMediaPlayer_Click" ToolTip="Открыть SoundCloud (приложение или в браузере)"/>
                                                    <Button x:Name="PlayerYtMusicBtn" Content="↗ YT Music" Style="{StaticResource DarkButton}" Background="#1F2028" BorderBrush="#2D303B" Padding="9,3.5" FontSize="10" Margin="0,0,5,0" Tag="YouTubeMusic" Click="BindMediaPlayer_Click" ToolTip="Открыть YouTube Music (приложение или в браузере)"/>
                                                    <Button x:Name="ToggleLyricsBtn" Content="♫ Текст" Style="{StaticResource DarkButton}" Background="#1F2433" BorderBrush="#334155" Padding="9,3.5" FontSize="10" Click="ToggleLyricsDrawer_Click" ToolTip="Показать живой текст песни (LRCLIB)"/>
                                                    <Button x:Name="LaunchBoundPlayerBtn" Content="↗" Style="{StaticResource DarkButton}" Visibility="Collapsed" Click="LaunchBoundPlayer_Click"/>
                                                </StackPanel>

                                                <!-- Apple/Atoll Sleek Circular Transport Buttons -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <Button Style="{StaticResource DarkButton}" Background="#20222A" BorderBrush="#2D303B" Width="34" Height="34" Padding="0" Margin="0,0,7,0" Click="MediaPrev_Click" ToolTip="Предыдущий трек">
                                                        <Button.Resources>
                                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="17"/></Style>
                                                        </Button.Resources>
                                                        <Path Data="M 4,4.5 V 13.5 M 11,9 L 17,4.8 V 13.2 Z M 5.5,9 L 11.5,4.8 V 13.2 Z" Fill="#F4F4F5" Width="13" Height="11" Stretch="Uniform"/>
                                                    </Button>
                                                    <Button x:Name="MediaPlayPauseBtn" Width="40" Height="40" Padding="0" Margin="0,0,7,0" Cursor="Hand" Click="MediaPlayPause_Click" ToolTip="Воспроизведение / Пауза">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bd" CornerRadius="20" Background="#F4F4F5" RenderTransformOrigin="0.5,0.5">
                                                                    <Border.RenderTransform><ScaleTransform x:Name="PlayScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="#FFFFFF"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.84"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <Grid>
                                                            <Path x:Name="MediaPlayGlyph" Data="M 7,4 L 18,10 L 7,16 Z" Fill="#090A0D" Width="13.5" Height="13.5" Stretch="Uniform" Margin="2,0,0,0"/>
                                                            <Path x:Name="MediaPauseGlyph" Data="M 6,4 H 9 V 16 H 6 Z M 12,4 H 15 V 16 H 12 Z" Fill="#090A0D" Width="12.5" Height="12.5" Stretch="Uniform" Visibility="Collapsed"/>
                                                        </Grid>
                                                    </Button>
                                                    <Button Style="{StaticResource DarkButton}" Background="#20222A" BorderBrush="#2D303B" Width="34" Height="34" Padding="0" Click="MediaNext_Click" ToolTip="Следующий трек">
                                                        <Button.Resources>
                                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="17"/></Style>
                                                        </Button.Resources>
                                                        <Path Data="M 14,4.5 V 13.5 M 1,4.8 L 7,9 L 1,13.2 Z M 6.5,4.8 L 12.5,9 L 6.5,13.2 Z" Fill="#F4F4F5" Width="13" Height="11" Stretch="Uniform"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Synced Lyrics Drawer (LRCLIB Zero-Key) -->
                                            <Border x:Name="MediaLyricsDrawer" Background="#101218" BorderBrush="#232836" BorderThickness="1" CornerRadius="12" Padding="12,9" Margin="0,10,0,0" Visibility="Collapsed">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,5">
                                                        <TextBlock x:Name="LyricsStatusLabel" Text="♫ ТЕКСТ ПЕСНИ" FontSize="9" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center"/>
                                                        <Button Content="✕" Style="{StaticResource DarkButton}" Padding="5,1" FontSize="9" HorizontalAlignment="Right" Click="ToggleLyricsDrawer_Click"/>
                                                    </Grid>
                                                    <TextBlock x:Name="LyricsPrevLineText" Text="" FontSize="10.5" Foreground="#64748B" TextAlignment="Center" TextWrapping="Wrap" Margin="0,1"/>
                                                    <TextBlock x:Name="LyricsCurrLineText" Text="Включите музыку для синхронизации текста" FontSize="12.5" FontWeight="SemiBold" Foreground="#F8FAFC" TextAlignment="Center" TextWrapping="Wrap" Margin="0,3"/>
                                                    <TextBlock x:Name="LyricsNextLineText" Text="" FontSize="10.5" Foreground="#64748B" TextAlignment="Center" TextWrapping="Wrap" Margin="0,1"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- AUDIO OUTPUT, VOLUME & PER-APP MIXER -->
                                    <Border Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,7">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="M 3,9 H 7 L 12,5 V 19 L 7,15 H 3 Z M 15.5,8.5 A 5,5 0 0 1 15.5,15.5" Stroke="#A1A1AA" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="15" Height="15" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="VolumePercentText" Text="Громкость · —%" FontSize="11.5" FontWeight="SemiBold" Foreground="#F4F4F5" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button x:Name="GameAudioBindBtn" Content="🎮 Автозвук" Style="{StaticResource DarkButton}" Background="#1F2028" BorderThickness="0" Padding="8,3" FontSize="10" Margin="0,0,4,0" Click="BindGameAudioDevice_Click" Visibility="Collapsed" ToolTip="Закрепить аудио-устройство за игрой"/>
                                                    <Button x:Name="AudioSwitchBtn" Content="🎧 Вывод" Style="{StaticResource DarkButton}" Background="#1F2028" BorderThickness="0" Padding="9,3.5" FontSize="10" Margin="0,0,4,0" Click="SwitchAudioOutput_Click" ToolTip="Переключить устройство вывода"/>
                                                    <Button x:Name="ToggleAppMixerBtn" Content="Микшер ▾" Style="{StaticResource DarkButton}" Background="#1F2028" BorderThickness="0" Padding="9,3.5" FontSize="10" Click="ToggleAppMixer_Click" ToolTip="Громкость по программам"/>
                                                </StackPanel>
                                            </Grid>
                                            <Slider x:Name="MasterVolumeSlider" Minimum="0" Maximum="100" ValueChanged="MasterVolumeSlider_ValueChanged" IsMoveToPointEnabled="True"/>
                                            <ItemsControl x:Name="AppMixerList" Visibility="Collapsed" Margin="0,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="105"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding ProcessName}" FontSize="10.5" Foreground="#D4D4D8" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding VolumePercent, Mode=TwoWay}" Tag="{Binding Pid}" ValueChanged="AppSessionSlider_ValueChanged" IsMoveToPointEnabled="True" VerticalAlignment="Center" Margin="6,0"/>
                                                            <Button Grid.Column="2" Content="{Binding MuteGlyph}" Style="{StaticResource DarkButton}" Background="#1F2028" BorderThickness="0" Padding="6,2" FontSize="10" Tag="{Binding Pid}" Click="AppSessionMute_Click"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- QUICK AUDIO & DISPLAY ROW -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="14" Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="MicMuteBtn" Grid.Column="0" Content="🎙 Мик: Вкл" Style="{StaticResource DarkButton}" Background="#1F2028" BorderThickness="0" Padding="6,5" FontSize="10.2" Click="ToggleMicMute_Click"/>
                                                <Button x:Name="StreamShieldBtn" Grid.Column="2" Content="🛡 Щит: Выкл" Style="{StaticResource DarkButton}" Background="#1F2028" BorderThickness="0" Padding="6,5" FontSize="10" Click="ToggleStreamShield_Click" ToolTip="Скрывать треки и превью при записи"/>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="2" Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="14" Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="BrightnessLabelText" Grid.Column="0" Text="☀ 80%" FontSize="10.5" Foreground="#D4D4D8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="80" VerticalAlignment="Center" IsMoveToPointEnabled="True" ValueChanged="BrightnessSlider_ValueChanged"/>
                                                <Button Grid.Column="2" Content="Ночь" Style="{StaticResource DarkButton}" Background="#1F2028" BorderThickness="0" Padding="7,3" FontSize="9.8" Margin="8,0,0,0" Click="NightLightBtn_Click" ToolTip="Ночной свет Windows"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </StackPanel>

                                <!-- 3. SYSTEM TAB (Atoll Control Center + 3 Live Graphs + Drive Cards + Discord/DND + Devices + Network/Processes) -->
                                <StackPanel x:Name="SystemPanel" Visibility="Collapsed">
                                    <!-- ПУНКТ УПРАВЛЕНИЯ -->
                                    <Border Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="14" Padding="12,10" Margin="0,0,0,9">
                                        <StackPanel>
                                            <TextBlock Text="ПУНКТ УПРАВЛЕНИЯ" FontSize="9.5" FontWeight="SemiBold" Foreground="#71717A" Margin="2,0,0,9"/>

                                            <!-- 5 Circular Control Toggles -->
                                            <UniformGrid Columns="5" Margin="0,0,0,10">
                                                <Button x:Name="CtrlWifiBtn" Style="{StaticResource AtollUnboxedBtn}" Click="CtrlWifi_Click" ToolTip="Включить / выключить Wi-Fi (или открыть сеть)">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <Border x:Name="CtrlWifiCircle" Width="38" Height="38" CornerRadius="19" Background="#252730" Margin="0,0,0,5">
                                                            <Viewbox Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Canvas Width="24" Height="24">
                                                                    <Path Data="M 2,9 A 15,15 0 0 1 22,9 M 5.5,13 A 10,10 0 0 1 18.5,13 M 9,16.5 A 5,5 0 0 1 15,16.5" Stroke="#F4F4F5" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                                    <Ellipse Canvas.Left="10.7" Canvas.Top="19" Width="2.6" Height="2.6" Fill="#F4F4F5"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Border>
                                                        <TextBlock x:Name="CtrlWifiLabel" Text="Wi-Fi" FontSize="10" Foreground="#D4D4D8" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button x:Name="CtrlBtBtn" Style="{StaticResource AtollUnboxedBtn}" Click="ToggleBluetooth_Click" ToolTip="Включить / выключить Bluetooth">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <Border x:Name="CtrlBtCircle" Width="38" Height="38" CornerRadius="19" Background="#252730" Margin="0,0,0,5">
                                                            <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Canvas Width="24" Height="24">
                                                                    <Path Data="M 7,7 L 17,16.5 L 12,21 V 3 L 17,7.5 L 7,17" Stroke="#F4F4F5" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Border>
                                                        <TextBlock x:Name="CtrlBtLabel" Text="Bluetooth" FontSize="10" Foreground="#D4D4D8" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button x:Name="CtrlAirplaneBtn" Style="{StaticResource AtollUnboxedBtn}" Click="CtrlAirplane_Click" ToolTip="Режим полёта Windows">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <Border x:Name="CtrlAirplaneCircle" Width="38" Height="38" CornerRadius="19" Background="#252730" Margin="0,0,0,5">
                                                            <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Canvas Width="24" Height="24">
                                                                    <Path Data="M 21,16 V 14 L 13,9 V 3.5 A 1.5,1.5 0 0 0 10,3.5 V 9 L 2,14 V 16 L 10,13.5 V 19 L 8,20.5 V 22 L 11.5,21 L 15,22 V 20.5 L 13,19 V 13.5 Z" Fill="#D4D4D8"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Border>
                                                        <TextBlock x:Name="CtrlAirplaneLabel" Text="Полёт" FontSize="10" Foreground="#D4D4D8" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button x:Name="CtrlVpnBtn" Style="{StaticResource AtollUnboxedBtn}" Click="CtrlVpn_Click" ToolTip="Быстрый статус и запуск VPN">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <Border x:Name="CtrlVpnCircle" Width="38" Height="38" CornerRadius="19" Background="#252730" Margin="0,0,0,5">
                                                            <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Canvas Width="24" Height="24">
                                                                    <Path Data="M 12,3 L 19,6 V 12 C 19,16.5 15.8,19.8 12,21 C 8.2,19.8 5,16.5 5,12 V 6 Z" Stroke="#F4F4F5" StrokeThickness="2" StrokeLineJoin="Round"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Border>
                                                        <TextBlock x:Name="CtrlVpnLabel" Text="VPN" FontSize="10" Foreground="#D4D4D8" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button x:Name="CtrlDesktopBtn" Style="{StaticResource AtollUnboxedBtn}" Click="CtrlDesktop_Click" ToolTip="Скрыть / показать иконки рабочего стола">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <Border x:Name="CtrlDesktopCircle" Width="38" Height="38" CornerRadius="19" Background="#252730" Margin="0,0,0,5">
                                                            <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Canvas Width="24" Height="24">
                                                                    <Path Data="M 2,12 C 5,6.5 9,4.5 12,4.5 C 15,4.5 19,6.5 22,12 C 19,17.5 15,19.5 12,19.5 C 9,19.5 5,17.5 2,12 Z M 3,3 L 21,21" Stroke="#D4D4D8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Border>
                                                        <TextBlock Text="Чистый стол" FontSize="9.8" Foreground="#D4D4D8" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </UniformGrid>

                                            <!-- Uniform 2-Row Action Grids (4 Equal Power Tiles + 3 Equal Capture/Boost Tiles) -->
                                            <UniformGrid Columns="4" Margin="0,0,0,5">
                                                <Button Content="🔒 Блок" Style="{StaticResource DarkButton}" Background="#1F2028" BorderThickness="0" Padding="4,5.5" FontSize="10" Margin="0,0,5,0" Click="LockPc_Click" ToolTip="Заблокировать ПК"/>
                                                <Button Content="🌙 Сон" Style="{StaticResource DarkButton}" Background="#1F2028" BorderThickness="0" Padding="4,5.5" FontSize="10" Margin="0,0,5,0" Click="SleepPc_Click" ToolTip="Спящий режим"/>
                                                <Button Content="↻ Перезагр." Style="{StaticResource DarkButton}" Background="#1F2028" BorderThickness="0" Padding="4,5.5" FontSize="10" Margin="0,0,5,0" Click="RebootPc_Click" ToolTip="Перезагрузить ПК"/>
                                                <Button Content="⏻ Выкл" Style="{StaticResource DarkButton}" Background="#29171B" BorderBrush="#4C1D24" Foreground="#FCA5A5" Padding="4,5.5" FontSize="10" Click="ShutdownPc_Click" ToolTip="Выключить ПК"/>
                                            </UniformGrid>
                                            <UniformGrid Columns="3" Margin="0,0,0,8">
                                                <Button Content="🎬 Клип 30с" Style="{StaticResource DarkButton}" Background="#1F2028" BorderThickness="0" Padding="4,5.5" FontSize="10" Margin="0,0,5,0" Click="ReplayClipBtn_Click" ToolTip="Сохранить последние 30с"/>
                                                <Button Content="🔴 Запись" Style="{StaticResource DarkButton}" Background="#1F2028" BorderThickness="0" Padding="4,5.5" FontSize="10" Margin="0,0,5,0" Click="ToggleScreenRecord_Click" ToolTip="Начать / остановить запись экрана"/>
                                                <Button Content="⚡ Буст ОЗУ" Style="{StaticResource DarkButton}" Background="#1D261F" BorderBrush="#2D4A33" Foreground="#86EFAC" Padding="4,5.5" FontSize="10" Click="OptimizeRam_Click" ToolTip="Быстрая оптимизация ОЗУ"/>
                                            </UniformGrid>

                                            <!-- Collapsible Sleep Timer, Power Mode & Recording Settings (moved from Music into Control Center) -->
                                            <Button x:Name="RemoteExtrasToggleBtn" Content="Таймер сна, питание и записи ▾" Style="{StaticResource DarkButton}" Background="#1B1D24" BorderBrush="#292C36" HorizontalAlignment="Stretch" Padding="10,6" FontSize="10.2" Foreground="#A1A1AA" Click="RemoteExtrasToggle_Click"/>

                                            <StackPanel x:Name="RemoteExtrasSection" Visibility="Collapsed" Margin="0,8,0,0" RenderTransformOrigin="0.5,0">
                                                <StackPanel.RenderTransform>
                                                    <TranslateTransform x:Name="RemoteExtrasTranslate" Y="0"/>
                                                </StackPanel.RenderTransform>
                                                <!-- Night Auto-Sleep / Shutdown Timer -->
                                                <Border Background="#1B1D24" BorderBrush="#292C36" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,0,0,7">
                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="🌙 Авто-стоп ПК:" FontSize="11" FontWeight="SemiBold" Foreground="#E4E4E7" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="TimerStatusText" Text="Выкл." FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrightBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button x:Name="TimerActionModeBtn" Content="💤 Сон" Style="{StaticResource DarkButton}" Padding="7,3" FontSize="10" Margin="0,0,4,0" Click="TimerActionMode_Click"/>
                                                            <Button Content="30м" Style="{StaticResource DarkButton}" Padding="7,3" FontSize="10" Margin="0,0,4,0" Tag="30" Click="StartTimerPreset_Click"/>
                                                            <Button Content="60м" Style="{StaticResource AccentButton}" Padding="7,3" FontSize="10" Margin="0,0,4,0" Tag="60" Click="StartTimerPreset_Click"/>
                                                            <Button Content="120м" Style="{StaticResource DarkButton}" Padding="7,3" FontSize="10" Margin="0,0,4,0" Tag="120" Click="StartTimerPreset_Click"/>
                                                            <Button Content="Стоп" Style="{StaticResource DarkButton}" Padding="7,3" FontSize="10" Click="StopTimer_Click"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- Screen Recording + Power Mode & Folders -->
                                                <Border Background="#1B1D24" BorderBrush="#292C36" BorderThickness="1" CornerRadius="12" Padding="10,8">
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,5">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button x:Name="ScreenRecordBtn" Content="🔴 Запись экрана" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,5,0" Click="ToggleScreenRecord_Click"/>
                                                                <Button x:Name="RecordMonitorBtn" Content="🖥 Экран 1" Style="{StaticResource DarkButton}" Padding="8,4" FontSize="10" Visibility="Collapsed" Click="CycleRecordMonitor_Click"/>
                                                                <Button x:Name="PowerModeBtn" Style="{StaticResource DarkButton}" Padding="8,4" FontSize="10" Margin="5,0,0,0" Click="TogglePowerMode_Click">
                                                                    <TextBlock x:Name="PowerModeLabelText" Text="⚡ Питание"/>
                                                                </Button>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <Button Content="📁 Видео" Style="{StaticResource DarkButton}" Padding="7,4" FontSize="9.8" Margin="0,0,4,0" Click="OpenRecordingsFolder_Click"/>
                                                                <Button Content="📁 Клипы" Style="{StaticResource DarkButton}" Padding="7,4" FontSize="9.8" Click="OpenReplayClipsFolder_Click"/>
                                                            </StackPanel>
                                                        </Grid>
                                                        <TextBlock x:Name="RecordSaveHintText" Text="Запись → Видео\DesktopIsland · 30с клип → Видео\Captures" FontSize="9.3" Foreground="#71717A" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- 3 Live Telemetry Sparkline Cards: CPU / GPU / RAM -->
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="7"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="7"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- CPU CARD -->
                                        <Border Grid.Column="0" Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="14" Padding="11,9">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,3">
                                                    <TextBlock Text="ПРОЦЕССОР" FontSize="9.2" FontWeight="SemiBold" Foreground="#71717A" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="CpuValText" Text="0%" FontSize="14.5" FontWeight="Bold" Foreground="#F4F4F5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBlock x:Name="FpsDetailText" Text="0 FPS" FontSize="9.8" Foreground="#8E9099" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                                <Canvas Height="38" ClipToBounds="True" Margin="0,0,0,6">
                                                    <Polygon x:Name="CpuSparkPolygon" Fill="#2838BDF8"/>
                                                    <Polyline x:Name="CpuSparkline" Stroke="#38BDF8" StrokeThickness="1.8"/>
                                                </Canvas>
                                                <Border x:Name="CpuLoadBarHost" Height="3.5" CornerRadius="1.8" Background="#23242B">
                                                    <Border x:Name="CpuLoadBarFill" Height="3.5" CornerRadius="1.8" Width="0" HorizontalAlignment="Left" Background="#38BDF8"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- GPU CARD -->
                                        <Border Grid.Column="2" Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="14" Padding="11,9">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,3">
                                                    <TextBlock x:Name="SysGpuNameText" Text="ВИДЕОКАРТА" FontSize="9.2" FontWeight="SemiBold" Foreground="#71717A" MaxWidth="92" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="GpuCardValText" Text="—%" FontSize="14.5" FontWeight="Bold" Foreground="#F4F4F5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBlock x:Name="GpuDetailText" Text="—" FontSize="9.8" Foreground="#8E9099" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                                <Canvas Height="38" ClipToBounds="True" Margin="0,0,0,6">
                                                    <Polygon x:Name="GpuSparkPolygon" Fill="#28C084FC"/>
                                                    <Polyline x:Name="GpuSparkline" Stroke="#C084FC" StrokeThickness="1.8"/>
                                                </Canvas>
                                                <Border x:Name="GpuLoadBarHost" Height="3.5" CornerRadius="1.8" Background="#23242B">
                                                    <Border x:Name="GpuLoadBarFill" Height="3.5" CornerRadius="1.8" Width="0" HorizontalAlignment="Left" Background="#C084FC"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- RAM CARD -->
                                        <Border Grid.Column="4" Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="14" Padding="11,9">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,3">
                                                    <TextBlock Text="ПАМЯТЬ" FontSize="9.2" FontWeight="SemiBold" Foreground="#71717A" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="RamValText" Text="0%" FontSize="14.5" FontWeight="Bold" Foreground="#F4F4F5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBlock x:Name="RamSubText" Text="0 / 0 ГБ" FontSize="9.8" Foreground="#8E9099" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                                <Canvas Height="38" ClipToBounds="True" Margin="0,0,0,6">
                                                    <Polygon x:Name="RamSparkPolygon" Fill="#2834D399"/>
                                                    <Polyline x:Name="RamSparkline" Stroke="#34D399" StrokeThickness="1.8"/>
                                                </Canvas>
                                                <Border x:Name="RamLoadBarHost" Height="3.5" CornerRadius="1.8" Background="#23242B">
                                                    <Border x:Name="RamLoadBarFill" Height="3.5" CornerRadius="1.8" Width="0" HorizontalAlignment="Left" Background="#34D399"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Row 3: Discord + Sleek Network & Ping Widget (DND removed cleanly) -->
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Interactive Discord Card (Click to Open/Focus Discord + Voice Mute/Deafen controls when talking) -->
                                        <Border x:Name="DiscordCardBorder" Grid.Column="0" Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="14" Padding="12,10" Cursor="Hand" MouseLeftButtonUp="DiscordCard_Click" ToolTip="Нажмите, чтобы открыть Discord">
                                            <StackPanel VerticalAlignment="Center">
                                                <Grid>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse x:Name="DiscordVoiceDot" Width="7" Height="7" Fill="#52525B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Discord" FontSize="12.5" FontWeight="SemiBold" Foreground="#F4F4F5" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock x:Name="DiscordStatusText" Text="Проверка..." FontSize="10" Foreground="#8E9099" Margin="0,2.5,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Text="↗" FontSize="12" Foreground="#71717A" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                                </Grid>

                                                <StackPanel x:Name="DiscordVoiceControlsPanel" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                                                    <Button x:Name="DiscordMuteMicBtn" Content="🎙 Микр" Style="{StaticResource DarkButton}" Background="#22242E" BorderThickness="0" Padding="8,4" FontSize="9.8" Margin="0,0,6,0" Click="DiscordMuteMic_Click" ToolTip="Заглушить / включить микрофон"/>
                                                    <Button x:Name="DiscordDeafenBtn" Content="🎧 Микр+Звук" Style="{StaticResource DarkButton}" Background="#22242E" BorderThickness="0" Padding="8,4" FontSize="9.8" Click="DiscordDeafen_Click" ToolTip="Заглушить микрофон и звук Discord"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Sleek Network Speed & Ping Card -->
                                        <Border x:Name="NetworkWidgetCard" Grid.Column="2" Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="14" Padding="12,10">
                                            <Grid>
                                                <Polyline x:Name="NetSparkline" Stroke="#34D399" StrokeThickness="1.7" Opacity="0.5" VerticalAlignment="Bottom" HorizontalAlignment="Right" Height="26" Width="96"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <Grid Margin="0,0,0,4">
                                                        <TextBlock Text="СЕТЬ" FontSize="9.2" FontWeight="SemiBold" Foreground="#71717A" VerticalAlignment="Center"/>
                                                        <Border Background="#1D222D" CornerRadius="6" Padding="6,1" HorizontalAlignment="Right">
                                                            <TextBlock x:Name="PingHeaderLabel" Text="Ping —" FontSize="9.2" FontWeight="SemiBold" Foreground="#60A5FA"/>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock x:Name="NetDownText" Text="↓ 0 КБ/с" FontSize="13.5" FontWeight="Bold" Foreground="#34D399"/>
                                                    <TextBlock x:Name="NetUpText" Text="↑ 0 КБ/с" FontSize="10" Foreground="#9CA3AF" Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- Row 4: Mic & Camera Privacy + Device Batteries -->
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="14" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="МИКРОФОН И КАМЕРА СЕЙЧАС" FontSize="9" FontWeight="SemiBold" Foreground="#71717A" Margin="0,0,0,4"/>
                                                <TextBlock x:Name="PrivacyStatusText" Text="Камера и мик свободны" FontSize="11.5" FontWeight="SemiBold" Foreground="#D4D4D8" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="SysPrivacySubText" Text="Активных обращений нет" FontSize="10" Foreground="#71717A" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="14" Padding="11,9">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="УСТРОЙСТВА" FontSize="9.2" FontWeight="SemiBold" Foreground="#71717A" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="BtStateText" Text="" FontSize="9.2" Foreground="#60A5FA" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button x:Name="BtToggleBtn" Content="Вкл" Style="{StaticResource DarkButton}" Padding="8,2" FontSize="9.5" Margin="0,0,4,0" Click="ToggleBluetooth_Click" ToolTip="Включить / выключить Bluetooth"/>
                                                        <Button Content="⚙" Style="{StaticResource DarkButton}" Padding="6,2" FontSize="9.8" Click="OpenBtSettings_Click" ToolTip="Параметры Bluetooth"/>
                                                    </StackPanel>
                                                </Grid>

                                                <ScrollViewer Style="{StaticResource OverlayScrollViewer}" MaxHeight="104" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                    <ItemsControl x:Name="BtDevicesList">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#1B1D24" BorderBrush="#262934" BorderThickness="1" CornerRadius="9" Padding="7,4.5" Margin="0,0,0,4">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Ellipse Grid.Column="0" Width="6" Height="6" Fill="{Binding StatusDotHex}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                                            <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="Medium" Foreground="#F4F4F5" TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock Text="{Binding StatusLabel}" FontSize="9" Foreground="#8E9099" TextTrimming="CharacterEllipsis"/>
                                                                        </StackPanel>
                                                                        <Button Grid.Column="2" Content="{Binding ActionLabel}" Style="{StaticResource DarkButton}" Padding="7,2" FontSize="9.3" Tag="{Binding}" Click="BtDeviceAction_Click"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>

                                                <TextBlock x:Name="BtEmptyText" Text="Устройства не найдены" FontSize="9.8" Foreground="#71717A" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,2"/>
                                                <TextBlock x:Name="SysBatterySummaryText" Text="" FontSize="9.6" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,3,0,0" Visibility="Collapsed"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Collapsible Section 1: Drives (Matching Control Center Collapsibles) -->
                                    <Button x:Name="SysDrivesToggleBtn" Content="Локальные диски ▾" Style="{StaticResource DarkButton}" Background="#15161A" BorderBrush="#24252C" HorizontalAlignment="Stretch" Padding="10,7" FontSize="10.8" Foreground="#A1A1AA" Margin="0,0,0,6" Click="SysDrivesToggle_Click"/>

                                    <StackPanel x:Name="SysDrivesSection" Visibility="Collapsed" Margin="0,2,0,4">
                                        <ItemsControl x:Name="DrivesItemsControl">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="2"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="14" Padding="11,9" Margin="0,0,6,6" Cursor="Hand" Tag="{Binding RootPath}" MouseLeftButtonUp="OpenDrive_Click" ToolTip="Нажмите, чтобы открыть диск">
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,3">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Border Width="18" Height="18" CornerRadius="6" Background="{Binding BadgeBgHex}" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                        <Path Data="M 4,7 H 14 L 16,13 H 2 Z M 3,13 H 15 V 15 H 3 Z" Stroke="{Binding AccentHex}" StrokeThickness="1.3" StrokeLineJoin="Round" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Name}" FontSize="11.2" FontWeight="SemiBold" Foreground="#F4F4F5" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding Label}" FontSize="9.5" Foreground="#71717A" MaxWidth="78" TextTrimming="CharacterEllipsis" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding PercentLabel}" FontSize="13.5" FontWeight="Bold" Foreground="{Binding AccentHex}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            </Grid>
                                                            <TextBlock Text="{Binding SpaceSummary}" FontSize="9.6" Foreground="#8E9099" TextTrimming="CharacterEllipsis" Margin="0,0,0,7"/>
                                                            <Border Height="3.5" CornerRadius="1.8" Background="#23242B" ClipToBounds="True">
                                                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding UsedPercent}" Height="3.5" Foreground="{Binding AccentHex}" Background="Transparent" BorderThickness="0"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Collapsible Section 2: Top Heavy Processes -->
                                    <Button x:Name="SysProcessesToggleBtn" Content="Процессы по ОЗУ (Топ-3) ▾" Style="{StaticResource DarkButton}" Background="#15161A" BorderBrush="#24252C" HorizontalAlignment="Stretch" Padding="10,7" FontSize="10.8" Foreground="#A1A1AA" Click="SysProcessesToggle_Click"/>

                                    <StackPanel x:Name="SysProcessesSection" Visibility="Collapsed" Margin="0,7,0,0">
                                        <ItemsControl x:Name="TopProcessesList" Margin="0,0,0,2">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="10" Padding="9,5.5" Margin="0,0,0,4">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Medium" Foreground="#E4E4E7" MaxWidth="250" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding MemoryFormatted}" FontSize="11" Foreground="#8E9099" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                <Button Content="✕" Style="{StaticResource DarkButton}" Background="#3A1D24" Foreground="#FCA5A5" Padding="6,1.5" FontSize="10" Tag="{Binding}" Click="KillProcess_Click" ToolTip="Завершить процесс"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>

                                <!-- 3B. SCREEN TIME, FOCUS TIMER & GAME TELEMETRY TAB -->
                                <StackPanel x:Name="ScreenTimePanel" Visibility="Collapsed">
                                    <!-- HERO SCREEN TIME SUMMARY CARD -->
                                    <Border BorderBrush="#272A36" BorderThickness="1" CornerRadius="18" Padding="15,12" Margin="0,0,0,9">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#1F2438" Offset="0"/>
                                                <GradientStop Color="#14151B" Offset="0.6"/>
                                                <GradientStop Color="#121317" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="АКТИВНОСТЬ СЕССИИ" FontSize="9.2" FontWeight="Bold" Foreground="#71717A" VerticalAlignment="Center"/>
                                                <Border Background="#14291E" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6" Fill="#4ADE80" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="ScreenTimeNowAppText" Text="Активно" FontSize="9.5" FontWeight="SemiBold" Foreground="#86EFAC" MaxWidth="145" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <Grid Margin="0,2,0,10">
                                                <TextBlock x:Name="ScreenTimeTotalText" Text="0с" FontSize="26" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Bottom"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                    <Border Background="#1B1D27" CornerRadius="9" Padding="8,4" Margin="0,0,6,0">
                                                        <StackPanel>
                                                            <TextBlock Text="Игры" FontSize="8.8" Foreground="#A78BFA"/>
                                                            <TextBlock x:Name="ScreenTimeGamesTotalText" Text="0с" FontSize="12" FontWeight="Bold" Foreground="#F4F4F5"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="#1B1D27" CornerRadius="9" Padding="8,4">
                                                        <StackPanel>
                                                            <TextBlock Text="Программ" FontSize="8.8" Foreground="#60A5FA"/>
                                                            <TextBlock x:Name="ScreenTimeAppsCountText" Text="0" FontSize="12" FontWeight="Bold" Foreground="#F4F4F5"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Dynamic Segmented Category Bar (Games vs Apps) -->
                                            <Border Height="6" CornerRadius="3" Background="#232530" ClipToBounds="True">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition x:Name="ScreenTimeGamesBarCol" Width="0*"/>
                                                        <ColumnDefinition x:Name="ScreenTimeAppsBarCol" Width="1*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="#A855F7" CornerRadius="3,0,0,3"/>
                                                    <Border Grid.Column="1" Background="#38BDF8" CornerRadius="0,3,3,0"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Ellipse Width="6" Height="6" Fill="#A855F7" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="ScreenTimeLastGameText" Text="Игр не было" FontSize="9.5" Foreground="#A1A1AA" Margin="0,0,12,0" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                                                <Ellipse Width="6" Height="6" Fill="#38BDF8" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Приложения и работа" FontSize="9.5" Foreground="#A1A1AA"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- INTERACTIVE FOCUS / POMODORO TIMER CARD -->
                                    <Border Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="14" Padding="12,9" Margin="0,0,0,9">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="28" Height="28" CornerRadius="9" Background="#2A1C16" Margin="0,0,9,0">
                                                    <TextBlock Text="🍅" FontSize="13.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Фокус-таймер" FontSize="10.8" FontWeight="SemiBold" Foreground="#F4F4F5"/>
                                                    <TextBlock x:Name="FocusTimerStatusText" Text="Напоминание о перерыве выкл." FontSize="9.5" Foreground="#8E9099"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Content="15м" Style="{StaticResource DarkButton}" Padding="8,3.5" FontSize="9.8" Margin="0,0,4,0" Tag="15" Click="StartFocusTimer_Click"/>
                                                <Button Content="25м" Style="{StaticResource AccentButton}" Background="#EA580C" Padding="8,3.5" FontSize="9.8" Margin="0,0,4,0" Tag="25" Click="StartFocusTimer_Click"/>
                                                <Button Content="45м" Style="{StaticResource DarkButton}" Padding="8,3.5" FontSize="9.8" Margin="0,0,4,0" Tag="45" Click="StartFocusTimer_Click"/>
                                                <Button x:Name="StopFocusTimerBtn" Content="Стоп" Style="{StaticResource DarkButton}" Padding="7,3.5" FontSize="9.8" Visibility="Collapsed" Click="StopFocusTimer_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- LIVE GAME TELEMETRY CARD -->
                                    <Border Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="14" Padding="11,8" Margin="0,0,0,9">
                                        <Grid>
                                            <TextBlock x:Name="GameStatsDetailText" Text="Запустите игру — здесь появятся средний FPS, 1% Low и температура GPU" FontSize="10.2" Foreground="#8E9099" TextWrapping="Wrap"/>
                                            <WrapPanel x:Name="GameStatsBadgesPanel" Orientation="Horizontal" Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>

                                    <!-- APPS BREAKDOWN LIST -->
                                    <Grid Margin="2,0,2,6">
                                        <TextBlock Text="ТОП ПРИЛОЖЕНИЙ" FontSize="9.2" FontWeight="Bold" Foreground="#71717A" VerticalAlignment="Center"/>
                                        <Button Content="Сбросить" Style="{StaticResource DarkButton}" Padding="8,2.5" FontSize="9.5" HorizontalAlignment="Right" Click="ResetScreenTime_Click"/>
                                    </Grid>
                                    <ItemsControl x:Name="ScreenTimeListControl" Margin="0,0,0,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#15161A" BorderBrush="#22242C" BorderThickness="1" CornerRadius="12" Padding="10,7" Margin="0,0,0,5">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="5"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0" Margin="0,0,0,5">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Border Width="22" Height="22" CornerRadius="7" Background="#20222C" Margin="0,0,8,0">
                                                                    <TextBlock Text="{Binding IconLabel}" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding ProcessName}" FontSize="11.5" FontWeight="SemiBold" Foreground="#F4F4F5" MaxWidth="205" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding SubLabel}" FontSize="10.5" FontWeight="Medium" Foreground="#9CA3AF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <Border Grid.Row="1" Height="4" CornerRadius="2" Background="#232530" ClipToBounds="True">
                                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding SharePercent}" Height="4" Foreground="{DynamicResource AccentBrightBrush}" Background="Transparent" BorderThickness="0"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock x:Name="ScreenTimeEmptyText" Text="Накапливаем статистику активных окон..." FontSize="10.5" Foreground="#71717A" HorizontalAlignment="Center" Margin="0,6" Visibility="Visible"/>

                                    <!-- QUICK CHECKLIST NOTES -->
                                    <Border Background="#15161A" BorderBrush="#24252C" BorderThickness="1" CornerRadius="14" Padding="11,9" Margin="0,7,0,0">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,7">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="20" Height="20" CornerRadius="6" Background="#16283B" Margin="0,0,7,0">
                                                        <Path Data="M 5,12 L 9.5,16.5 L 19,7" Stroke="#38BDF8" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="БЫСТРЫЕ ЗАМЕТКИ" FontSize="9.2" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock x:Name="QuickNotesCountText" Text="" FontSize="9" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="QuickNoteInputBox" Grid.Column="0" Background="#0D0E12" Foreground="#F4F4F5" BorderBrush="#262934" BorderThickness="1" Padding="8,4.5" FontSize="10.8" CaretBrush="#38BDF8" KeyDown="QuickNoteInputBox_KeyDown" TextChanged="QuickNoteInputBox_TextChanged"/>
                                                <TextBlock x:Name="QuickNotePlaceholder" Grid.Column="0" Text="Добавить задачу или заметку..." FontSize="10" Foreground="#64748B" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                                <Button Grid.Column="1" Content="+" Style="{StaticResource AccentButton}" Padding="10,3.5" FontSize="12" FontWeight="Bold" Margin="6,0,0,0" Click="AddQuickNote_Click" ToolTip="Добавить заметку"/>
                                            </Grid>
                                            <StackPanel x:Name="QuickNotesListPanel"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- 5. CLEANER & RAM TAB (Redesigned Hero Health Banner + Vibrant Category Cards) -->
                                <StackPanel x:Name="CleanerPanel" Visibility="Collapsed">
                                    <!-- HERO STORAGE & RAM CARD -->
                                    <Border CornerRadius="18" BorderBrush="#263147" BorderThickness="1" Padding="14,12" Margin="0,0,0,10">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#142238" Offset="0"/>
                                                <GradientStop Color="#141822" Offset="0.58"/>
                                                <GradientStop Color="#111319" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,2">
                                                        <Border x:Name="CleanerScanBadge" Background="#162E24" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="7" Padding="6,1" Margin="0,0,7,0">
                                                            <TextBlock x:Name="CleanerScanBadgeText" Text="ГОТОВО" FontSize="8.5" FontWeight="Bold" Foreground="#4ADE80"/>
                                                        </Border>
                                                        <TextBlock Text="МОЖНО ОСВОБОДИТЬ" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                                        <TextBlock x:Name="CleanerHeroTotalText" Text="0 МБ" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC" LineHeight="26"/>
                                                        <TextBlock x:Name="CleanerHeroSubText" Text="мусора и кэша" FontSize="10.2" Foreground="#94A3B8" Margin="8,0,0,3" VerticalAlignment="Bottom"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Style="{StaticResource DarkButton}" Background="#1E2534" BorderBrush="#2D364B" Padding="9,5" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Top" Click="RefreshCleanup_Click" ToolTip="Пересканировать временные файлы">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="M 4,12 A 8,8 0 0 1 18,6.8 M 18,3 V 7 H 14 M 20,12 A 8,8 0 0 1 6,17.2 M 6,21 V 17 H 10" Stroke="#38BDF8" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11.5" Height="11.5" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Скан" FontSize="10" FontWeight="Medium" Foreground="#E2E8F0"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>

                                            <!-- Live RAM Gauge inside Hero -->
                                            <Border Background="#0E1118" BorderBrush="#212736" BorderThickness="1" CornerRadius="11" Padding="10,7">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,5">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="⚡ Оперативная память (ОЗУ)" FontSize="10" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                                                        </StackPanel>
                                                        <TextBlock x:Name="CleanerRamPercentText" Text="—%" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <Border Height="5" CornerRadius="2.5" Background="#1D2230" ClipToBounds="True">
                                                        <ProgressBar x:Name="CleanerRamGaugeBar" Minimum="0" Maximum="100" Value="0" Height="5" Foreground="#38BDF8" Background="Transparent" BorderThickness="0"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="2,0,2,5">
                                        <TextBlock Text="КАТЕГОРИИ ОЧИСТКИ · ПАРОЛИ НЕ ТРОГАЮТСЯ" FontSize="9" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </Grid>

                                    <ItemsControl x:Name="CleanupItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#161820" BorderBrush="#242733" BorderThickness="1" CornerRadius="13" Padding="10,7.5" Margin="0,0,0,5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="10" Background="{Binding AccentBgHex}" Margin="0,0,10,0" VerticalAlignment="Center">
                                                            <Path Data="{Binding IconData}" Stroke="{Binding AccentHex}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" Foreground="#F1F5F9" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="9.4" Foreground="#71717A" TextTrimming="CharacterEllipsis" MaxWidth="255"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="2" Background="#1F2330" BorderBrush="#2C3142" BorderThickness="1" CornerRadius="8" Padding="7,2.5" Margin="0,0,8,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding SizeFormatted}" FontSize="10.2" FontWeight="SemiBold" Foreground="{Binding AccentHex}"/>
                                                        </Border>
                                                        <CheckBox Grid.Column="3" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Cursor="Hand" Click="CleanupCategoryCheck_Click"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Auto-Boost RAM Status Card -->
                                    <Border x:Name="CleanerAutoRamCard" Background="#121D19" BorderBrush="#20382D" BorderThickness="1" CornerRadius="13" Padding="11,8" Margin="0,4,0,0">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="24" Height="24" CornerRadius="8" Background="#173326" Margin="0,0,8,0">
                                                    <Path Data="M 13,2 L 4,13 H 11 L 9,22 L 20,10 H 12.5 Z" Fill="#34D399" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock x:Name="AutoRamStatusText" Text="Авто-буст ОЗУ: Вкл (порог 80% + фон)" FontSize="10.4" FontWeight="Medium" Foreground="#A7F3D0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Button Content="Переключить" Style="{StaticResource DarkButton}" Background="#192A22" BorderBrush="#284637" Padding="9,3" FontSize="9.5" HorizontalAlignment="Right" Click="ToggleAutoRamQuick_Click" ToolTip="Включить / выключить авто-буст ОЗУ (порог задаётся в настройках ⚙)"/>
                                        </Grid>
                                    </Border>

                                    <!-- Bottom Dual Action Bar -->
                                    <Grid Margin="0,9,0,0">
                                        <TextBlock x:Name="CleanupStatusText" Text="Нажмите «Очистить выбранное»" FontSize="10.2" Foreground="#94A3B8" VerticalAlignment="Center" MaxWidth="195" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="CleanNowBtn" Content="🧹 Очистить выбранное" Style="{StaticResource AccentButton}" Padding="13,6.5" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0" Click="CleanNow_Click"/>
                                            <Button x:Name="OptimizeRamBtn" Content="⚡ Буст ОЗУ" Style="{StaticResource DarkButton}" Background="#18222F" BorderBrush="#27364B" Padding="11,6.5" FontSize="11" FontWeight="SemiBold" Click="OptimizeRam_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Border>

            <!-- QUICK ACTION PILLS ROW (Hidden: single clean main island only) -->
            <StackPanel x:Name="SideActionStrip"
                        Orientation="Horizontal"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed"
                        MouseEnter="SideActionStrip_MouseEnter"
                        MouseLeave="IslandHoverZone_MouseLeave">
            <!-- INDEPENDENT RIGHT-SIDE RAM CIRCLE / PILL (Visible normally, hidden in idle eyes mode) -->
            <Border x:Name="RamQuickPill"
                    Height="36"
                    Width="36"
                    CornerRadius="18"
                    Margin="6,2,0,0"
                    VerticalAlignment="Top"
                    Background="#FC090A0D"
                    BorderBrush="#24252C"
                    BorderThickness="1"
                    ClipToBounds="True"
                    Cursor="Hand"
                    MouseLeftButtonUp="RamQuickPill_Click"
                    MouseEnter="RamQuickPill_MouseEnter"
                    MouseLeave="RamQuickPill_MouseLeave">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0">
                    <Path x:Name="RamLightningPath"
                          Width="13"
                          Height="15"
                          Stretch="Uniform"
                          Stroke="Transparent"
                          StrokeThickness="1.2"
                          StrokeLineJoin="Round"
                          Data="M 8,0 L 1,9 L 6.5,9 L 5,16 L 13,6.5 L 7.5,6.5 Z"
                          VerticalAlignment="Center">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                                <GradientStop x:Name="LightningFillStop1" Color="#FACC15" Offset="0.0"/>
                                <GradientStop x:Name="LightningFillStop2" Color="#64748B" Offset="0.0"/>
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                    <TextBlock x:Name="RamQuickText"
                               Text="ОЗУ"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="#E2E8F0"
                               Margin="5,0,0,0"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- QUICK MIC MUTE PILL (Visible when expanded or in fullscreen games, flush notch style) -->
            <Border x:Name="GameMicPill"
                    Height="30"
                    Width="30"
                    CornerRadius="0,0,15,15"
                    Margin="5,0,0,0"
                    VerticalAlignment="Top"
                    Background="#FC090A0D"
                    BorderBrush="#24252C"
                    BorderThickness="1,0,1,1"
                    Visibility="Collapsed"
                    Cursor="Hand"
                    ToolTip="Быстрый Mute микрофона (удерживайте Alt + клик в игре)"
                    MouseLeftButtonUp="GameMicPill_Click"
                    MouseEnter="GameMicPill_MouseEnter"
                    MouseLeave="GameMicPill_MouseLeave">
                <Viewbox x:Name="GameMicViewbox" Width="9.5" Height="9.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Data="M12,2 A3,3 0 0 1 15,5 V11 A3,3 0 0 1 9,11 V5 A3,3 0 0 1 12,2 Z"
                              x:Name="MicCapsulePath" Fill="#E2E8F0"/>
                        <Path Data="M6,10 A6,6 0 0 0 18,10 M12,16 V20 M8.5,20 H15.5"
                              x:Name="MicStandPath" Stroke="#E2E8F0" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Line x:Name="MicSlashLine" X1="4" Y1="4" X2="20" Y2="20" Stroke="#F87171" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                    </Canvas>
                </Viewbox>
            </Border>

            <!-- QUICK 30s REPLAY CLIP PILL (Visible in fullscreen games, matches flush notch style) -->
            <Border x:Name="ReplayClipPill"
                    Height="15"
                    Width="30"
                    CornerRadius="0,0,7.5,7.5"
                    Margin="5,0,0,0"
                    VerticalAlignment="Top"
                    Background="#FC090A0D"
                    BorderBrush="#24252C"
                    BorderThickness="1,0,1,1"
                    Visibility="Collapsed"
                    Cursor="Hand"
                    ToolTip="Сохранить 30с игровой клип (Alt+F10 / Win+Alt+G)"
                    MouseLeftButtonUp="ReplayClipBtn_Click"
                    MouseEnter="ReplayClipPill_MouseEnter"
                    MouseLeave="ReplayClipPill_MouseLeave">
                <Viewbox x:Name="ReplayClipViewbox" Width="9.5" Height="9.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Data="M3,7 A2,2 0 0 1 5,5 H14 A2,2 0 0 1 16,7 V17 A2,2 0 0 1 14,19 H5 A2,2 0 0 1 3,17 Z M16,10 L21,7 V17 L16,14 Z"
                              Fill="#E2E8F0"/>
                        <Ellipse Canvas.Left="7.5" Canvas.Top="10" Width="4" Height="4" Fill="#F87171"/>
                    </Canvas>
                </Viewbox>
            </Border>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
