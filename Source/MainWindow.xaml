<Window x:Class="DesktopIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Island"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MouseWheel="Window_MouseWheel"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#0EA5E9"/>
        <SolidColorBrush x:Key="AccentBrightBrush" Color="#38BDF8"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#1E3A5F"/>

        <Style x:Key="TabPillButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#252736"/>
                                <Setter Property="Foreground" Value="#E2E8F0"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubPillButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Background" Value="#161722"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#282B3C" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrightBrush}"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#232433"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#313347"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconToggleButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="#232433"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#313347"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box" Width="15" Height="15" CornerRadius="4" Background="#1D1F2C" BorderBrush="#3B3F56" BorderThickness="1.2" Margin="0,0,7,0">
                                <Path x:Name="Tick" Data="M 3,7.5 L 6,10.5 L 12,4" Stroke="#FFFFFF" StrokeThickness="1.8" Visibility="Collapsed" StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrightBrush}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#2D3044" CornerRadius="2.5"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- No Background & no DropShadow shader box so nothing forms a translucent rectangle around rounded pills -->
    <Grid x:Name="RootCanvasContainer" Margin="2">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Center">
            <!-- Rounded 2px early-trigger hover halo strictly hugging the rounded island -->
            <Border x:Name="IslandHoverZone"
                    Padding="2"
                    CornerRadius="20"
                    Background="#01000000"
                    VerticalAlignment="Top"
                    MouseEnter="IslandHoverZone_MouseEnter"
                    MouseLeave="IslandHoverZone_MouseLeave">

                <!-- MAIN ISLAND CAPSULE -->
                <Border x:Name="IslandBorder"
                        Width="380"
                        Height="36"
                        CornerRadius="18"
                        Background="#FC0D0E14"
                        BorderBrush="#2E3245"
                        BorderThickness="1"
                        ClipToBounds="True"
                        PreviewMouseLeftButtonDown="Island_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="Island_PreviewMouseMove"
                        PreviewMouseLeftButtonUp="Island_PreviewMouseLeftButtonUp">

                    <Grid VerticalAlignment="Top">
                        <!-- COMPACT BAR -->
                        <Grid x:Name="CompactContentGrid" Height="36" VerticalAlignment="Top" Visibility="Visible">
                            <!-- Normal metrics strip -->
                            <StackPanel x:Name="CompactMetricsStrip"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="12,0">
                                <Ellipse x:Name="StatusDot" Width="6.5" Height="6.5" Fill="{DynamicResource AccentBrightBrush}" Margin="0,0,7,0" VerticalAlignment="Center" ToolTip="Статус островка"/>

                                <TextBlock x:Name="CompactTimeText" Text="12:00" FontSize="12.5" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CompactSessionText" Text="" FontSize="10.5" Foreground="#64748B" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <TextBlock x:Name="CompactWeatherText" Text="" FontSize="11" Foreground="#94A3B8" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>

                                <Border x:Name="CompactTimerPill" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="6,1.5" Margin="6,0,0,0" Visibility="Collapsed" VerticalAlignment="Center">
                                    <TextBlock x:Name="CompactTimerText" Text="⏱ 25:00" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrightBrush}"/>
                                </Border>

                                <TextBlock x:Name="CompactSep1" Text="·" FontSize="12" Foreground="#475569" Margin="6,0" VerticalAlignment="Center"/>

                                <!-- FPS left of CPU, highlighted in accent blue -->
                                <TextBlock x:Name="CompactFpsText" Text="0 FPS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrightBrush}" VerticalAlignment="Center" Margin="0,0,5,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="CompactSysText" Text="CPU 0% · RAM 0%" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CompactPingText" Text="" FontSize="10.5" Foreground="#64748B" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>

                                <!-- Live mini audio equalizer -->
                                <StackPanel x:Name="CompactEqPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed" Height="14">
                                    <Border x:Name="EqBar1" Width="2.5" Height="4" CornerRadius="1.2" Background="{DynamicResource AccentBrightBrush}" VerticalAlignment="Bottom" Margin="0,0,1.5,2"/>
                                    <Border x:Name="EqBar2" Width="2.5" Height="9" CornerRadius="1.2" Background="{DynamicResource AccentBrightBrush}" VerticalAlignment="Bottom" Margin="0,0,1.5,2"/>
                                    <Border x:Name="EqBar3" Width="2.5" Height="6" CornerRadius="1.2" Background="{DynamicResource AccentBrightBrush}" VerticalAlignment="Bottom" Margin="0,0,1.5,2"/>
                                    <Border x:Name="EqBar4" Width="2.5" Height="10" CornerRadius="1.2" Background="{DynamicResource AccentBrightBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                </StackPanel>

                                <TextBlock x:Name="CompactNetText" Text="" FontSize="10.5" Foreground="{DynamicResource AccentBrightBrush}" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </StackPanel>

                            <!-- Dynamic Toast overlay inside compact bar -->
                            <Grid x:Name="CompactToastStrip" Visibility="Collapsed" Margin="14,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="CompactToastIcon" Text="✨" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="CompactToastText" Text="" FontSize="11.5" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" MaxWidth="270" TextTrimming="CharacterEllipsis"/>
                                    <Button x:Name="CompactToastActionBtn" Content="Открыть" Style="{StaticResource AccentButton}" Padding="8,2" FontSize="10.5" Margin="8,0,0,0" Visibility="Collapsed" Click="CompactToastAction_Click"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- EXPANDED PANEL -->
                        <Grid x:Name="ExpandedContentGrid" Visibility="Collapsed" Margin="14,10,14,12" VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header Bar (Transparent #01000000 lets empty gap drag smoothly) -->
                            <Grid Grid.Row="0" Margin="0,0,0,8" Background="#01000000">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="ExpandedStatusDot" Width="7" Height="7" Fill="{DynamicResource AccentBrightBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ExpandedTimeText" Text="12:00:00" FontSize="14.5" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ExpandedDateText" Text="сегодня" FontSize="11.5" Foreground="#64748B" Margin="8,1,0,0" VerticalAlignment="Center"/>

                                    <Border x:Name="ExpandedToastPill" Background="{DynamicResource AccentSoftBrush}" CornerRadius="9" Padding="7,2" Margin="8,0,0,0" Visibility="Collapsed" VerticalAlignment="Center">
                                        <TextBlock x:Name="ExpandedToastText" Text="" FontSize="10.5" Foreground="{DynamicResource AccentBrightBrush}"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="CenterPosBtn" Style="{StaticResource DarkButton}" Padding="0" Width="26" Height="26" Margin="0,0,5,0" Visibility="Collapsed" ToolTip="Отцентровать островок по центру экрана" Click="CenterPosBtn_Click">
                                        <Border CornerRadius="13" Width="26" Height="26">
                                            <TextBlock Text="⌖" FontSize="13.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Button>
                                    <ToggleButton x:Name="EditAppsBtn" Style="{StaticResource IconToggleButton}" ToolTip="Редактировать приложения (порядок / добавление / удаление)" Margin="0,0,5,0" Checked="EditAppsBtn_Changed" Unchecked="EditAppsBtn_Changed">
                                        <TextBlock Text="✎" FontSize="12"/>
                                    </ToggleButton>
                                    <Button x:Name="EyeTopmostBtn" Width="26" Height="26" Margin="0,0,5,0" Cursor="Hand" ToolTip="Поверх всех окон" Click="EyeTopmostBtn_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" CornerRadius="13" Background="#232433">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#313347"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Border x:Name="EyeBtnBorder" Width="26" Height="26" CornerRadius="13" BorderThickness="1" BorderBrush="#38BDF8">
                                            <Viewbox Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path x:Name="EyeOuterPath"
                                                          Data="M 2,12 C 5,6.5 9,4.5 12,4.5 C 15,4.5 19,6.5 22,12 C 19,17.5 15,19.5 12,19.5 C 9,19.5 5,17.5 2,12 Z"
                                                          Stroke="#38BDF8" StrokeThickness="2" StrokeLineJoin="Round" Fill="#2038BDF8"/>
                                                    <Ellipse x:Name="EyePupil" Canvas.Left="9.2" Canvas.Top="9.2" Width="5.6" Height="5.6" Fill="#F8FAFC"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                    </Button>
                                    <ToggleButton x:Name="PinBtn" Style="{StaticResource IconToggleButton}" ToolTip="Закрепить панель открытой" Margin="0,0,5,0" Click="PinBtn_Click">
                                        <TextBlock Text="📌" FontSize="11"/>
                                    </ToggleButton>
                                    <Button Style="{StaticResource DarkButton}" Padding="0" Width="26" Height="26" ToolTip="Настройки Desktop Island" Click="SettingsBtn_Click">
                                        <Border CornerRadius="13" Width="26" Height="26">
                                            <TextBlock Text="⚙" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Non-Admin Warning Banner -->
                            <Border x:Name="AdminWarningBanner"
                                    Grid.Row="1"
                                    Background="#24F59E0B"
                                    BorderBrush="#88F59E0B"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="9,6"
                                    Margin="0,0,0,8"
                                    Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="🛡" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Запущено без прав админа — для FPS и авто-буста лучше запустить от администратора"
                                                   FontSize="10.5"
                                                   Foreground="#FDE68A"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button x:Name="RestartAsAdminBtn"
                                            Grid.Column="1"
                                            Content="От админа"
                                            Style="{StaticResource AccentButton}"
                                            Background="#D97706"
                                            Padding="10,4"
                                            FontSize="10.5"
                                            VerticalAlignment="Center"
                                            ToolTip="Перезапустить Desktop Island с правами администратора"
                                            Click="RestartAsAdmin_Click"/>
                                </Grid>
                            </Border>

                            <!-- Navigation Tab Pills -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,9">
                                <RadioButton x:Name="TabApps" Content="Запуск" Style="{StaticResource TabPillButton}" IsChecked="True" Checked="Tab_Checked"/>
                                <RadioButton x:Name="TabRemote" Content="Пульт" Style="{StaticResource TabPillButton}" Checked="Tab_Checked"/>
                                <RadioButton x:Name="TabSystem" Content="Система" Style="{StaticResource TabPillButton}" Checked="Tab_Checked"/>
                                <RadioButton x:Name="TabScreenTime" Content="Экранное время" Style="{StaticResource TabPillButton}" Checked="Tab_Checked" ToolTip="Статистика экранного времени и игр за сессию"/>
                                <RadioButton x:Name="TabCleaner" Content="Очистка" Style="{StaticResource TabPillButton}" Margin="0" Checked="Tab_Checked"/>
                            </StackPanel>

                            <!-- TAB BODY -->
                            <Grid Grid.Row="3" VerticalAlignment="Top">
                                <!-- 1. LAUNCH APPS TAB (Max 4 per row, auto-fit height) -->
                                <StackPanel x:Name="AppsPanel" Visibility="Visible">
                                    <WrapPanel x:Name="AppsWrapPanel" Orientation="Horizontal" MaxWidth="414" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="AppsEditHintText"
                                               Text="Режим правки: перетаскивайте иконки мышкой для смены порядка"
                                               FontSize="10.5"
                                               Foreground="#64748B"
                                               Margin="4,4,0,0"
                                               Visibility="Collapsed"/>
                                </StackPanel>

                                <!-- 2. REMOTE CONTROL TAB ("Пульт": Медиа + Звук + Bluetooth + Таймер + Быстрые кнопки) -->
                                <StackPanel x:Name="RemotePanel" Visibility="Collapsed">
                                    <!-- Now Playing Card -->
                                    <Border Background="#161722" BorderBrush="#242738" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,0,0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <TextBlock Text="🎵" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="MediaTitleText" Text="Ничего не воспроизводится" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" MaxWidth="215"/>
                                                </StackPanel>
                                                <TextBlock x:Name="MediaArtistText" Text="Включите музыку или видео в любом плеере" FontSize="10.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" MaxWidth="225"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="⏮" Style="{StaticResource DarkButton}" Width="28" Height="28" Padding="0" Margin="0,0,4,0" Click="MediaPrev_Click" ToolTip="Предыдущий трек"/>
                                                <Button x:Name="MediaPlayPauseBtn" Content="⏯" Style="{StaticResource AccentButton}" Width="32" Height="28" Padding="0" Margin="0,0,4,0" Click="MediaPlayPause_Click" ToolTip="Воспроизведение / Пауза"/>
                                                <Button Content="⏭" Style="{StaticResource DarkButton}" Width="28" Height="28" Padding="0" Click="MediaNext_Click" ToolTip="Следующий трек"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Audio Output, Volume & Mic Privacy Row -->
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="7"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#161722" BorderBrush="#242738" BorderThickness="1" CornerRadius="12" Padding="10,7">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0" Margin="0,0,0,5">
                                                    <TextBlock x:Name="VolumePercentText" Text="🔊 Громкость: —%" FontSize="11" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                                    <Button x:Name="AudioSwitchBtn" Content="🎧 Вывод" HorizontalAlignment="Right" Style="{StaticResource DarkButton}" Padding="7,2" FontSize="10.5" Click="SwitchAudioOutput_Click" ToolTip="Переключить устройство вывода"/>
                                                </Grid>
                                                <Slider x:Name="MasterVolumeSlider" Grid.Row="1" Minimum="0" Maximum="100" ValueChanged="MasterVolumeSlider_ValueChanged" IsMoveToPointEnabled="True"/>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="2" Background="#161722" BorderBrush="#242738" BorderThickness="1" CornerRadius="12" Padding="9,7" Width="136">
                                            <StackPanel VerticalAlignment="Center">
                                                <Button x:Name="MicMuteBtn" Content="🎙 Микрофон: Вкл" Style="{StaticResource DarkButton}" Padding="6,4" FontSize="10.5" Click="ToggleMicMute_Click"/>
                                                <TextBlock x:Name="PrivacyStatusText" Text="🔒 Камера и мик свободны" FontSize="9.8" Foreground="#64748B" Margin="2,5,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Bluetooth Control & Devices -->
                                    <Border Background="#161722" BorderBrush="#242738" BorderThickness="1" CornerRadius="12" Padding="10,7" Margin="0,0,0,7">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,5">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Bluetooth" FontSize="11.5" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="BtStateText" Text="· проверка..." FontSize="10.5" Foreground="#94A3B8" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button x:Name="BtExpandBtn" Content="Все ▾" Style="{StaticResource DarkButton}" Padding="7,3" FontSize="10" Margin="0,0,4,0" ToolTip="Показать / скрыть все устройства" Click="BtExpandBtn_Click"/>
                                                    <Button x:Name="BtToggleBtn" Content="Вкл / Выкл" Style="{StaticResource DarkButton}" Padding="8,3" FontSize="10.5" Margin="0,0,4,0" Click="ToggleBluetooth_Click"/>
                                                    <Button Content="⚙" Style="{StaticResource DarkButton}" Padding="7,3" FontSize="10.5" ToolTip="Параметры Bluetooth" Click="OpenBtSettings_Click"/>
                                                </StackPanel>
                                            </Grid>

                                            <ItemsControl x:Name="BtDevicesList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#1D1F2C" CornerRadius="8" Padding="8,4.5" Margin="0,0,0,4">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Medium" Foreground="#F1F5F9" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding StatusLabel}" FontSize="9.8" Foreground="#94A3B8"/>
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Content="{Binding ActionLabel}" Style="{StaticResource DarkButton}" Padding="8,3" FontSize="10" Tag="{Binding}" Click="BtDeviceAction_Click"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock x:Name="BtEmptyText" Text="Сопряжённые Bluetooth-устройства не найдены" FontSize="10" Foreground="#64748B" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,2"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Timer Row inside Пульт -->
                                    <Border Background="#161722" BorderBrush="#242738" BorderThickness="1" CornerRadius="12" Padding="10,7" Margin="0,0,0,7">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="⏱ Таймер:" FontSize="11.5" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TimerStatusText" Text="Выкл." FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrightBrush}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="5м" Style="{StaticResource DarkButton}" Padding="8,3" FontSize="10.5" Margin="0,0,4,0" Tag="5" Click="StartTimerPreset_Click"/>
                                                <Button Content="15м" Style="{StaticResource DarkButton}" Padding="8,3" FontSize="10.5" Margin="0,0,4,0" Tag="15" Click="StartTimerPreset_Click"/>
                                                <Button Content="25м" Style="{StaticResource AccentButton}" Padding="8,3" FontSize="10.5" Margin="0,0,4,0" Tag="25" Click="StartTimerPreset_Click"/>
                                                <Button Content="Стоп" Style="{StaticResource DarkButton}" Padding="7,3" FontSize="10.5" Click="StopTimer_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Quick Actions Grid inside Пульт -->
                                    <UniformGrid Columns="3">
                                        <Button Style="{StaticResource DarkButton}" Margin="0,0,5,5" Padding="6,7" Click="PinExternalWindow_Click" ToolTip="Закрепить активное окно поверх остальных">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="📌" FontSize="13" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Окно поверх" FontSize="10" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource DarkButton}" Margin="0,0,5,5" Padding="6,7" Click="ToggleDesktopIcons_Click" ToolTip="Скрыть / показать иконки рабочего стола">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="🙈" FontSize="13" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Иконки стола" FontSize="10" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource DarkButton}" Margin="0,0,0,5" Padding="6,7" Click="TakeScreenshot_Click" ToolTip="Скриншот фрагмента экрана">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="📸" FontSize="13" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Скриншот" FontSize="10" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource DarkButton}" Margin="0,0,5,0" Padding="6,7" Click="LockPc_Click" ToolTip="Заблокировать ПК">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="🔒" FontSize="13" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Блокировка" FontSize="10" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource DarkButton}" Margin="0,0,5,0" Padding="6,7" Click="SleepPc_Click" ToolTip="Спящий режим">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="🌙" FontSize="13" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Сон ПК" FontSize="10" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource DarkButton}" Margin="0" Padding="6,7" Click="TurnOffScreen_Click" ToolTip="Выключить мониторы">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="🖥" FontSize="13" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Выкл. экран" FontSize="10" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>

                                <!-- 3. SYSTEM TAB (Полное раскрытие по заполненности без зажатого внутреннего скролла) -->
                                <StackPanel x:Name="SystemPanel" Visibility="Collapsed">
                                    <!-- Top Metrics Row -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#161722" BorderBrush="#242738" BorderThickness="1" CornerRadius="10" Padding="9,7">
                                            <StackPanel>
                                                <TextBlock Text="CPU / GPU / FPS" FontSize="10" Foreground="#64748B"/>
                                                <TextBlock x:Name="CpuValText" Text="0%" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                <TextBlock x:Name="FpsDetailText" Text="0 FPS" FontSize="10" Foreground="{DynamicResource AccentBrightBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="GpuDetailText" Text="" FontSize="9.5" Foreground="#94A3B8" Margin="0,1,0,0" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="#161722" BorderBrush="#242738" BorderThickness="1" CornerRadius="10" Padding="9,7">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="ОЗУ (RAM)" FontSize="10" Foreground="#64748B"/>
                                                    <TextBlock x:Name="RamValText" Text="0%" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                    <TextBlock x:Name="RamSubText" Text="0 / 0 ГБ" FontSize="10" Foreground="#94A3B8"/>
                                                </StackPanel>
                                                <Button Content="⚡" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource DarkButton}" Padding="5,2" FontSize="10.5" Click="OptimizeRam_Click" ToolTip="Оптимизировать ОЗУ"/>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="4" Background="#161722" BorderBrush="#242738" BorderThickness="1" CornerRadius="10" Padding="9,7">
                                            <StackPanel>
                                                <TextBlock x:Name="PingHeaderLabel" Text="Сеть · Ping" FontSize="10" Foreground="#64748B"/>
                                                <TextBlock x:Name="NetDownText" Text="↓ 0 КБ/с" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrightBrush}" Margin="0,2,0,0"/>
                                                <TextBlock x:Name="NetUpText" Text="↑ 0 КБ/с" FontSize="10.5" Foreground="#94A3B8"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Top 3 Heavy Processes -->
                                    <TextBlock Text="Топ-3 процесса по ОЗУ (быстрое завершение)" FontSize="10.5" Foreground="#64748B" Margin="2,0,0,4"/>
                                    <ItemsControl x:Name="TopProcessesList" Margin="0,0,0,6">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#161722" CornerRadius="8" Padding="8,4" Margin="0,0,0,3">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Medium" Foreground="#E2E8F0" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding MemoryFormatted}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <Button Content="✕" Style="{StaticResource DarkButton}" Background="#3A1D24" Foreground="#FCA5A5" Padding="6,1" FontSize="10" Tag="{Binding}" Click="KillProcess_Click" ToolTip="Завершить процесс"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Local Drives -->
                                    <TextBlock Text="Локальные диски" FontSize="10.5" Foreground="#64748B" Margin="2,2,0,4"/>
                                    <ItemsControl x:Name="DrivesItemsControl" Margin="0,0,0,6">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#161722" CornerRadius="8" Padding="9,6" Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="5"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11.5" Foreground="#F8FAFC"/>
                                                                <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#64748B" Margin="6,0,0,0"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <TextBlock FontSize="10.5" Foreground="#94A3B8" Margin="0,0,7,0" VerticalAlignment="Center">
                                                                    <Run Text="Свободно "/>
                                                                    <Run Text="{Binding FreeGb, StringFormat={}{0:F1}}" Foreground="#F8FAFC" FontWeight="SemiBold"/>
                                                                    <Run Text=" ГБ"/>
                                                                </TextBlock>
                                                                <Button Content="Открыть" Padding="7,2" FontSize="10" Style="{StaticResource DarkButton}" Tag="{Binding RootPath}" Click="OpenDrive_Click"/>
                                                            </StackPanel>
                                                        </Grid>
                                                        <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding UsedPercent}" Height="4" Foreground="{DynamicResource AccentBrush}" Background="#242738" BorderThickness="0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Recent Downloads -->
                                    <TextBlock Text="Недавние загрузки" FontSize="10.5" Foreground="#64748B" Margin="2,2,0,4"/>
                                    <ItemsControl x:Name="RecentDownloadsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource DarkButton}" Background="#161722" HorizontalContentAlignment="Stretch" Padding="8,4" Margin="0,0,0,3" Tag="{Binding FullPath}" Click="OpenRecentFile_Click" ToolTip="Открыть файл">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#CBD5E1" MaxWidth="250" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left"/>
                                                        <TextBlock FontSize="10" Foreground="#64748B" HorizontalAlignment="Right">
                                                            <Run Text="{Binding SizeFormatted}"/>
                                                            <Run Text=" · "/>
                                                            <Run Text="{Binding TimeLabel}"/>
                                                        </TextBlock>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- 3B. SCREEN TIME & GAME SESSION TAB -->
                                <StackPanel x:Name="ScreenTimePanel" Visibility="Collapsed">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#161722" BorderBrush="#242738" BorderThickness="1" CornerRadius="10" Padding="10,7">
                                            <StackPanel>
                                                <TextBlock Text="За сессию островка" FontSize="10" Foreground="#64748B"/>
                                                <TextBlock x:Name="ScreenTimeTotalText" Text="0с" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                <TextBlock x:Name="ScreenTimeAppsCountText" Text="Программ: 0" FontSize="10" Foreground="#94A3B8"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="#161722" BorderBrush="#242738" BorderThickness="1" CornerRadius="10" Padding="10,7">
                                            <StackPanel>
                                                <TextBlock Text="Игры за сессию" FontSize="10" Foreground="#64748B"/>
                                                <TextBlock x:Name="ScreenTimeGamesTotalText" Text="0с" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrightBrush}"/>
                                                <TextBlock x:Name="ScreenTimeLastGameText" Text="Игр не было" FontSize="10" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Background="#161722" BorderBrush="#262A3E" BorderThickness="1" CornerRadius="10" Padding="9,7" Margin="0,0,0,8">
                                        <TextBlock x:Name="GameStatsDetailText" Text="Полноэкранная игра в этой сессии пока не запускалась" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                                    </Border>

                                    <TextBlock Text="Активные программы и игры (за сессию)" FontSize="10.5" Foreground="#64748B" Margin="2,0,0,5"/>
                                    <ItemsControl x:Name="ScreenTimeListControl" Margin="0,0,0,8">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#161722" CornerRadius="8" Padding="9,6" Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="4"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding IconLabel}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding ProcessName}" FontSize="11" FontWeight="Medium" Foreground="#E2E8F0" MaxWidth="215" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding SubLabel}" FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding SharePercent}" Height="4" Foreground="{DynamicResource AccentBrush}" Background="#242738" BorderThickness="0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock x:Name="ScreenTimeEmptyText" Text="Пока нет данных об активных окнах" FontSize="11" Foreground="#64748B" Margin="2,2,0,6" Visibility="Visible"/>

                                    <Grid>
                                        <TextBlock Text="Считается активное окно на экране" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <Button Content="Сбросить" Style="{StaticResource DarkButton}" Padding="10,4" FontSize="10.5" HorizontalAlignment="Right" Click="ResetScreenTime_Click"/>
                                    </Grid>
                                </StackPanel>

                                <!-- 5. CLEANER & RAM TAB -->
                                <StackPanel x:Name="CleanerPanel" Visibility="Collapsed">
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Безопасная очистка (браузеры и пароли не трогаются)" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <Button Content="Обновить" Style="{StaticResource DarkButton}" Padding="8,2.5" FontSize="10.5" HorizontalAlignment="Right" Click="RefreshCleanup_Click"/>
                                    </Grid>
                                    <ItemsControl x:Name="CleanupItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#161722" CornerRadius="8" Padding="9,5" Margin="0,0,0,4">
                                                    <Grid>
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="Medium" Foreground="#E2E8F0"/>
                                                                <TextBlock Text="{Binding Description}" FontSize="9.8" Foreground="#64748B" TextTrimming="CharacterEllipsis" MaxWidth="270"/>
                                                            </StackPanel>
                                                        </CheckBox>
                                                        <TextBlock Text="{Binding SizeFormatted}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrightBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid Margin="0,7,0,0">
                                        <TextBlock x:Name="CleanupStatusText" Text="Нажмите «Очистить»" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" MaxWidth="165" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="CleanNowBtn" Content="Удалить файлы" Style="{StaticResource AccentButton}" Padding="11,6" Margin="0,0,5,0" Click="CleanNow_Click"/>
                                            <Button x:Name="OptimizeRamBtn" Content="⚡ ОЗУ" Style="{StaticResource DarkButton}" Padding="10,6" Click="OptimizeRam_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Border>

            <!-- INDEPENDENT RIGHT-SIDE RAM CIRCLE / PILL (Always Top-Aligned, no tooltip, yellow bolt stroke + blue pill border on hover, hides "ОЗУ" when collapsed) -->
            <Border x:Name="RamQuickPill"
                    Height="36"
                    Width="36"
                    CornerRadius="18"
                    Margin="6,2,0,0"
                    VerticalAlignment="Top"
                    Background="#FC0D0E14"
                    BorderBrush="#2E3245"
                    BorderThickness="1"
                    ClipToBounds="True"
                    Cursor="Hand"
                    MouseLeftButtonUp="RamQuickPill_Click"
                    MouseEnter="RamQuickPill_MouseEnter"
                    MouseLeave="RamQuickPill_MouseLeave">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0">
                    <Path x:Name="RamLightningPath"
                          Width="13"
                          Height="15"
                          Stretch="Uniform"
                          Stroke="Transparent"
                          StrokeThickness="1.2"
                          StrokeLineJoin="Round"
                          Data="M 8,0 L 1,9 L 6.5,9 L 5,16 L 13,6.5 L 7.5,6.5 Z"
                          VerticalAlignment="Center">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                                <GradientStop x:Name="LightningFillStop1" Color="#FACC15" Offset="0.0"/>
                                <GradientStop x:Name="LightningFillStop2" Color="#64748B" Offset="0.0"/>
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                    <TextBlock x:Name="RamQuickText"
                               Text="ОЗУ"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="#E2E8F0"
                               Margin="5,0,0,0"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- QUICK MIC MUTE PILL (Visible only in fullscreen games, flush notch style) -->
            <Border x:Name="GameMicPill"
                    Height="30"
                    Width="30"
                    CornerRadius="0,0,15,15"
                    Margin="5,0,0,0"
                    VerticalAlignment="Top"
                    Background="#FC0D0E14"
                    BorderBrush="#2E3245"
                    BorderThickness="1,0,1,1"
                    Visibility="Collapsed"
                    Cursor="Hand"
                    ToolTip="Быстрый Mute микрофона (удерживайте Alt + клик в игре)"
                    MouseLeftButtonUp="GameMicPill_Click"
                    MouseEnter="GameMicPill_MouseEnter"
                    MouseLeave="GameMicPill_MouseLeave">
                <Viewbox x:Name="GameMicViewbox" Width="9.5" Height="9.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Data="M12,2 A3,3 0 0 1 15,5 V11 A3,3 0 0 1 9,11 V5 A3,3 0 0 1 12,2 Z"
                              x:Name="MicCapsulePath" Fill="#E2E8F0"/>
                        <Path Data="M6,10 A6,6 0 0 0 18,10 M12,16 V20 M8.5,20 H15.5"
                              x:Name="MicStandPath" Stroke="#E2E8F0" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Line x:Name="MicSlashLine" X1="4" Y1="4" X2="20" Y2="20" Stroke="#F87171" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                    </Canvas>
                </Viewbox>
            </Border>
        </StackPanel>
    </Grid>
</Window>
