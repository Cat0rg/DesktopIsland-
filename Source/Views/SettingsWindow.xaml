<Window x:Class="DesktopIsland.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки — Desktop Island"
        Width="590"
        Height="660"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#F1F5F9"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Toggle Switch Style for CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Border x:Name="Track" Grid.Column="1" Width="38" Height="20" CornerRadius="10" Background="#252736" BorderBrush="#33364A" BorderThickness="1" VerticalAlignment="Center">
                                <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="#94A3B8" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#0EA5E9"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CBD5E1"/>
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0E0E15"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#2D3042"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E202B"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Dark ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#3B4259" CornerRadius="3" Margin="1,2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Border Background="#FA0B0B11" BorderBrush="#292A38" BorderThickness="1" CornerRadius="20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.55"/>
            </Border.Effect>

            <Grid Margin="18,14,18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Custom Drag Title Bar -->
                <Grid Grid.Row="0" Background="Transparent" Margin="0,0,0,12" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#38BDF8" Margin="0,0,9,0"/>
                        <TextBlock Text="Настройки Desktop Island" FontSize="15.5" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                    </StackPanel>
                    <Button Content="✕" Width="28" Height="28" Padding="0" HorizontalAlignment="Right" Style="{StaticResource SettingsBtn}" Background="#1B1C26" Foreground="#94A3B8" Click="Cancel_Click" ToolTip="Закрыть настройки"/>
                </Grid>

                <!-- Scrollable Settings Cards -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel>
                        <!-- Section 1: Pinned Apps -->
                        <TextBlock Text="Быстрый запуск" FontSize="12.5" FontWeight="SemiBold" Foreground="#38BDF8" Margin="2,0,0,6"/>
                        <Border Background="#13131C" BorderBrush="#232433" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ListBox x:Name="AppsListBox" Height="132" Background="#0C0C12" Foreground="#F8FAFC" BorderBrush="#232433" DisplayMemberPath="Name" Padding="4">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="8,5"/>
                                            <Setter Property="Margin" Value="0,1"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#1E3A5F"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#1C1D29"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0" Width="118">
                                    <Button Content="+ Добавить" Style="{StaticResource SettingsBtn}" Background="#0EA5E9" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6" Click="AddApp_Click"/>
                                    <Button Content="Удалить" Style="{StaticResource SettingsBtn}" Background="#232433" Margin="0,0,0,6" Click="RemoveApp_Click"/>
                                    <Button Content="▲ Вверх" Style="{StaticResource SettingsBtn}" Margin="0,0,0,6" Click="MoveUp_Click"/>
                                    <Button Content="▼ Вниз" Style="{StaticResource SettingsBtn}" Click="MoveDown_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Section 2: Appearance & Window -->
                        <TextBlock Text="Внешний вид и расположение" FontSize="12.5" FontWeight="SemiBold" Foreground="#38BDF8" Margin="2,0,0,6"/>
                        <Border Background="#13131C" BorderBrush="#232433" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,2,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="175"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Монитор отображения:" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="MonitorCombo" Grid.Column="1" Height="28"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="175"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Цветовая тема:" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ThemeCombo" Grid.Column="1" Height="28">
                                        <ComboBoxItem Content="Небесная (Sky)" Tag="Sky"/>
                                        <ComboBoxItem Content="Изумруд (Emerald)" Tag="Emerald"/>
                                        <ComboBoxItem Content="Неон-фиолет (Violet)" Tag="Violet"/>
                                        <ComboBoxItem Content="Янтарь (Amber)" Tag="Amber"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="175"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Прозрачность капсулы:" VerticalAlignment="Center"/>
                                    <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0.65" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="175"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Отступ сверху (пикс.):" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TopOffsetBox" Grid.Column="1" Width="76" Style="{StaticResource DarkTextBox}"/>
                                    <Button Grid.Column="2" Content="Центр по X" HorizontalAlignment="Right" Style="{StaticResource SettingsBtn}" Padding="10,5" Click="ResetHorizontalOffset_Click" ToolTip="Вернуть островок точно в центр экрана"/>
                                </Grid>

                                <CheckBox x:Name="DockToTopChk" Content="Прижать островок к верхнему краю экрана (Notch-вид)"/>
                                <CheckBox x:Name="AlwaysOnTopChk" Content="Поверх всех окон (Topmost · Ctrl+Alt+D — вернуть/спрятать)"/>
                                <CheckBox x:Name="ExpandOnHoverChk" Content="Раскрывать островок при наведении мыши"/>
                                <CheckBox x:Name="EnableAnimationsChk" Content="Плавная анимация капсулы и молнии"/>
                                <CheckBox x:Name="GameModeAutoChk" Content="Игровой авто-профиль (Notch-вид сверху, игровой FPS/Ping)"/>
                                <CheckBox x:Name="GameClickThroughChk" Content="В игре пропускать клики сквозь островок (Alt для управления)" Margin="18,2,0,4"/>
                                <CheckBox x:Name="GameAutoBoostChk" Content="Авто-буст при входе в игру (трим фоновой ОЗУ + High Perf)" Margin="18,2,0,4"/>
                                <CheckBox x:Name="GameGpuTempChk" Content="Показывать GPU % и температуру в игре и во вкладке Система" Margin="18,2,0,4"/>
                                <CheckBox x:Name="GameMicMuteChk" Content="Быстрая кнопка Mute микрофона рядом с островком в игре" Margin="18,2,0,6"/>
                                <CheckBox x:Name="DimVideoChk" Content="Полупрозрачность (30%) поверх полноэкранного видео"/>
                            </StackPanel>
                        </Border>

                        <!-- Section 3: Monitors & Weather -->
                        <TextBlock Text="Мониторинг и погода" FontSize="12.5" FontWeight="SemiBold" Foreground="#38BDF8" Margin="2,0,0,6"/>
                        <Border Background="#13131C" BorderBrush="#232433" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="EnableSysMonChk" Content="Системный монитор (CPU, RAM, FPS и Ping)"/>
                                <CheckBox x:Name="EnableDiskMonChk" Content="Монитор локальных дисков"/>
                                <CheckBox x:Name="EnableNetMonChk" Content="Монитор скорости сети"/>
                                <CheckBox x:Name="CompactCpuRamChk" Content="Показывать CPU и RAM в компактной панели"/>
                                <CheckBox x:Name="CompactFpsChk" Content="Показывать FPS активного окна рядом с CPU и RAM"/>
                                <CheckBox x:Name="CompactPingChk" Content="Показывать Ping (мс) в компактной панели"/>
                                <CheckBox x:Name="CompactNetChk" Content="Показывать скорость сети в компактной панели"/>
                                <CheckBox x:Name="CompactMediaChk" Content="Показывать мини-эквалайзер звука в панели"/>
                                <CheckBox x:Name="CompactWeatherChk" Content="Показывать погоду в компактной панели"/>

                                <Grid Margin="0,6,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Страна и город:" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="WeatherCountryCombo" Grid.Column="1" Height="28" SelectionChanged="WeatherCountryCombo_SelectionChanged" ToolTip="Сначала выберите страну (или Авто)"/>
                                    <ComboBox x:Name="WeatherCityCombo" Grid.Column="3" Height="28" SelectionChanged="WeatherCityCombo_SelectionChanged" ToolTip="Выберите город из списка"/>
                                </Grid>

                                <Grid Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Или введите вручную:" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11.5"/>
                                    <TextBox x:Name="WeatherCityBox" Grid.Column="1" Style="{StaticResource DarkTextBox}" ToolTip="Можно вписать любой город вручную (например: Kyiv, Warsaw, Berlin) или оставить пустым для автоопределения"/>
                                </Grid>

                                <Border Height="1" Background="#232433" Margin="0,8"/>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Интервал опроса (мс, 1000–10000):" VerticalAlignment="Center"/>
                                    <TextBox x:Name="PollingBox" Grid.Column="1" Width="76" Style="{StaticResource DarkTextBox}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Section 4: System & Autostart -->
                        <TextBlock Text="Авто-ОЗУ, очистка и автозапуск" FontSize="12.5" FontWeight="SemiBold" Foreground="#38BDF8" Margin="2,0,0,6"/>
                        <Border Background="#13131C" BorderBrush="#232433" BorderThickness="1" CornerRadius="14" Padding="14,10">
                            <StackPanel>
                                <CheckBox x:Name="AutoRamChk" Content="Авто-оптимизация ОЗУ при высокой нагрузке"/>
                                <Grid Margin="0,2,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Порог срабатывания ОЗУ (%, 60–95):" VerticalAlignment="Center"/>
                                    <TextBox x:Name="RamThresholdBox" Grid.Column="1" Width="64" Style="{StaticResource DarkTextBox}"/>
                                </Grid>
                                <CheckBox x:Name="ConfirmCleanupChk" Content="Подтверждать очистку Корзины"/>
                                <CheckBox x:Name="AutostartChk" Content="Запускать Desktop Island вместе с Windows"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom Bar -->
                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Button Content="Завершить Desktop Island" HorizontalAlignment="Left" Style="{StaticResource SettingsBtn}" Background="#7F1D1D" Foreground="#FEE2E2" Click="ExitApp_Click"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Отмена" Style="{StaticResource SettingsBtn}" Margin="0,0,8,0" Click="Cancel_Click"/>
                        <Button Content="Сохранить" Style="{StaticResource SettingsBtn}" Background="#0EA5E9" Foreground="White" FontWeight="SemiBold" Padding="18,7" Click="Save_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
